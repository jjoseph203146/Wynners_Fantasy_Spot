    section(
        "BUILDING PRIMARY GPP VIEW"
    )

    current = current.copy()

    current[
        "primary_gpp_threshold"
    ] = np.nan

    current[
        "primary_ceiling_probability"
    ] = np.nan

    current[
        "primary_gpp_score"
    ] = np.nan

    current[
        "primary_gpp_percentile"
    ] = np.nan

    current[
        "primary_gpp_rank"
    ] = np.nan

    current[
        "primary_gpp_method"
    ] = None

    for position in POSITIONS:

        threshold = (
            PRIMARY_GPP_THRESHOLD[
                position
            ]
        )

        mask = (
            current[
                "position"
            ]
            ==
            position
        )

        current.loc[
            mask,
            "primary_gpp_threshold",
        ] = threshold

        current.loc[
            mask,
            "primary_ceiling_probability",
        ] = current.loc[
            mask,
            f"ceiling_prob_{threshold}",
        ]

        current.loc[
            mask,
            "primary_gpp_score",
        ] = current.loc[
            mask,
            f"gpp_score_{threshold}",
        ]

        current.loc[
            mask,
            "primary_gpp_percentile",
        ] = current.loc[
            mask,
            f"gpp_percentile_{threshold}",
        ]

        current.loc[
            mask,
            "primary_gpp_rank",
        ] = current.loc[
            mask,
            f"gpp_rank_{threshold}",
        ]

        current.loc[
            mask,
            "primary_gpp_method",
        ] = current.loc[
            mask,
            f"gpp_method_{threshold}",
        ]

    return current


# =========================================================
# AUDIT
# =========================================================

def audit_output(
    current,
):

    section(
        "PRODUCTION PROJECTION AUDIT"
    )

    duplicate_rows = (
        current.groupby(
            [
                "game_id",
                "identity_key",
                "team",
            ]
        )
        .size()
        .reset_index(
            name="n"
        )
    )

    duplicate_rows = duplicate_rows[
        duplicate_rows[
            "n"
        ]
        >
        1
    ]

    ready = current[
        current[
            "production_status"
        ]
        ==
        "MODEL_READY"
    ].copy()

    cold = current[
        current[
            "production_status"
        ]
        ==
        "COLD_START"
    ].copy()

    ready_null_ridge = int(
        ready[
            "ridge_projection"
        ]
        .isna()
        .sum()
    )

    ridge_values = pd.to_numeric(
        ready[
            "ridge_projection"
        ],
        errors="coerce",
    ).to_numpy(
        dtype=float
    )

    ready_nonfinite_ridge = int(
        (
            ~np.isfinite(
                ridge_values
            )
        ).sum()
    )

    cold_scored_ridge = int(
        cold[
            "ridge_projection"
        ]
        .notna()
        .sum()
    )

    null_ready_probabilities = 0
    invalid_probabilities = 0

    for position in POSITIONS:

        position_ready = ready[
            ready[
                "position"
            ]
            ==
            position
        ]

        for threshold in (
            CEILING_THRESHOLDS[
                position
            ]
        ):

            column = (
                f"ceiling_prob_{threshold}"
            )

            values = pd.to_numeric(
                position_ready[
                    column
                ],
                errors="coerce",
            )

            null_ready_probabilities += int(
                values.isna().sum()
            )

            valid = values.dropna()

            invalid_probabilities += int(
                (
                    (
                        valid < 0.0
                    )
                    |
                    (
                        valid > 1.0
                    )
                ).sum()
            )

    cold_probability_count = 0

    for position in POSITIONS:

        position_cold = cold[
            cold[
                "position"
            ]
            ==
            position
        ]

        for threshold in (
            CEILING_THRESHOLDS[
                position
            ]
        ):

            cold_probability_count += int(
                position_cold[
                    f"ceiling_prob_{threshold}"
                ]
                .notna()
                .sum()
            )

    ready_null_primary_gpp = int(
        ready[
            "primary_gpp_score"
        ]
        .isna()
        .sum()
    )

    cold_primary_gpp_count = int(
        cold[
            "primary_gpp_score"
        ]
        .notna()
        .sum()
    )

    invalid_status = int(
        (
            ~current[
                "production_status"
            ].isin(
                [
                    "MODEL_READY",
                    "COLD_START",
                ]
            )
        ).sum()
    )

    print(
        f"Total rows: "
        f"{len(current)}"
    )

    print(
        f"Model-ready rows: "
        f"{len(ready)}"
    )

    print(
        f"Cold-start rows: "
        f"{len(cold)}"
    )

    print(
        f"Duplicate player-game rows: "
        f"{len(duplicate_rows)}"
    )

    print(
        f"MODEL_READY NULL ridge: "
        f"{ready_null_ridge}"
    )

    print(
        f"MODEL_READY non-finite ridge: "
        f"{ready_nonfinite_ridge}"
    )

    print(
        f"COLD_START ridge outputs: "
        f"{cold_scored_ridge}"
    )

    print(
        "MODEL_READY NULL applicable "
        "ceiling probabilities: "
        f"{null_ready_probabilities}"
    )

    print(
        f"Invalid ceiling probabilities: "
        f"{invalid_probabilities}"
    )

    print(
        f"COLD_START ceiling outputs: "
        f"{cold_probability_count}"
    )

    print(
        f"MODEL_READY NULL primary GPP: "
        f"{ready_null_primary_gpp}"
    )

    print(
        f"COLD_START primary GPP outputs: "
        f"{cold_primary_gpp_count}"
    )

    print(
        f"Invalid production statuses: "
        f"{invalid_status}"
    )

    audit_rows = [
        {
            "audit":
                "total_rows",
            "value":
                len(current),
        },
        {
            "audit":
                "model_ready_rows",
            "value":
                len(ready),
        },
        {
            "audit":
                "cold_start_rows",
            "value":
                len(cold),
        },
        {
            "audit":
                "duplicate_player_game_rows",
            "value":
                len(duplicate_rows),
        },
        {
            "audit":
                "ready_null_ridge",
            "value":
                ready_null_ridge,
        },
        {
            "audit":
                "ready_nonfinite_ridge",
            "value":
                ready_nonfinite_ridge,
        },
        {
            "audit":
                "cold_start_ridge_outputs",
            "value":
                cold_scored_ridge,
        },
        {
            "audit":
                "ready_null_ceiling_probabilities",
            "value":
                null_ready_probabilities,
        },
        {
            "audit":
                "invalid_ceiling_probabilities",
            "value":
                invalid_probabilities,
        },
        {
            "audit":
                "cold_start_ceiling_outputs",
            "value":
                cold_probability_count,
        },
        {
            "audit":
                "ready_null_primary_gpp",
            "value":
                ready_null_primary_gpp,
        },
        {
            "audit":
                "cold_start_primary_gpp_outputs",
            "value":
                cold_primary_gpp_count,
        },
        {
            "audit":
                "invalid_production_status",
            "value":
                invalid_status,
        },
    ]

    audit = pd.DataFrame(
        audit_rows
    )

    problems = (
        len(
            duplicate_rows
        )
        +
        ready_null_ridge
        +
        ready_nonfinite_ridge
        +
        cold_scored_ridge
        +
        null_ready_probabilities
        +
        invalid_probabilities
        +
        cold_probability_count
        +
        ready_null_primary_gpp
        +
        cold_primary_gpp_count
        +
        invalid_status
    )

    if problems:

        raise RuntimeError(
            "Production projection audit failed."
        )

    print()

    print(
        "PASS: production projections "
        "passed structural audits."
    )

    return audit


