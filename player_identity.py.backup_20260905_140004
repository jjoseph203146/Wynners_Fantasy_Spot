# =========================================================
# SOURCE CONFLICT AUDIT
# =========================================================

def find_external_id_conflicts(
    roster_df,
    id_column,
):

    usable = roster_df[
        roster_df["gsis_id"].notna()
        &
        roster_df[id_column].notna()
    ].copy()

    if usable.empty:
        return pd.DataFrame()

    mapping = (
        usable[
            [
                "gsis_id",
                id_column,
                "full_name",
                "team",
                "season",
                "week",
            ]
        ]
        .drop_duplicates()
    )

    counts = (
        mapping.groupby(
            id_column
        )["gsis_id"]
        .nunique()
    )

    conflicting_ids = set(
        counts[
            counts > 1
        ].index.tolist()
    )

    if not conflicting_ids:
        return pd.DataFrame()

    conflicts = mapping[
        mapping[id_column].isin(
            conflicting_ids
        )
    ].copy()

    conflicts.insert(
        0,
        "conflict_type",
        id_column,
    )

    conflicts = conflicts.rename(
        columns={
            id_column: "conflicting_id",
        }
    )

    return conflicts


def build_conflict_audit(
    roster_df,
):

    section(
        "EXTERNAL ID CONFLICT AUDIT"
    )

    audits = []

    for column in [
        "pfr_id",
        "espn_id",
        "pff_id",
        "sleeper_id",
    ]:

        conflict_df = (
            find_external_id_conflicts(
                roster_df,
                column,
            )
        )

        if conflict_df.empty:

            print(
                f"{column}: 0 conflicting IDs"
            )

            continue

        audits.append(
            conflict_df
        )

        count = (
            conflict_df[
                "conflicting_id"
            ]
            .nunique()
        )

        print(
            f"{column}: "
            f"{count} conflicting IDs"
        )

    if audits:

        combined = pd.concat(
            audits,
            ignore_index=True,
        )

    else:

        combined = pd.DataFrame(
            columns=[
                "conflict_type",
                "gsis_id",
                "conflicting_id",
                "full_name",
                "team",
                "season",
                "week",
            ]
        )

    combined.to_csv(
        CONFLICT_CSV,
        index=False,
    )

    if not combined.empty:

        print()
        print(
            f"Conflict audit: "
            f"{CONFLICT_CSV}"
        )

    return combined


# =========================================================
# UNIQUE EXTERNAL-ID MAP
# =========================================================

def build_unique_external_map(
    roster_df,
    id_column,
):

    usable = roster_df[
        roster_df["gsis_id"].notna()
        &
        roster_df[id_column].notna()
    ][
        [
            "gsis_id",
            id_column,
        ]
    ].drop_duplicates()

    if usable.empty:
        return {}

    counts = (
        usable.groupby(
            id_column
        )["gsis_id"]
        .nunique()
    )

    valid_ids = set(
        counts[
            counts == 1
        ].index.tolist()
    )

    usable = usable[
        usable[id_column].isin(
            valid_ids
        )
    ]

    result = {}

    for _, row in usable.iterrows():

        gsis_id = safe_text(
            row["gsis_id"]
        )

        external_id = safe_text(
            row[id_column]
        )

        if (
            gsis_id is not None
            and external_id is not None
        ):

            result[
                external_id
            ] = gsis_id

    return result


# =========================================================
# PLAYER VALUE HELPERS
# =========================================================

def most_recent_non_null(
    player_rows,
    column,
):

    values = (
        player_rows[
            column
        ]
        .dropna()
    )

    if values.empty:
        return None

    return safe_text(
        values.iloc[-1]
    )


def unique_external_for_gsis(
    player_rows,
    id_column,
    global_map,
    gsis_id,
):

    candidates = []

    for value in player_rows[
        id_column
    ].tolist():

        value = safe_text(value)

        if value is None:
            continue

        if global_map.get(
            value
        ) == gsis_id:

            candidates.append(
                value
            )

    if not candidates:
        return None

    return candidates[-1]


# =========================================================
# BUILD GSIS ROSTER IDENTITIES
# =========================================================

def build_gsis_identities(
    roster_df,
):

    section(
        "BUILDING GSIS IDENTITIES"
    )

    pfr_map = build_unique_external_map(
        roster_df,
        "pfr_id",
    )

    espn_map = build_unique_external_map(
        roster_df,
        "espn_id",
    )

    pff_map = build_unique_external_map(
        roster_df,
        "pff_id",
    )

    sleeper_map = build_unique_external_map(
        roster_df,
        "sleeper_id",
    )

    usable = roster_df[
        roster_df["gsis_id"].notna()
    ].copy()

    timestamp = now_utc()

    rows = []

    for gsis_id, player_rows in usable.groupby(
        "gsis_id",
        sort=False,
    ):

        gsis_id = safe_text(
            gsis_id
        )

        if gsis_id is None:
            continue

        player_rows = (
            player_rows.sort_values(
                [
                    "season",
                    "week",
                ]
            )
        )

        rows.append(
            (
                f"GSIS:{gsis_id}",

                gsis_id,

                unique_external_for_gsis(
                    player_rows,
                    "pfr_id",
                    pfr_map,
                    gsis_id,
                ),

                unique_external_for_gsis(
                    player_rows,
                    "espn_id",
                    espn_map,
                    gsis_id,
                ),

                unique_external_for_gsis(
                    player_rows,
                    "pff_id",
                    pff_map,
                    gsis_id,
                ),

                unique_external_for_gsis(
                    player_rows,
                    "sleeper_id",
                    sleeper_map,
                    gsis_id,
                ),

                most_recent_non_null(
                    player_rows,
                    "full_name",
                ),

                most_recent_non_null(
                    player_rows,
                    "football_name",
                ),

                most_recent_non_null(
                    player_rows,
                    "position",
                ),

                most_recent_non_null(
                    player_rows,
                    "team",
                ),

                1,
                0,
                0,

                timestamp,
                timestamp,
            )
        )

    with get_connection() as conn:

        conn.executemany(
            """
            INSERT INTO player_identity (

                identity_key,

                gsis_id,
                pfr_id,
                espn_id,
                pff_id,
                sleeper_id,

                full_name,
                football_name,

                position,
                latest_team,

                source_roster,
                source_depth_chart,
                source_snap_counts,

                first_seen,
                updated_at
            )

            VALUES (
                ?, ?, ?, ?, ?, ?,
                ?, ?, ?, ?,
                ?, ?, ?,
                ?, ?
            )
            """,
            rows,
        )

    print(
        f"GSIS identities inserted: "
        f"{len(rows)}"
    )


# =========================================================
# REDUCE DEPTH HISTORY
# =========================================================

def reduce_depth_history(
    depth_df,
):

    section(
        "REDUCING DEPTH-CHART HISTORY"
    )

    print(
        f"Raw depth rows: "
        f"{len(depth_df)}"
    )

    # -----------------------------------------------------
    # GSIS PLAYERS
    # -----------------------------------------------------

    gsis_df = depth_df[
        depth_df["gsis_id"].notna()
    ].copy()

    gsis_df = (
        gsis_df
        .sort_values(
            "snapshot_dt"
        )
        .drop_duplicates(
            subset=[
                "gsis_id",
            ],
            keep="last",
        )
    )

    # -----------------------------------------------------
    # ESPN-ONLY PLAYERS
    #
    # Important: only use rows with no GSIS ID.
    # -----------------------------------------------------

    espn_only_df = depth_df[
        depth_df["gsis_id"].isna()
        &
        depth_df["espn_id"].notna()
    ].copy()

    espn_only_df = (
        espn_only_df
        .sort_values(
            "snapshot_dt"
        )
        .drop_duplicates(
            subset=[
                "espn_id",
            ],
            keep="last",
        )
    )

    print(
        f"Unique GSIS depth players: "
        f"{len(gsis_df)}"
    )

    print(
        f"Unique ESPN-only players: "
        f"{len(espn_only_df)}"
    )

    return (
        gsis_df,
        espn_only_df,
    )


# =========================================================
# ESPN SAFETY CHECK
# =========================================================

def espn_available_for_identity(
    conn,
    espn_id,
    identity_key,
):

    espn_id = safe_text(
        espn_id
    )

    if espn_id is None:
        return None

    conflict = conn.execute(
        """
        SELECT identity_key

        FROM player_identity

        WHERE
            espn_id = ?
            AND identity_key <> ?
        """,
        (
            espn_id,
            identity_key,
        ),
    ).fetchone()

    if conflict is not None:

        return None

    return espn_id


# =========================================================
# ENRICH GSIS DEPTH PLAYERS
# =========================================================

def enrich_gsis_depth(
    gsis_df,
):

    section(
        "DEPTH CHARTS — GSIS ENRICHMENT"
    )

    timestamp = now_utc()

    existing_updated = 0
    new_inserted = 0
    espn_conflicts = 0

    with get_connection() as conn:

        for _, row in gsis_df.iterrows():

            gsis_id = safe_text(
                row["gsis_id"]
            )

            if gsis_id is None:
                continue

            player_name = safe_text(
                row["player_name"]
            )

            position = safe_text(
                row["pos_abb"]
            )

            team = safe_text(
                row["team"]
            )

            espn_id = safe_text(
                row["espn_id"]
            )

            identity_key = (
                f"GSIS:{gsis_id}"
            )

            existing = conn.execute(
                """
                SELECT
                    identity_key,
                    espn_id

                FROM player_identity

                WHERE gsis_id = ?
                """,
                (
                    gsis_id,
                ),
            ).fetchone()

            # -------------------------------------------------
            # EXISTING GSIS PLAYER
            # -------------------------------------------------

            if existing:

                identity_key = (
                    existing[0]
                )

                current_espn = (
                    safe_text(
                        existing[1]
                    )
                )

                usable_espn = None

                if current_espn is None:

                    usable_espn = (
                        espn_available_for_identity(
                            conn,
                            espn_id,
                            identity_key,
                        )
                    )

                    if (
                        espn_id is not None
                        and usable_espn is None
                    ):
                        espn_conflicts += 1

                conn.execute(
                    """
                    UPDATE player_identity

                    SET
                        espn_id =
                            COALESCE(
                                espn_id,
                                ?
                            ),

                        full_name =
                            COALESCE(
                                ?,
                                full_name
                            ),

                        position =
                            COALESCE(
                                ?,
                                position
                            ),

                        latest_team =
                            COALESCE(
                                ?,
                                latest_team
                            ),

                        source_depth_chart = 1,

                        updated_at = ?

                    WHERE identity_key = ?
                    """,
                    (
                        usable_espn,
                        player_name,
                        position,
                        team,
                        timestamp,
                        identity_key,
                    ),
                )

                existing_updated += 1

                continue

            # -------------------------------------------------
            # NEW GSIS PLAYER
            # -------------------------------------------------

            usable_espn = (
                espn_available_for_identity(
                    conn,
                    espn_id,
                    identity_key,
                )
            )

            if (
                espn_id is not None
                and usable_espn is None
            ):
                espn_conflicts += 1

            conn.execute(
                """
                INSERT INTO player_identity (

                    identity_key,

                    gsis_id,
                    espn_id,

                    full_name,
                    position,
                    latest_team,

                    source_depth_chart,

                    first_seen,
                    updated_at
                )

                VALUES (
                    ?,
                    ?,
                    ?,
                    ?,
                    ?,
                    ?,
                    1,
                    ?,
                    ?
                )
                """,
                (
                    identity_key,

                    gsis_id,
                    usable_espn,

                    player_name,
                    position,
                    team,

                    timestamp,
                    timestamp,
                ),
            )

            new_inserted += 1

    print(
        f"Existing GSIS players updated: "
        f"{existing_updated}"
    )

    print(
        f"New GSIS players inserted: "
        f"{new_inserted}"
    )

    print(
        f"Depth ESPN conflicts quarantined: "
        f"{espn_conflicts}"
    )


