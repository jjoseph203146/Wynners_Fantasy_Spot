# =========================================================
# UNIQUENESS AUDIT
# =========================================================

def audit_identity_uniqueness():

    section(
        "IDENTITY UNIQUENESS AUDIT"
    )

    problems = 0

    with get_connection() as conn:

        for column in [
            "gsis_id",
            "pfr_id",
            "espn_id",
        ]:

            duplicates = conn.execute(
                f"""
                SELECT COUNT(*)

                FROM (

                    SELECT
                        {column}

                    FROM player_identity

                    WHERE
                        {column} IS NOT NULL

                    GROUP BY
                        {column}

                    HAVING COUNT(*) > 1
                )
                """
            ).fetchone()[0]

            print(
                f"Duplicate {column}: "
                f"{duplicates}"
            )

            problems += duplicates

    if problems:

        raise RuntimeError(
            "Player identity uniqueness "
            "audit failed."
        )

    print()
    print(
        "PASS: deterministic external-ID "
        "uniqueness preserved."
    )


