def rebuild_identity_table():

    section(
        "REBUILDING PLAYER IDENTITY TABLE"
    )

    with get_connection() as conn:

        conn.execute(
            """
            DROP TABLE IF EXISTS player_identity
            """
        )

        conn.execute(
            """
            CREATE TABLE player_identity (

                identity_key TEXT PRIMARY KEY,

                gsis_id TEXT,
                pfr_id TEXT,
                espn_id TEXT,
                pff_id TEXT,
                sleeper_id TEXT,

                full_name TEXT,
                football_name TEXT,

                position TEXT,
                latest_team TEXT,

                source_roster INTEGER DEFAULT 0,
                source_depth_chart INTEGER DEFAULT 0,
                source_snap_counts INTEGER DEFAULT 0,

                first_seen TEXT,
                updated_at TEXT
            )
            """
        )

        conn.execute(
            """
            CREATE UNIQUE INDEX
            idx_identity_gsis

            ON player_identity(gsis_id)

            WHERE gsis_id IS NOT NULL
            """
        )

        conn.execute(
            """
            CREATE UNIQUE INDEX
            idx_identity_pfr

            ON player_identity(pfr_id)

            WHERE pfr_id IS NOT NULL
            """
        )

        conn.execute(
            """
            CREATE UNIQUE INDEX
            idx_identity_espn

            ON player_identity(espn_id)

            WHERE espn_id IS NOT NULL
            """
        )

        conn.execute(
            """
            CREATE INDEX
            idx_identity_name

            ON player_identity(full_name)
            """
        )

        conn.execute(
            """
            CREATE INDEX
            idx_identity_team

            ON player_identity(latest_team)
            """
        )

    print(
        "Fresh player_identity table created."
    )


