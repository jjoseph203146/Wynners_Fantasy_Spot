# =========================================================

def audit_depth():

    section(
        "DEPTH CHART IDENTITY AUDIT"
    )

    with get_connection() as conn:

        total = conn.execute(
            """
            SELECT COUNT(*)
            FROM depth_charts
            """
        ).fetchone()[0]

        matched = conn.execute(
            """
            SELECT COUNT(*)

            FROM depth_charts d

            WHERE EXISTS (

                SELECT 1

                FROM player_identity i

                WHERE
                    (
                        d.gsis_id IS NOT NULL
                        AND
                        d.gsis_id = i.gsis_id
                    )

                    OR

                    (
                        d.gsis_id IS NULL
                        AND
                        d.espn_id IS NOT NULL
                        AND
                        d.espn_id = i.espn_id
                    )
            )
            """
        ).fetchone()[0]

        unmatched_df = pd.read_sql_query(
            """
            SELECT
                d.snapshot_dt,
                d.team,
                d.player_name,
                d.gsis_id,
                d.espn_id,
                d.pos_abb,
                d.pos_rank

            FROM depth_charts d

            WHERE NOT EXISTS (

                SELECT 1

                FROM player_identity i

                WHERE
                    (
                        d.gsis_id IS NOT NULL
                        AND
                        d.gsis_id = i.gsis_id
                    )

                    OR

                    (
                        d.gsis_id IS NULL
                        AND
                        d.espn_id IS NOT NULL
                        AND
                        d.espn_id = i.espn_id
                    )
            )
            """,
            conn,
        )

    unmatched_df.to_csv(
        UNMATCHED_DEPTH_CSV,
        index=False,
    )

    print(
        f"Depth-chart rows: {total}"
    )

    print(
        f"Resolved rows: {matched}"
    )

    print(
        f"Unmatched: {len(unmatched_df)}"
    )

    if unmatched_df.empty:

        print(
            "PASS: all usable depth-chart "
            "identities resolve."
        )

    else:

        print(
            "Depth audit:"
        )

        print(
            UNMATCHED_DEPTH_CSV
        )


