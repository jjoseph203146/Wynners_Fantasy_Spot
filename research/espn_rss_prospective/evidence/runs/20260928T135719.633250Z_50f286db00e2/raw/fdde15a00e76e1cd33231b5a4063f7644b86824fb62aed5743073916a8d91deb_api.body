:"https://www.espn.com/nfl/"}}}}},{"id":1462,"type":"team","uid":"s:20~l:28~t:28","guid":"fbeaf73e-6d6c-cca4-0809-713d9d741f90","description":"Washington Commanders","sportId":28,"teamId":28,"team":{"id":28,"description":"Washington Commanders","abbreviation":"WSH","shortDisplayName":"Commanders","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/wsh/washington-commanders"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/wsh/washington-commanders"}}}}},{"id":711828,"type":"editorialindicator","guid":"b14f9e1f-2d2c-3b10-b39d-d781f4c4aba7","description":"4 Star Rating"},{"id":664674,"type":"editorialindicator","guid":"467e5496-7942-3006-b2f4-a6ef95021dce","description":"Team Boost"},{"type":"event","uid":"s:20~l:28~e:401872955","guid":"80e20686-e90a-3464-b594-a94eaf23f0dd","description":"Seattle Seahawks @ Washington Commanders","eventId":401872955,"event":{"id":401872955,"sport":"football","league":"nfl","description":"Seattle Seahawks @ Washington Commanders","links":{"mobile":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872955"}},"web":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872955"}}}}}],"ad":{"bundle":"nfl_one_plays","sport":"nfl"},"contributingPartner":"wsc","contributingSystem":"wsc","tracking":{"coverageType":"OnePlay","leagueName":"NFL","program":"espnnfl","sportName":"football","trackingId":"dm_20260927_NFL_kain_medrano_comes_up_with_clutch_picksix_for_commanders","trackingName":"NFL_One-Play (Kain Medrano comes up with clutch pick-six for Commanders) 2026/09/27 ESHEET"}}],"related":[{"id":50034932,"dataSourceIdentifier":"b322fabd720bf","publishedkey":"50034932","type":"Story","headline":"Week 3 NFL highlights: Best plays, moments, touchdowns, more","title":"Week 3 NFL highlights: Best plays, moments, touchdowns, more","linkText":"Week 3 NFL highlights: Broncos rally late in win; Ravens walk it off in Rio","source":"ESPN","images":[{"dataSourceIdentifier":"6c6fad4dd4db8","id":50049651,"ty