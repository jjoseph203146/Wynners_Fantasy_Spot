{"resultsCount":1,"resultsLimit":10,"resultsOffset":0,"headlines":[{"id":49794361,"nowId":"1-49794361","contentKey":"49794361-1-6-1","dataSourceIdentifier":"51b53fdbdad19","publishedkey":"49794361","type":"Story","feedDisplayType":"Default","headline":"2027 NFL draft order projections for Round 1, top pick, more","description":"ESPN's Football Power Index projects the 2027 NFL draft order for Round 1, complete with each team's chances to pick in the top five, in the top 10 and at No. 1.","title":"2027 NFL draft order projections for Round 1, top pick, more","linkText":"Projecting the 2027 NFL draft order: Which teams could have an early pick?","categorized":"2026-09-28T10:00:45Z","originallyPosted":"2026-09-28T10:00:00Z","lastModified":"2026-09-28T10:00:39Z","published":"2026-09-28T10:00:39Z","root":"nfl/draft2027","section":"NFL","images":[{"dataSourceIdentifier":"ba9f417e45138","id":48938178,"type":"header","name":"LEAD: Dolphins Rebuild [608x342]","credit":"AP Photo/Rebecca Blackwell","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0601/r1666608_608x342_16-9.jpg"},{"type":"Media","name":"Is Arch Manning on track to be the No. 1 pick in the NFL draft?","caption":"Is Arch Manning on track to be the No. 1 pick in the NFL draft?","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0722/ss_20260722_090151266_3599915551/ss_20260722_090151266_3599915551.jpg"}],"video":[],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":30937,"type":"league","guid":"4509a056-5f02-4fb8-b6bb-de7cc5a923ec","description":"NFL Draft","sportId":0,"leagueId":3400,"league":{"id":3400,"description":"NFL Draft"}},{"id":1583,"type":"team","uid":"s:20~l:28~