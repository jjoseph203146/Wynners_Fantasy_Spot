{"resultsCount":1,"resultsLimit":10,"resultsOffset":0,"headlines":[{"id":50051416,"nowId":"1-50051416","contentKey":"50051416-1-6-1","dataSourceIdentifier":"9d5c16df28609","publishedkey":"50051416","type":"Story","feedDisplayType":"Default","headline":"How are Cowboys reacting to third straight 1-2 start?","description":"Dallas finished 7-9-1 in 2025 and 7-10 in 2024 after winning one of its first three games. Will 2026 be any different?","title":"How are Cowboys reacting to third straight 1-2 start?","linkText":"'This one hurts': How are Cowboys reacting to third straight 1-2 start?","categorized":"2026-09-28T13:48:29Z","originallyPosted":"2026-09-28T13:48:00Z","lastModified":"2026-09-28T13:48:27Z","published":"2026-09-28T13:48:27Z","root":"nfl","section":"NFL","source":"ESPN","images":[{"dataSourceIdentifier":"661b6389a1928","id":50051673,"type":"header","name":"Cowboys [608x342]","credit":"Kirby Lee-Imagn Images","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0928/r1722927_608x342_16-9.jpg"},{"type":"Media","name":"Cowboys fall to 1-2 after 'gutting loss' to Ravens","caption":"Todd Archer discusses the Cowboys after their 34-31 loss to the Ravens in Rio.","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/dm_260927_SC4U_16x9_Cowboys_IA_9-27/dm_260927_SC4U_16x9_Cowboys_IA_9-27.jpg"}],"video":[{"id":50049584,"dataSourceIdentifier":"551be1e89d020","cerebroId":"6ab9da1df340d6751fab64e1","pccId":"da02ee6e-cd8c-41f3-ac9d-1159fbcfab3d","source":"espn","headline":"Cowboys fall to 1-2 after 'gutting loss' to Ravens","shortHeadline":"Cowboys fall to 1-2 after 'gutting loss' to Ravens","caption":"Todd Archer discusses the Cowboys after their 34-31 loss to the Ravens in Rio.","title":"Cowboys fall to 1-2 after 'gutting loss' to Ravens","description":"Todd Archer discusses the Cowboys after their 34-31 loss to the Ravens in Rio.","shortDescription":"Todd Archer discusses the Cowboys after their 34-31 loss to the R