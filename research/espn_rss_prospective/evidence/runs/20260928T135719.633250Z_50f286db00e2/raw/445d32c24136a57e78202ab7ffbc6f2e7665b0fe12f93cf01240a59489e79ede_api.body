_IA_9-27/dm_260927_SC4U_16x9_Cowboys_IA_9-27/playlist.m3u8","9x16":{"href":"https://cmp-espn.media.dssott.com/opp/cmaf/espn/9x16/2026/0927/dm_260927_SC4U_16x9_Cowboys_IA_9-27/dm_260927_SC4U_16x9_Cowboys_IA_9-27/playlist.m3u8"},"cmb":{"href":"https://cmp-espn.media.dssott.com/opp/cmaf/espn/cmb/2026/0927/dm_260927_SC4U_16x9_Cowboys_IA_9-27/dm_260927_SC4U_16x9_Cowboys_IA_9-27/playlist.m3u8"}},"cmb":{"href":"https://cmp-espn.media.dssott.com/opp/hls/espn/cmb/2026/0927/dm_260927_SC4U_16x9_Cowboys_IA_9-27/dm_260927_SC4U_16x9_Cowboys_IA_9-27/playlist.m3u8"},"shield":{"href":"https://watch.auth.api.espn.com/video/auth/media/da02ee6e-cd8c-41f3-ac9d-1159fbcfab3d/asset"}},"flash":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/2026/0927/dm_260927_SC4U_16x9_Cowboys_IA_9-27/dm_260927_SC4U_16x9_Cowboys_IA_9-27.mp4"},"full":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/2026/0927/dm_260927_SC4U_16x9_Cowboys_IA_9-27/dm_260927_SC4U_16x9_Cowboys_IA_9-27.mp4"},"mezzanine":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/2026/0927/dm_260927_SC4U_16x9_Cowboys_IA_9-27/dm_260927_SC4U_16x9_Cowboys_IA_9-27.mp4"}},"sportscenter":{"href":"sportscenter://x-callback-url/showVideo?videoID=50049584&videoDSI=551be1e89d020"},"web":{"href":"https://www.espn.com/video/clip/_/id/50049584/cowboys-fall-1-2-gutting-loss-ravens","self":{"href":"https://www.espn.com/video/clip/_/id/50049584/cowboys-fall-1-2-gutting-loss-ravens","dsi":{"href":"https://www.espn.com/video/clip?id=551be1e89d020"}}}},"categories":[{"id":1298,"type":"team","uid":"s:20~l:28~t:6","guid":"b0fc8fb7-9dbe-e574-9008-6f0ee7c6b234","description":"Dallas Cowboys","sportId":28,"teamId":6,"team":{"id":6,"description":"Dallas Cowboys","abbreviation":"DAL","shortDisplayName":"Cowboys","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/dal/dallas-cowboys"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/dal/dallas-cowboys"}}}}},{"id":711824,"type":"editorialindicator","guid":"d348c764-47d9-3e31-bd75-d39dfde52c26","description":"SC4U  - Eligible"},{"id":718171,"type":"editorialindicator","guid":"2a4cc294-9e85-38be-b7ed-12d8b3f3c646","description":"SC4U - InstantAnalysis"},{"id":664674,"type":"editorialindicator","guid":"467e5496-7942-3006-b2f4-a6ef95021dce","description":"Team Boost"}],"ad":{"bundle":"sportscenter","sport":"nfl"},"tracking":{"coverageType":"InstantAnalysis","leagueName":"No League","sportName":"nfl","trackingId":"dm_260927_SC4U_16x9_Cowboys_IA_9-27","trackingName":"SC4U_NFL InstantAnalysis (Cowboys fall to 1-2 after ‘gutting loss’ to Ravens) 2026/9/27"}}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":1298,"type":"team","uid":"s:20~l:28~t:6","guid":"b0fc8fb7-9dbe-e574-9008-6f0ee7c6b234","description":"Dallas Cowboys","sportId":28,"teamId":6,"team":{"id":6,"description":"Dallas Cowboys","abbreviation":"DAL","shortDisplayName":"Cowboys","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/dal/dallas-cowboys"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/dal/dallas-cowboys"}}}}},{"id":153118,"type":"athlete","uid":"s:20~l:28~a:2577417","guid":"5f09781b-6b0b-7325-049b-a91e60d794e6","description":"Dak Prescott","sportId":28,"athleteId":2577417,"athlete":{"id":2577417,"description":"Dak Prescott","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/2577417/dak-prescott"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/2577417/dak-prescott"}}}}},{"id":696310,"type":"contributor","guid":"a1f6ce35-0e83-3559-a7fd-ff8cb4fc8f25","description":"Todd Archer","slug":"todd-archer","contributor":{"id":1915,"description":"Todd Archer"}}],"keywords":["NFL","Dallas Cowboys","Dak Prescott","Todd Archer"],"story":"<p><video1></p>\n<p>RIO DE JANEIRO -- Whenever and however the <a href=\"https://www.espn.com/nfl/schedule\">2026 NFL season</a> ends for the <a data-clubhouse-guid=\"b0fc8fb7-9dbe-e574-9008-6f0ee7c6b234\" href=\"https://www.espn.com/nfl/team/_/name/dal/dallas-cowboys\">Dallas Cowboys</a>, they will look back at Sunday's <a href=\"https://www.espn.com/nfl/game/_/gameId/401872960/ravens-cowboys\">34-31 loss</a> to the <a data-clubhouse-guid=\"38248455-3da4-84e4-8090-98b5cc38ffdc\" href=\"https://www.espn.com/nfl/team/_/name/bal/baltimore-ravens\">Baltimore Ravens</a> in the NFL's first game in Rio de Janeiro as a defining moment.</p>\n<p>The Cowboys are 1-2 for the third straight season. In 2024, they finished 7-10. In 2025, they finished 7-9-1.</p>\n<p>As elated as they would have been with a comeback victory against the Ravens, they walked out of Maracanã Stadium to their buses knowing they had a 10-hour flight back to Dallas with nothing but time to relive the pain of a last-second defeat.</p>\n<p>\"We just got to lean on our brotherhood. We got to lean on the family that we've created. The trust,\" quarterback <a data-player-guid=\"5f09781b-6b0b-7325-049b-a91e60d794e6\" href=\"https://www.espn.com/nfl/player/_/id/2577417/dak-prescott\">Dak Prescott</a> said. \"This is one game. It's early in the season, thankfully. We're 1-2. We would love to be 2-1 going back, going home. We're not. It's a long season. ... After a loss you don't have no choice but to lock arms and run back into the fire and trust what you've done in your process.</p>\n<p>\"And so hopefully it's one of the best things that happened for us. Hopefully, look back at this in a month or a couple months and say it was good.\"</p>\n<p>But they have no way of knowing that now.</p>\n<p>\"I'm sure when I land,\" Prescott said, \"I'll be just as pissed.\"</p>\n<p><inline2></p>\n<p>The Cowboys were two yards away from pulling off a potential comeback victory that could have led to a season momentum boost. Then they were seven seconds away from forcing overtime.</p>\n<p>The emotional swings can be deflating.</p>\n<p>\"Oh, I don't ever question these guys, man. Watch the way they play,\" Cowboys coach Brian Schottenheimer said. \"I mean, this team doesn't have quit in them. They're hurting right now. I'm hurting. I felt like we made enough plays to go win the game, but we didn't. So give Baltimore credit for that. But at the end of the day, I hurt for the guys in the locker room. They put a lot into this. It's a long trip, but no one cares.\"</p>\n<p>The Cowboys can point to a number of plays that could have changed the outcome, beyond the last minute of regulation.</p>\n<p>On their first drive, they failed to score a touchdown from the Baltimore 1, settling for a field goal. In the third quarter, there was a controversial lost fumble from tight end <a data-player-guid=\"88132b4d-ad57-d110-91a4-626c11215a70\" href=\"https://www.espn.com/nfl/player/_/id/4242355/jake-ferguson\">Jake Ferguson</a> and a blocked 59-yard field goal attempt from <a data-player-guid=\"a7f6ec8a-9901-db9f-3944-4a4b6f9b11cf\" href=\"https://www.espn.com/nfl/player/_/id/3953687/brandon-aubrey\">Brandon Aubrey</a>.</p>\n<p>The defense stopped running back <a data-player-guid=\"81c182a5-8981-2272-a00f-f8daf9533e07\" href=\"https://www.espn.com/nfl/player/_/id/3043078/derrick-henry\">Derrick Henry</a> on fourth down in the first and fourth quarters, but they were unable to sack <a data-player-guid=\"7d76fbb1-1c5e-d9f4-954f-cad43f720ae2\" href=\"https://www.espn.com/nfl/player/_/id/3916387/lamar-jackson\">Lamar Jackson</a> or force a turnover.</p>\n<p>And after kicking off seven seconds left in regulation and the score tied at 31, the defense couldn't make a one-play stop, as Jackson connected with <a data-player-guid=\"04e6bfd5-ecba-2d02-bcac-087f32564877\" href=\"https://www.espn.com/nfl/player/_/id/4429615/zay-flowers\">Zay Flowers</a> for 27 yards with 1 second left to give <a data-player-guid=\"16f0a87e-34cf-34ca-ad36-1c2245aa36e9\" href=\"https://www.espn.com/nfl/player/_/id/4697745/tyler-loop\">Tyler Loop</a> the opportunity to win the game with a 56-yard field goal as time expired.</p>\n<p><inline1></p>\n<p>\"Every loss is heartbreaking,\" rookie defensive back <a data-player-guid=\"12c8597c-e9ff-36ba-a51a-61c91d87abf7\" href=\"https://www.espn.com/nfl/player/_/id/4870706/caleb-downs\">Caleb Downs</a> said. \"It's not a good way to lose and we have things to fix.\"</p>\n<p>So, too, does the offense.</p>\n<p>When the Cowboys had the chance to take the lead late, they got to the 2-yard line with 23 seconds left after receiver <a data-player-guid=\"2994891b-8927-33cb-6999-e809560d0545\" href=\"https://www.espn.com/nfl/player/_/id/4241389/ceedee-lamb\">CeeDee Lamb</a> drew a pass interference call, but a second-down false start penalty on tight end <a data-player-guid=\"c69292b3-4db5-8b9a-7fd1-803086f29200\" href=\"https://www.espn.com/nfl/player/_/id/4372096/luke-schoonmaker\">Luke Schoonmaker</a> pushed the ball back to the Ravens' 7.</p>\n<p>With 14 seconds remaining, the Cowboys called a timeout after a Prescott scramble. Prescott's third-down pass to receiver <a data-player-guid=\"ab0fe70b-0fb4-fc8e-55e1-8f5204851a9d\" href=\"https://www.espn.com/nfl/player/_/id/4426354/george-pickens\">George Pickens</a> was high and wide.</p>\n<p>\"I probably overcoached [Prescott] on that because it had to go,\" Schottenheimer said. \"With no timeouts, it had to go to GP or throw away.\"</p>\n<p>Prescott had regrets.</p>\n<p>\"I probably should have just sat on it a little bit longer, sank on my back foot and just put it on that front pylon,\" he said.</p>\n<p>The Cowboys settled for the tying field goal from Aubrey, thinking they would go to overtime. After having Aubrey go for the touchback, the defense allowed the 27-yard completion with one second left.</p>\n<p>A year ago against the <a data-clubhouse-guid=\"06cd3bcf-7a86-53d4-28e7-aa049dd36261\" href=\"https://www.espn.com/nfl/team/_/name/gb/green-bay-packers\">Green Bay Packers</a>, one second remained on the clock in overtime that allowed the Packers to kick a tying field goal. One second remained this time, and the Cowboys lost.</p>\n<p>Schottenheimer said he was honest with the players in the postgame locker room.</p>\n<p>\"I told them this one hurts, and I was sorry,\" Schottenheimer said. \"I was sorry that we didn't find a way to win. I was proud of them, how hard they played, how many guys had to step up and make plays and move in and whatnot. It was back and forth. It was a hell of a football game if you didn't care who won. But I told them I was proud of them, but I also told them that it's supposed to hurt. We have to find a way to win football games.\"</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":false,"byline":"Todd Archer","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50051416"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50051416"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50051416"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50051416/nfl-dallas-cowboys-dak-prescott-baltimore-ravens-rio-de-janeiro-field-goal"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:21Z","status":"success"}