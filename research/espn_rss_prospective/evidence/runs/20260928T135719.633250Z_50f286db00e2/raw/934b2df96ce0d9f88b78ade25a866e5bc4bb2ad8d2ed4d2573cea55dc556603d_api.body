{"resultsCount":1,"resultsLimit":10,"resultsOffset":0,"headlines":[{"id":50050195,"nowId":"1-50050195","contentKey":"50050195-1-5-1","dataSourceIdentifier":"a207e8c00122a","publishedkey":"50050195","type":"HeadlineNews","feedDisplayType":"Default","headline":"After Broncos' latest comeback, Payton pushes for stronger starts","description":"In their latest wild ending, the Broncos rebounded from a first-half shutout to score a 30-26 victory over the Rams.","title":"After Broncos' latest comeback, Payton pushes for stronger starts","linkText":"Payton: Broncos can't keep relying on comebacks","categorized":"2026-09-28T12:44:08Z","originallyPosted":"2026-09-28T06:22:40Z","lastModified":"2026-09-28T11:10:36Z","published":"2026-09-28T11:10:36Z","root":"nfl","section":"NFL","images":[{"dataSourceIdentifier":"294508c3f9ec9","id":50048539,"type":"header","name":"SNF: Rams-Broncos photodesk [600x400]","credit":"Brooke Sutton/Getty Images","height":400,"width":600,"url":"https://a.espncdn.com/photo/2026/0928/r1722776_600x400_3-2.jpg"},{"type":"Media","name":"Broncos pick off Stafford on final play to seal win over Rams","caption":"Broncos pick off Stafford on final play to seal win over Rams","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0928/4de67e1575a3416ab1376a7be662428d25/4de67e1575a3416ab1376a7be662428d25.jpg"}],"video":[{"id":50049788,"dataSourceIdentifier":"3d07512c06b87","cerebroId":"6ab9e72d75ba89659fc67895","pccId":"a5a753bb-709e-4e5b-a8b6-787f7f8fd62c","source":"espn","headline":"Broncos pick off Stafford on final play to seal win over Rams","shortHeadline":"Broncos pick off Stafford on final play to seal win over Rams","caption":"Broncos pick off Stafford on final play to seal win over Rams","title":"Broncos pick off Stafford on final play to seal win over Rams","description":"Broncos pick off Stafford on final play to seal win over Rams","shortDescription":"Broncos pick off Stafford on final play to seal win over Rams"