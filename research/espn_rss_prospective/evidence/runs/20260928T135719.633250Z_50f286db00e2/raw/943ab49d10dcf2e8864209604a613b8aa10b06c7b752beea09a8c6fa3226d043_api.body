{"resultsCount":1,"resultsLimit":10,"resultsOffset":0,"headlines":[{"id":50042344,"nowId":"1-50042344","contentKey":"50042344-1-6-1","dataSourceIdentifier":"2d58fb844c93c","publishedkey":"50042344","type":"Story","feedDisplayType":"Default","headline":"Eagles' DeVonta Smith is headed into another stratosphere","description":"The Eagles' go-to guy in key moments has always seen himself as WR1 -- now everyone else is just catching up.","title":"Eagles' DeVonta Smith is headed into another stratosphere","linkText":"DeVonta Smith is Eagles' undisputed No. 1 WR. He was shaped by perseverance","categorized":"2026-09-28T12:45:16Z","originallyPosted":"2026-09-28T10:00:00Z","lastModified":"2026-09-28T12:45:15Z","published":"2026-09-28T12:45:15Z","root":"nfl","section":"NFL","source":"ESPN","images":[{"dataSourceIdentifier":"53afa65899c81","id":50021977,"type":"header","name":"DeVonta Smith [1296x729]","caption":"Despite Smith's stoic public demeanor and team-first approach, he has always seen himself as a true No. 1.","credit":"Michael Owens/Getty Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/0924/r1721366_2_1296x729_16-9.jpg"},{"dataSourceIdentifier":"d92caed6cdba1","id":50029112,"type":"header","name":"Devonta Smith [2000x1332]","caption":"Smith with Izarius Grady, better known as \"Pip,\" Smith's best friend dating back to when they were in grade school.","credit":"Courtesy Izarius Grady","height":1332,"width":2000,"url":"https://a.espncdn.com/photo/2026/0925/r1721804_2000x1332cc.jpg"},{"dataSourceIdentifier":"4904f96a6fe36","id":50029114,"type":"header","name":"Devonta Smith HS [1050x1820]","caption":"Smith was highly recruited coming out of high school.","credit":"Tangipahoa Parish","height":1820,"width":1050,"url":"https://a.espncdn.com/photo/2026/0925/r1721803_1050x1820cc.jpg"},{"type":"Media","name":"How DeVonta Smith proved that \"he'll be awesome this season\" in fantasy","caption":"How DeVonta Smith proved that \"he'll be awesome this season\" in fantasy","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0920/ss_20260920_180834859_3669474/ss_20260920_180834859_3669474.jpg"}],"video":[{"id":49993273,"dataSourceIdentifier":"0ca75c6fa1b4d","cerebroId":"6ab0596019bf1f0c1f4771ec","pccId":"ee12f6b7-ac1e-4861-a2a9-83e2701c6dd0","source":"espn","headline":"How DeVonta Smith proved that \"he'll be awesome this season\" in fantasy","shortHeadline":"How DeVonta Smith proved that \"he'll be awesome this season\" in fantasy","caption":"How DeVonta Smith proved that \"he'll be awesome this season\" in fantasy","title":"How DeVonta Smith proved that \"he'll be awesome this season\" in fantasy","description":"How DeVonta Smith proved that \"he'll be awesome this season\" in fantasy","shortDescription":"How DeVonta Smith proved that \"he'll be awesome this season\" in fantasy","lastModified":"2026-09-20T23:22:57Z","originalPublishDate":"2026-09-20T22:08:32Z","premium":false,"syndicatable":true,"duration":48,"videoRatio":"16:9","timeRestrictions":{"embargoDate":"2026-09-20T22:08:31Z","expirationDate":"2026-09-29T04:15:00Z"},"deviceRestrictions":{"devices":["settop","tablet","handset","ipad","desktop"],"type":"whitelist"},"thumbnail":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0920/ss_20260920_180834859_3669474/ss_20260920_180834859_3669474.jpg","images":[{"name":"Poster Image","caption":"","alt":"","credit":"","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0920/ss_20260920_180834859_3669474/ss_20260920_180834859_3669474.jpg"}],"posterImages":{"default":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0920/ss_20260920_180834859_3669474/ss_20260920_180834859_3669474_default.jpg","width":576,"height":324},"firstFrame":{"href":"https://cmp-espn.media.dssott.com/opp/img/espn/2026/0920/ss_20260920_180834859_3669474/ss_20260920_180834859_3669474/thumb-1-w720-h406-f4.jpg"},"full":{"href":"https://espnmedi