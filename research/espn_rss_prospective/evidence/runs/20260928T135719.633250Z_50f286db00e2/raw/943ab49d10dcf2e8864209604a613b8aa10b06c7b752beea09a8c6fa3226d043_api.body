www.espn.com/nfl/player/_/id/4241478/devonta-smith"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4241478/devonta-smith"}}}}},{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}}],"ad":{"bundle":"sunday_fantasy_reactions","sport":"fantasy"},"contributingPartner":"wsc","contributingSystem":"wsc","tracking":{"coverageType":"Fantasy","leagueName":"Fantasy NFL","sportName":"football","trackingId":"dm_NFL_FANTASY_how_devonta_smith_proved_that_hell_be_awesome_this_season_in_week_2","trackingName":"COM_NFL Fantasy (How DeVonta Smith proved that \"he'll be awesome this season\" in fantasy) 2026/09/20 FFIA"}}],"related":[{"id":49972586,"dataSourceIdentifier":"e95d8caef689b","publishedkey":"49972586","type":"Story","headline":"Eagles' new perspective for '26: Don't 'let anyone steal our joy'","title":"Eagles' new perspective for '26: Don't 'let anyone steal our joy'","linkText":"Eagles' new perspective for '26: Don't 'let anyone steal our joy'","images":[{"dataSourceIdentifier":"95ab76f48633c","id":49960038,"type":"header","name":"Saquon Barkley [1296x729]","credit":"Michael Owens/Getty Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/0916/r1717749_1296x729_16-9.jpg"}],"byline":"Tim McManus","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/49972586"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=49972586"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=49972586"},"web":{"href":"https://www.espn.com/nfl/story/_/id/49972586/philadelphia-eagles-new-perspective-2026-let-anyone-steal-our-joy-saquon-barkley"}},"premium":false},{"id":49733543,"dataSourceIdentifier":"fbef7643b60e8","publishedkey":"49733543","type":"Story","headline":"Uar Bernard is the Eagles' newest quick study: 'Not of this world'","title":"Uar Bernard is the Eagles' newest quick study: 'Not of this world'","linkText":"'Built by the gods:' Uar Bernard, from Nigeria, has captivated the Eagles","source":"ESPN","images":[{"dataSourceIdentifier":"de20b8c01542d","id":49716878,"type":"header","name":"Uar Bernard [1296x729]","caption":"Football wasn't even on Bernard's radar until 2022 when he was 17, only to be drafted by the Philadelphia Eagles in 2026.","credit":"Chris Szagola/AP","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/0825/r1706538_1296x729_16-9.jpg"}],"byline":"Tim McManus","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/49733543"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=49733543"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=49733543"},"web":{"href":"https://www.espn.com/nfl/story/_/id/49733543/philadelphia-eagles-uar-bernard-2026-rookie"}},"premium":false}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":1407,"type":"team","uid":"s:20~l:28~t:21","guid":"d1a9b001-1df7-fbd7-ae4c-6ca7065286ec","description":"Philadelphia Eagles","sportId":28,"teamId":21,"team":{"id":21,"description":"Philadelphia Eagles","abbreviation":"PHI","shortDisplayName":"Eagles","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/phi/philadelphia-eagles"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/phi/philadelphia-eagles"}}}}},{"id":470127,"type":"athlete","uid":"s:20~l:28~a:4241478","guid":"79fe15c5-5f05-f939-c4f5-c55466521a50","description":"DeVonta Smith","sportId":28,"athleteId":4241478,"athlete":{"id":4241478,"description":"DeVonta Smith","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4241478/devonta-smith"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4241478/devonta-smith"}}}}},{"id":696391,"type":"contributor","guid":"e28af6cd-603c-3042-a666-1dfbc724a082","description":"Tim McManus","slug":"tim-mcmanus","contributor":{"id":2723,"description":"Tim McManus"}}],"keywords":["NFL","Philadelphia Eagles","DeVonta Smith","Tim McManus"],"story":"<p><video1></p>\n<p><strong>THE <a data-clubhouse-guid=\"d1a9b001-1df7-fbd7-ae4c-6ca7065286ec\" href=\"https://www.espn.com/nfl/team/_/name/phi/philadelphia-eagles\">PHILADELPHIA EAGLES</a>' </strong>offense stepped onto the field in Week 2 down three on the road against the <a data-clubhouse-guid=\"0a0aea59-9a5e-01b3-57a3-0151cf4bf393\" href=\"https://www.espn.com/nfl/team/_/name/ten/tennessee-titans\">Tennessee Titans</a> with 1:56 remaining. It was the kind of moment, receiver <a data-player-guid=\"79fe15c5-5f05-f939-c4f5-c55466521a50\" href=\"https://www.espn.com/nfl/player/_/id/4241478/devonta-smith\">DeVonta Smith</a> said immediately following the game, that \"you live for.\"</p>\n<p>Quarterback <a data-player-guid=\"caceb80c-6350-a107-9fcf-7c7bd1b4edd8\" href=\"https://www.espn.com/nfl/player/_/id/4040715/jalen-hurts\">Jalen Hurts</a> went to Smith four times on the drive. Four times Smith delivered, including on a sideline throw in which Smith stood on his toes and fully extended his arms to snag the ball at a 45-degree angle on his way to the ground. Tap-tap. First down. </p>\n<p>Then came the money play: third-and-6 from the Titans' 22. Hurts zipped one down the left side for Smith, who leaped and stretched high to catch the ball, pivoted away from an oncoming defender in midair, somehow, and managed to drag his feet in bounds as a pair of Titans players crashed on top of him -- a picturesque 19-yard completion that set the stage for <a data-player-guid=\"8ee714c0-1365-3a5f-afd5-a3c157062591\" href=\"https://www.espn.com/nfl/player/_/id/4715355/darius-cooper\">Darius Cooper</a>'s game-winning touchdown. </p>\n<p>\"I take a lot of pride in it,\" Smith said of being the go-to guy in key moments. There was a short pause. </p>\n<p>\"I feel like it was time,\" he continued, fresh off a 10-catch, 117-yard performance. \"It was time for me to go out there and show what I can do, that I can be that guy. I had the opportunity and I went out there and did it.\"</p>\n<p>The subtext here is that the 27-year-old Smith and the Eagles are operating in the post-<a data-player-guid=\"53cf1afe-22f9-ea1f-7d9b-a992d25c8ac5\" href=\"https://www.espn.com/nfl/player/_/id/4047646/aj-brown\">A.J. Brown</a> world after Brown was traded to the New England Patriots in the offseason. Smith and Brown shined during their four years together, becoming the first Eagles duo to each post 1,000-plus receiving yards in a single season in 2022, then they did it again in '23 and '25. The franchise's all-time postseason receiving yards leader, Smith has hardly been stuck in the shadows. </p>\n<p><alsosee></p>\n<p>But he has long been the 1B to Brown's 1A. Working alongside another alpha receiver in a run-centric system, the volume and production have always been just a tick below superstar status. He has never been an All-Pro or selected to a Pro Bowl. Now in Year 6, the 2020 Heisman Trophy winner finds himself at the center of a revamped passing offense under new coordinator Sean Mannion, backed by an organization that has expressed full confidence both publicly and behind the scenes that Smith is headed to another stratosphere. </p>\n<p>After all, from <a href=\"https://www.espn.com/college-football/game/_/gameId/400953415/alabama-georgia\">his game-winning catch</a> in the College Football Playoff National Championship game as a freshman at Alabama in 2017 to hauling in \"<a href=\"https://www.youtube.com/watch?v=ULu115SQwc4\">The Dagger</a>\" against the <a data-clubhouse-guid=\"f68f2343-8ceb-7a02-740d-af6338be21d2\" href=\"https://www.espn.com/nfl/team/_/name/kc/kansas-city-chiefs\">Kansas City Chiefs</a> in Super Bowl LIX, he has met just about every big moment he has faced.  </p>\n<p>Despite his stoic public demeanor and team-first approach, Smith has always seen himself as a true No. 1, Eagles receivers coach Aaron Moorehead said, and now has the opportunity to show the rest of the world why.</p>\n<p>\"He's not selfish, but he's fiery and feisty,\" his high school receivers coach Christopher Gordon said. \"He's always been that guy, to where it's 'Give me the ball.' You know, 'I'm gonna make a play.'\" </p>\n\n\n<hr>\n<p><photo3></p>\n<p><strong>CRIMSON TIDE AND </strong>Eagles fans owe a debt of gratitude to Izarius Grady, better known as \"Pip,\" Smith's best friend dating back to when they were in grade school. </p>\n<p>They played together on the basketball team at Amite (Louisiana) High Magnet School. The wiry 6-foot Smith was so good at the sport, Grady said, that he was reaching upward of 40 points a game in middle school while barely shooting 3s. \"Layups, floaters, crossing people up, it was just so easy for him,\" Grady said. \"I didn't see him going to the NFL. I always thought NBA, and he could tell you that, too.\" They were facing Ville Platte in the second round of the playoffs their senior year. Down two, the coaches designed a play to go to Smith but he was double-teamed at half court. Smith opted to pass the ball to Grady, who missed the shot, and Amite got knocked out of the postseason. </p>\n<p>\"I wasn't even expecting to shoot the ball,\" Grady said. \"I told him, I don't even know why he tried to pass it. I would have shot it with the double-team if I was him because he was made for those moments.\"</p>\n<p>Not long after he was selected by the Eagles 10th overall in the 2021 draft, Smith said that experience reinforced he is built for the brightest of stages and would <a href=\"https://nam04.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.nbcsportsphiladelphia.com%2Fnfl%2Fphiladelphia-eagles%2Fdevonta-smith-shares-origin-story-of-his-clutch-gene%2F182411%2F&data=05%7C02%7CAshley.Melfi%40espn.com%7C1575ce1d4fc34656fde308df19b535c1%7C56b731a8a2ac4c32bf6b616810e913c6%7C1%7C0%7C639257938209585368%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=9XrzuHK42UZwOvMcJ2LSWtP6XTu7yEvucMJ0PRlW8jo%3D&reserved=0\">\"never shy away from taking the big shot again.\"</a></p>\n<p>The idea of going to Smith for a big play is nothing new. Going back to the middle school recess yard, if your side needed something to happen, \"Just throw him the ball, he gonna make it,\" Grady said. </p>\n<p>\"He was always ahead of his peers. He was always just ahead because he always doing like some extra work and playing with older guys. Like, he could be sixth, seventh grade, but he's playing with eighth graders and ninth graders and just fitting in always.\"</p>\n<p>Athletically, sure, but not always when it came to size. </p>\n<p>Gordon, Smith's receivers coach at Amite, remembers his first impression as Smith took the field for fall camp his freshman season. </p>\n<p>\"Little skinny kid. Really, really long feet. Body looks very awkward,\" he said. \"They call him 'Skinny Batman' now, imagine what it was like as a freshman, right?\"</p>\n<p>What perplexed Gordon further was that Smith put himself at the front of the line for varsity drills. He had the thought: <em>Man, nobody's going to move him out of the way? </em>And since none of the upper classmen did, practice began. Once he started moving, the talent was evident and Smith quickly cemented his spot as the first-man up. </p>\n<p>Smith mastered things so quickly, it forced Gordon to try out new techniques and drills to challenge him. </p>\n<p>\"It was funny because coaching a kid and becoming a fan of a kid is kind of a weird space,\" Gordon said. \"Like I found myself being a fanboy at times just because of how he would do the things that he would do.\"</p>\n<p>Still, Smith weighed 120 pounds as a freshman in high school. Determined to get bigger and stronger, he set an alarm on his watch and anytime it went off, no matter where he was, he would drop down and do pushups. </p>\n<p>Zephaniah Powell, the school's head football coach and dean of discipline, remembers walking the halls during a class change and seeing Smith through a sea of bodies dropping to the ground.</p>\n<p>\"So I get there and he gets up off the ground. I say, 'DeVonta, what are you doing?' He said, 'Well, you know, Coach, I'm a little slighter of build, so I know I have to get bigger. So every time I see my reflection, no matter if it's in a window or water puddle or whatever, I drop down to do pushups,'\" Powell said. \"I say, 'You do this every day, all day? He says 'Yes sir, and plus I'm in the weight room as well.'\"</p>\n<p>Smith's \"undeniable will,\" as Powell put it, is what set him apart in the minds of those who watched his climb. His mindset was molded in part by his mother, Christina Smith-Sylve, a social worker in southeastern Louisiana. Smith would sometimes accompany his mom as she handled family welfare cases. </p>\n<p>\"The uncomfortable things she had to do that she probably wasn't comfortable doing and the sacrifices she made put life into a different perspective,\" Smith said. </p>\n<p>That will showed up in the lead-up to Amite's state championship game against Lutcher High School his senior year. A foot injury left Smith sidelined from practice the entire week. \"I could barely walk,\" he said. The injury -- reportedly a dislocated toe -- sent him to the emergency room the night before the game, in pain but desperate to play in a game he and his teammates had been dreaming about since little league. </p>\n<p>Smith not only played but was named the game's most outstanding player after catching 8 passes for 111 yards, returning a kickoff for a touchdown and coming up with an interception on defense. Amite lost in heartbreaking fashion, 40-36, in a game played at the Caesars Superdome. One of the lasting images from that game is of Smith sitting on the field after that loss with tears streaming down his face. </p>\n<p>It wasn't lost on anyone who knows his story that his brightest moment to date as a pro -- his 46-yard touchdown in Super Bowl LIX against the Chiefs that put that game on ice during the '24 season -- came in that same stadium, about an hour away from his hometown.</p>\n\n\n<hr>\n\n\n<p><photo2></p>\n<p><strong>SMITH WAS HIGHLY</strong> recruited coming out of high school, including by in-state LSU, which even had the same team colors as Amite. Smith, though, ultimately felt the most comfortable at Alabama. </p>\n<p>But it took some time for Alabama to get comfortable with him. </p>\n<p>\"It wasn't as easy as everybody thought. [Coach Nick Saban] didn't offer me at first because of the size thing,\" Smith said during a 2021 podcast appearance with Shannon Sharpe. \"It was like, we need you to gain some weight before we offer you.\"</p>\n<p>No matter what he ate or how many pushups he did, Smith weighed around 145 pounds as a senior. </p>\n<p>Smith credits his mentor, Vincent Sanders, for continuing to drive him to the Tide's prospect camp despite their initial hesitancy -- a persistence that eventually paid off, as Saban realized Smith continually got the best of defensive backs he faced, regardless of his size, and ultimately offered him a scholarship. </p>\n<p>Smith said he was \"in his feelings\" at first about the school's initial reluctance but put that aside and focused on the opportunity. </p>\n<p>Smith finished his college career as a two-time national champion, the SEC's leader in receiving yards and touchdowns, and the first receiver to win the Heisman Trophy since Desmond Howard in 1991. </p>\n<p>Saban ended up being one of Smith's strongest advocates in the lead-up to the 2021 draft. </p>\n<p>\"To look at him and say he only weighs 170 pounds as a reason not to pick him, I would say to them: 'The ball weighs 13 ounces; how big do you have to be to carry it?'\" Saban said during an appearance on \"The Rich Eisen Show.\"</p>\n<p>Coach Gordon said there are times when Smith absorbs a big hit during an NFL game where he'll find himself standing right in front of the television, imploring him to \"Get up, son.\"</p>\n<p>\"And he pops right up. 'You're all right,'\" he'd say. </p>\n<p>\"It's amazing to see him go after goal after goal. It gives so much to the people of this community -- and ... anyone that is always looked at as the underdog.\"</p>\n<p>Through two Eagles games this season, Smith ranked sixth in targets (19), seventh in receptions (13) and 13th in yards (170) among all pass catchers. He is on pace for over 1,400 receiving yards, which would be a career high by a significant margin and would likely lead to his first Pro Bowl nod. </p>\n\n\n<hr>\n<p><photo1></p>\n<p><strong>A COUPLE OF </strong>years<strong> </strong>ago, Brown was speaking with reporters in the locker room after practice and was pushing back on the notion that he was a diva receiver.</p>\n<p>\"Honestly, man, I don't even ask for the ball in the game. ... Smitty is the more vocal one. Y'all don't even see that,\" Brown said with a smile, with Smith in earshot a locker over. </p>\n<p>People who know Smith say his desire to get the ball and make a meaningful impact on the game burns as hotly as anyone's. It's just stored behind a world-class poker face and don't-say-more-than-you-have-to approach with media.</p>\n<p>Winning has always been Smith's first priority. He and Brown were tight during their four years together as they rearranged the Eagles record books and helped the team to a pair of Super Bowl appearances. </p>\n<p>Sharing the spotlight with Brown, and guys such as <a data-player-guid=\"db4bf6c9-e27d-8382-372f-120b3da89bd6\" href=\"https://www.espn.com/nfl/player/_/id/4372016/jaylen-waddle\">Jaylen Waddle</a>, <a data-player-guid=\"a6f54531-6f5b-5d5d-2026-28a308e5cb59\" href=\"https://www.espn.com/nfl/player/_/id/4241463/jerry-jeudy\">Jerry Jeudy</a> and <a data-player-guid=\"4bfb2401-3499-7fb7-2eea-a237345fed6a\" href=\"https://www.espn.com/nfl/player/_/id/3925357/calvin-ridley\">Calvin Ridley</a> before him at Alabama, seemed to help shape his mindset. </p>\n<p>When asked in January about that seemingly pivotal moment on the high school basketball court, when he passed up the last shot and vowed not to shy away from the big moment again, it was interesting to hear how Smith's response seemed to have evolved from the time he was drafted. </p>\n<p>\"Yeah, it should have been me. But it's tough when you're getting doubled at half court. You have six seconds, you're not going to take a half-court shot,\" he said.</p>\n<p>\"For me, I knew I wanted to take the last shot, everyone wanted me to take the last shot. But sometimes it don't work like that. Sometimes you have to give up things to get what you want.\"</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Tim McManus","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50042344"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50042344"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50042344"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50042344/philadelphia-eagles-devonta-smith-wr1-post-aj-brown-mnf"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:21Z","status":"success"}