665/brock-bowers"}}}}},{"id":492021,"type":"athlete","uid":"s:20~l:28~a:4596448","guid":"238a73f9-bf33-3ca3-8a87-a8660792d463","description":"Bucky Irving","sportId":28,"athleteId":4596448,"athlete":{"id":4596448,"description":"Bucky Irving","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4596448/bucky-irving"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4596448/bucky-irving"}}}}},{"id":126377,"type":"athlete","uid":"s:20~l:28~a:16737","guid":"5073fc58-91c1-4e3d-826d-af754f9f40c7","description":"Mike Evans","sportId":28,"athleteId":16737,"athlete":{"id":16737,"description":"Mike Evans","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/16737/mike-evans"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/16737/mike-evans"}}}}},{"id":435021,"type":"athlete","uid":"s:20~l:28~a:4262921","guid":"c7fb1996-2530-7f98-9f2f-572debf989f4","description":"Justin Jefferson","sportId":28,"athleteId":4262921,"athlete":{"id":4262921,"description":"Justin Jefferson","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4262921/justin-jefferson"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4262921/justin-jefferson"}}}}},{"id":184532,"type":"athlete","uid":"s:20~l:28~a:3052587","guid":"5bb4376a-d089-e3e4-e49a-44f1d709a012","description":"Baker Mayfield","sportId":28,"athleteId":3052587,"athlete":{"id":3052587,"description":"Baker Mayfield","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3052587/baker-mayfield"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3052587/baker-mayfield"}}}}},{"id":698729,"type":"contributor","guid":"6f206a9b-4c7e-3475-bf3f-090be4770216","description":"Tristan H. Cockcroft","slug":"tristan-h.-cockcroft","contributor":{"id":1115,"description":"Tristan H. Cockcroft"}},{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}}],"keywords":["news - fantasy","news - fantasy football","Fantasy NFL","Jahmyr Gibbs","Jaxon Smith-Njigba","Amon-Ra St Brown","Chase Brown","Jonathan Taylor","Jaylen Warren","Marcus Mariota","Terry McLaurin","Sam Darnold","Kenyon Sadiq","Garrett Wilson","Geno Smith","Harold Fannin Jr","Joe Burrow","Tetairoa McMillan","Malik Nabers","Omarion Hampton","Breece Hall","Jalen Coker","De'Von Achane","Drake Maye","David Montgomery","Jadarian Price","Brock Purdy","George Kittle","Tyler Shough","Jacoby Brissett","Michael Wilson","Brock Bowers","Bucky Irving","Mike Evans","Justin Jefferson","Baker Mayfield","Tristan H. Cockcroft","NFL"],"story":"<p><photo1></p>\n<p>Week 3 of the 2026 fantasy football season featured huge games by Seahawks WR <a data-player-guid=\"edf87204-0e8c-331c-ac63-c6e04a89ee76\" href=\"https://www.espn.com/nfl/player/_/id/4430878/jaxon-smith-njigba\">Jaxon Smith-Njigba</a> and Lions RB <a data-player-guid=\"d85aed19-e3b8-3788-935e-55f636ad86e9\" href=\"https://www.espn.com/nfl/player/_/id/4429795/jahmyr-gibbs\">Jahmyr Gibbs</a>. On the flip side, fantasy stars <a href=\"https://www.espn.com/nfl/player/_/id/4374302/amon-ra-st-brown\">Amon-Ra St. Brown</a>, <a data-player-guid=\"ddd8786c-fd5a-4e55-ccc8-6ddf6f1ede33\" href=\"https://www.espn.com/nfl/player/_/id/4242335/jonathan-taylor\">Jonathan Taylor</a> and <a data-player-guid=\"07049770-8e6a-c054-e9f3-0a204d623b57\" href=\"https://www.espn.com/nfl/player/_/id/4362238/chase-brown\">Chase Brown</a> had disappointing games.</p>\n<p>Who were the big winners and losers around the league during the third week of the fantasy football season?</p>\n<p>Matt Bowen and Tristan H. Cockcroft offer their analysis.</p>\n<center>\n<p align=\"center\"><strong>Jump to a topic:<br>\n<a href=\"https://www.espn.com/fantasy/football/story/_/page/FFSundayHighLows-50044626/nfl-week-3-fantasy-football-winners-losers-injuries-rankings-more#winners\">Ranking winners</a> | <a href=\"https://www.espn.com/fantasy/football/story/_/page/FFSundayHighLows-50044626/nfl-week-3-fantasy-football-winners-losers-injuries-rankings-more#losers\">Ranking losers</a> </strong><br>\n<b><a href=\"https://www.espn.com/fantasy/football/story/_/page/FFSundayHighLows-50044626/nfl-week-3-fantasy-football-winners-losers-injuries-rankings-more#injuries\">Biggest injuries and what's next</a></b></p>\n</center>\n<p><strong><a name=\"winners\"></a></strong></p>\n<p><strong><strong><img alt=\"\" src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></strong></strong></p>\n<h2>Ranking fantasy winners of Week 3</h2>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/det.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">1. Jahmyr Gibbs, RB, <a data-clubhouse-guid=\"56caffee-178d-f6f2-a076-b277486b8c32\" href=\"https://www.espn.com/nfl/team/_/name/det/detroit-lions\">Detroit Lions</a></h2>\n<p>He's sure proving worthy of that No. 1 overall pick. He has scored at least 23 fantasy points in all three games, posted 75% snap and 78% rushing shares, and he has totaled an easily position-best 98.3 points for the season. That latter number ranks 15th in history through three team games of any season. <a data-player-guid=\"b80fe7c4-00cc-27e8-a8a5-e4f408778fb0\" href=\"https://www.espn.com/nfl/player/_/id/4361529/isiah-pacheco\">Isiah Pacheco</a>'s back and MCL injuries have locked Gibbs in as a three-down dynamo, and the odds are good that he will maintain his positional lead in fantasy points for the duration of 2026. <i>-- Cockcroft</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/sea.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">2. Jaxon Smith-Njigba, WR, and <a data-player-guid=\"938f19a1-ef9b-618c-2365-d55291e0fcc6\" href=\"https://www.espn.com/nfl/player/_/id/3912547/sam-darnold\">Sam Darnold</a>, QB, <a data-clubhouse-guid=\"3767a23c-a17d-294f-288a-9086ad1f0680\" href=\"https://www.espn.com/nfl/team/_/name/sea/seattle-seahawks\">Seattle Seahawks</a></h2>\n<p><inline1></p>\n<p>It's incredible to think that Smith-Njigba is off to the stellar start that he is despite Darnold having missed nearly all of the first two weeks due to injury and the team's running game having been only so-so thus far. Smith-Njigba scored 35.36 fantasy points, giving him 104.06 through three games, the fourth most ever through that many by any player. Meanwhile, Darnold threw a pair of interceptions in his return to the lineup, but he didn't seem at all slowed by the glute injury, finishing with 27.66 points of his own. Smith-Njigba's elite play should bring Darnold's fantasy utility up, and the two have a good matchup against the struggling <a data-clubhouse-guid=\"84caf62b-c753-71ea-a787-44fd224a4294\" href=\"https://www.espn.com/nfl/team/_/name/lac/los-angeles-chargers\">Los Angeles Chargers</a> in Week 4 before hitting a tougher stretch of the 2026 schedule (SF, @DEN, KC in Weeks 5-7). <i>-- Cockcroft</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/cin.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">3. <a data-player-guid=\"e6957db5-5b2e-a82d-c788-d889115d9772\" href=\"https://www.espn.com/nfl/player/_/id/3915511/joe-burrow\">Joe Burrow</a>, QB, and <a data-player-guid=\"f9be91fa-7d8d-811b-6452-b14d1a1feb2c\" href=\"https://www.espn.com/nfl/player/_/id/4362628/jamarr-chase\">Ja'Marr Chase</a>, WR, <a data-clubhouse-guid=\"75b8623b-8926-b411-0476-3d3602b78523\" href=\"https://www.espn.com/nfl/team/_/name/cin/cincinnati-bengals\">Cincinnati Bengals</a></h2>\n<p>In the Week 3 loss to the Steelers, Burrow notched his best numbers of the season, completing 75.7% of his throws for 282 yards and three touchdowns, plus he rushed for 13 yards (22.58 points). Chase caught nine of a team-high 12 targets for 98 yards and a score (24.8 points). That gives Chase two straight games of 24 or more points after that rough opening week. Chase will remain a top-three play at wide receiver for Week 4, while Burrow -- who has thrown for at least two touchdowns in back-to-back games -- will be a lower-tier QB1 in my ranks. <i>-- Bowen</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/nyj.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">4. <a data-player-guid=\"593e3c58-2b92-e0f1-f4a8-84215e27f023\" href=\"https://www.espn.com/nfl/player/_/id/15864/geno-smith\">Geno Smith</a>, QB, <a data-player-guid=\"da106063-995d-eaf0-54e4-ccecd5e90767\" href=\"https://www.espn.com/nfl/player/_/id/4569618/garrett-wilson\">Garrett Wilson</a>, WR, and <a data-player-guid=\"51be0cd2-da0c-360f-be3e-62ba52957c83\" href=\"https://www.espn.com/nfl/player/_/id/5083315/kenyon-sadiq\">Kenyon Sadiq</a>, TE, <a data-clubhouse-guid=\"732d3caf-b350-1e34-48c6-b7cebb4a0d88\" href=\"https://www.espn.com/nfl/team/_/name/nyj/new-york-jets\">New York Jets</a></h2>\n<p><alsosee></p>\n<p>In a positive matchup versus the Detroit secondary, Smith scored a season-best 26.04 points, throwing for 321 yards and four touchdowns. Wilson caught 10 of a team-high 13 targets, finishing with 107 yards and a touchdown (26.7 points), plus Sadiq posted his first breakout game, bringing in seven of eight targets for 105 yards and a score (23.5 points). Smith has streaming upside versus the Bears' defense in Week 4 while Wilson should be played as a WR1, and Sadiq (available in over 65% of ESPN leagues) is a must-add this week, though we still see him as a deeper-league starter for now. <i>-- Bowen</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/pit.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">5. <a data-player-guid=\"224e4c1e-625d-b1b2-b8ea-1316942fa7ac\" href=\"https://www.espn.com/nfl/player/_/id/4569987/jaylen-warren\">Jaylen Warren</a>, RB, <a data-clubhouse-guid=\"debcd592-8d53-71f1-fc15-5c8b8ef9df6e\" href=\"https://www.espn.com/nfl/team/_/name/pit/pittsburgh-steelers\">Pittsburgh Steelers</a></h2>\n<p>Warren took on a volume role in the win over the Bengals with <a data-player-guid=\"da1e8487-d66d-6ff0-7438-e9d6e77856e0\" href=\"https://www.espn.com/nfl/player/_/id/4038815/rico-dowdle\">Rico Dowdle</a> out with a toe injury. Warren, who scored a season-high 20.6 points, rushed for 127 yards on 17 carries, adding three receptions for 49 yards. If Dowdle has to sit again in Week 4 versus Cleveland, Warren can be played as a midtier RB2 in a Pittsburgh offense that finally found some juice Sunday. <i>-- Bowen</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/was.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">6. <a data-player-guid=\"33be1f4a-d812-75b9-7b7c-5319d2a7113a\" href=\"https://www.espn.com/nfl/player/_/id/2576980/marcus-mariota\">Marcus Mariota</a>, QB, and <a data-player-guid=\"04454e17-9294-6271-f951-c0339528e97e\" href=\"https://www.espn.com/nfl/player/_/id/3121422/terry-mclaurin\">Terry McLaurin</a>, WR, <a data-clubhouse-guid=\"fbeaf73e-6d6c-cca4-0809-713d9d741f90\" href=\"https://www.espn.com/nfl/team/_/name/wsh/washington-commanders\">Washington Commanders</a></h2>\n<p>In what looked like a tough Week 3 matchup versus the Seattle defense, Mariota scored 20.42 points in the upset win, throwing for three 183 yards and three touchdowns. McLaurin caught six of a team-high nine targets, finishing with 77 yards and a touchdown (19.7 points). With this type of volume and clear on-the-field chemistry with Mariota, McLaurin fits as a WR2/Flex for next week's matchup versus the Colts. As for Mariota, he can be started as a QB2 in superflex formats. <i>-- Bowen</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/sf.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">7. <a data-player-guid=\"d2e39a38-732d-5a24-f242-a4f9de87dabe\" href=\"https://www.espn.com/nfl/player/_/id/4361741/brock-purdy\">Brock Purdy</a>, QB, and <a data-player-guid=\"9c61fb91-fc5a-7cc3-8367-a8dbc589f97a\" href=\"https://www.espn.com/nfl/player/_/id/3040151/george-kittle\">George Kittle</a>, TE, <a data-clubhouse-guid=\"985a261f-296c-c95c-32a5-addc4df75001\" href=\"https://www.espn.com/nfl/team/_/name/sf/san-francisco-49ers\">San Francisco 49ers</a></h2>\n<p>Purdy scored a season-best 31.28 points versus the Cardinals, throwing for 297 yards and four touchdowns while adding 34 yards rushing. He has posted at least 21 points in all three games this season. Kittle, who had two touchdowns, caught six of seven targets for 82 yards, finishing with a season-high 26.2 points. And Kittle's usage could increase more if <a data-player-guid=\"5073fc58-91c1-4e3d-826d-af754f9f40c7\" href=\"https://www.espn.com/nfl/player/_/id/16737/mike-evans\">Mike Evans</a> (ribs) misses time. With a tough Week 4 matchup looming versus the Broncos, Purdy will be in my mid-to-lower tier QB1 ranks, but it's hard to find many quarterbacks playing at his level right now. -- <em>Bowen</em></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/lv.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">8. <a data-player-guid=\"bc4ba7ee-446b-36fd-9985-7fd2a94a98bc\" href=\"https://www.espn.com/nfl/player/_/id/4432665/brock-bowers\">Brock Bowers</a>, TE, <a data-clubhouse-guid=\"b18540eb-6f2b-534c-e7f9-9bd930518da9\" href=\"https://www.espn.com/nfl/team/_/name/lv/las-vegas-raiders\">Las Vegas Raiders</a></h2>\n<p>After missing the first couple of weeks with a knee injury, Bowers dropped 27.6 points on the Saints defense in his first game back. Bowers caught 10 of a team-high 13 targets for 116 yards and a touchdown. And as we saw in <a data-player-guid=\"35deb51f-d4d0-9f88-7efb-4893bc25295b\" href=\"https://www.espn.com/nfl/player/_/id/2181979/klint-kubiak\">Klint Kubiak</a>'s offense, Bowers is going to flex from the formation at an extremely high rate. You can lock in Bowers as a top-tier tight end. <i>-- Bowen</i></p>\n<p><video1></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/no.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">9. <a data-player-guid=\"0eb2837a-e6ed-bbd7-d7d5-cbeb2cd7ab11\" href=\"https://www.espn.com/nfl/player/_/id/4360689/tyler-shough\">Tyler Shough</a>, QB, <a data-clubhouse-guid=\"97d2f6c9-2f22-459c-306a-046941ccab2a\" href=\"https://www.espn.com/nfl/team/_/name/no/new-orleans-saints\">New Orleans Saints</a></h2>\n<p>Forgive him the two tough losses in three weeks, but he has been outstanding operating in Kellen Moore's offense thus far. Shough has exceeded 22 fantasy points in all three games, totaling 69.38, third best among quarterbacks. He is making good use of his receivers and showing strong mobility. He has arrived as a matchup-dependent fantasy QB1, and the <a data-clubhouse-guid=\"49fd392a-86fe-4df3-1b77-9bbfa18b2ad5\" href=\"https://www.espn.com/nfl/team/_/name/atl/atlanta-falcons\">Atlanta Falcons</a>, in Week 4, represent another favorable one. -- <em>Cockcroft</em></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/ari.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">10. <a data-player-guid=\"efcb42e5-0bef-62d1-b58b-dbc17fde2479\" href=\"https://www.espn.com/nfl/player/_/id/2578570/jacoby-brissett\">Jacoby Brissett</a>, QB, and <a data-player-guid=\"e5a58dd8-bc28-120e-a704-9afcb878363b\" href=\"https://www.espn.com/nfl/player/_/id/4360761/michael-wilson\">Michael Wilson</a>, WR, <a data-clubhouse-guid=\"8fc7b962-95e1-3cb8-6a7d-b499de9ad546\" href=\"https://www.espn.com/nfl/team/_/name/ari/arizona-cardinals\">Arizona Cardinals</a></h2>\n<p>The fantasy-friendly game script -- the Cardinals trailed for all but eight minutes, 40 seconds -- fueled a second-half charge by Brissett and his No. 2 target, Wilson (<a data-player-guid=\"bd8caf85-18e8-478a-ff01-42ac1225ccff\" href=\"https://www.espn.com/nfl/player/_/id/4361307/trey-mcbride\">Trey McBride</a> is the de facto No. 1). Brissett finished with 25.60 fantasy points, Wilson 25.9, with the latter's 17 targets a welcome sign. The two are unlikely to need to play as much catch-up in Week 4 against the <a data-clubhouse-guid=\"378600ea-2397-8364-8399-b7c1606a49a7\" href=\"https://www.espn.com/nfl/team/_/name/nyg/new-york-giants\">New York Giants</a>, but Brissett should be a high-end superflex and Wilson a WR3/flex nevertheless. <i>-- Cockcroft</i></p>\n<p><strong><a name=\"losers\"></a></strong></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/cle.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">11. <a data-player-guid=\"32593c89-2e72-352a-a204-a2e034ca9a81\" href=\"https://www.espn.com/nfl/player/_/id/5083076/harold-fannin-jr\">Harold Fannin Jr</a>., TE, <a data-clubhouse-guid=\"539babc5-e5fb-753b-8ae1-c15032a91ef4\" href=\"https://www.espn.com/nfl/team/_/name/cle/cleveland-browns\">Cleveland Browns</a></h2>\n<p>After relatively quiet Weeks 1 and 2, Fannin finally captured the majority of <a data-player-guid=\"b6ec8e9e-3d85-a1de-9d0a-5a51621a9c20\" href=\"https://www.espn.com/nfl/player/_/id/3122840/deshaun-watson\">Deshaun Watson</a>'s attention Sunday. Fannin's seven receptions matched his prior two-week total, he had nine of the team's 30 targets and scored 24.1 fantasy points, nearly matching his personal best of 25.4. With a pair of rookie up-and-comers in <a data-player-guid=\"1cb83812-2715-3ded-bb86-4c276fc0060c\" href=\"https://www.espn.com/nfl/player/_/id/4832800/denzel-boston\">Denzel Boston</a> and <a data-player-guid=\"0385d73f-aa41-3619-868a-98942554ba97\" href=\"https://www.espn.com/nfl/player/_/id/4870653/kc-concepcion\">KC Concepcion</a> on the roster, Fannin's production will be more hit-and-miss this year than last, but he's capable of serving as a back-end fantasy TE1. <i>-- Cockcroft</i></p>\n<p><strong><strong><img alt=\"\" src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></strong></strong></p>\n<h2>Ranking fantasy losers of Week 3</h2>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/det.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">1. Amon-Ra St. Brown, WR, Detroit Lions</h2>\n<p>After two straight games of 28 or more points to open the season, St. Brown finished with 11.9 in Sunday's win over the Jets. Concern here? Nope. Though St. Brown totaled only 19 yards receiving on four catches, he found the end zone for the third straight game and his eight targets were tied for a team high. He didn't have the big plays in this one, but he remains one of the most consistent WR1s in fantasy because of his usage and route deployment in the Lions' explosive offense. St. Brown will look to bounce back in Week 4 in a road matchup versus the Panthers. <i>-- Bowen</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/ind.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">2. Jonathan Taylor, RB, <a data-clubhouse-guid=\"582d14eb-da61-e505-cc40-d972a1b60ed1\" href=\"https://www.espn.com/nfl/team/_/name/ind/indianapolis-colts\">Indianapolis Colts</a></h2>\n<p>Taylor scored 9.2 points in a tough matchup versus the Houston defense. Yes, Taylor saw heavy usage in the run game (23 carries) but he managed just 3.0 YPC and he didn't make much of an impact as a receiver, catching two passes for four yards. Remember, Taylor had at least 25 points in each of his first two games and he has seen 20 or more touches in all three. He is the foundation of the Colts' offense. Taylor will look to get back on track in Week 4 versus the Commanders. -- <em>Bowen</em></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/cin.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">3. Chase Brown, RB, Cincinnati Bengals</h2>\n<p>Brown had season lows in carries (13), receptions (two) and points (8.9) in Sunday's loss to Pittsburgh. Plus, Brown has failed to score a touchdown in two straight games. With the Jaguars' defense on tap in Week 4, Brown should be played as a midtier RB2. <i>-- Bowen</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/sea.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">4. <a data-player-guid=\"705bfe8e-8678-32bc-a5b8-535fcca2e1cd\" href=\"https://www.espn.com/nfl/player/_/id/4685512/jadarian-price\">Jadarian Price</a>, RB, Seattle Seahawks</h2>\n<p>The ball-security questions that surrounded him coming out of Notre Dame -- he committed three fumbles and lost two in 12 games there in 2025 -- have resurfaced, as Price lost a fumble for the second consecutive week. This week's gaffe early in the first quarter resulted in his getting only two rushing attempts the remainder of the game, and Price played only 27% of the offensive snaps for the day. Fortunately for the rookie, neither <a data-player-guid=\"c3c5bc25-8a74-30c9-8727-fa80004d4152\" href=\"https://www.espn.com/nfl/player/_/id/4887558/emanuel-wilson\">Emanuel Wilson</a> (1.4 fantasy points) nor <a data-player-guid=\"31c62cd4-f12f-20bb-a436-5416989e35e1\" href=\"https://www.espn.com/nfl/player/_/id/4429835/george-holani\">George Holani</a> (10.8, mostly on receiving plays) established himself as a clear go-to back in Price's absence. That said, the Seahawks' willingness to mix and match out of the backfield, as well as <a data-player-guid=\"8d2ff97a-8928-1aaa-d9cc-20f06a9b546a\" href=\"https://www.espn.com/nfl/player/_/id/4426385/zach-charbonnet\">Zach Charbonnet</a>'s accelerating recovery from ACL surgery, cast doubts upon Price's full-season fantasy value. <i>-- Cockcroft</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/ne.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">5. <a data-player-guid=\"2fbd2f9e-624d-3e63-9bb5-9bb965782b68\" href=\"https://www.espn.com/nfl/player/_/id/4431452/drake-maye\">Drake Maye</a>, QB, <a data-clubhouse-guid=\"0078f353-fe3e-67ed-a42c-43cca0568e21\" href=\"https://www.espn.com/nfl/team/_/name/ne/new-england-patriots\">New England Patriots</a></h2>\n<p>For the third consecutive week, Maye was intercepted and held to fewer than 10 fantasy points, and his 3.76 on Sunday are the fewest he has scored in any non-Week 18 start in his career. Maye's rushing ability keeps him from being a flat-out cut in fantasy leagues, but he's struggling mightily to succeed as a passer with <a data-player-guid=\"53cf1afe-22f9-ea1f-7d9b-a992d25c8ac5\" href=\"https://www.espn.com/nfl/player/_/id/4047646/aj-brown\">A.J. Brown</a> absent. And with a brutal schedule -- one that has him traveling to Buffalo next week -- Maye isn't even a viable starter in a standard league for the time being. <i>-- Cockcroft</i></p>\n<p><video2></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/nyg.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">6. <a data-player-guid=\"44a2174b-1d11-3acf-8e75-fe0c13db47a6\" href=\"https://www.espn.com/nfl/player/_/id/4595348/malik-nabers\">Malik Nabers</a>, WR, <a data-clubhouse-guid=\"378600ea-2397-8364-8399-b7c1606a49a7\" href=\"https://www.espn.com/nfl/team/_/name/nyg/new-york-giants\">New York Giants</a></h2>\n<p>He's struggling terribly with <a data-player-guid=\"13e97d3e-2171-371b-9a7a-2c44670b5a62\" href=\"https://www.espn.com/nfl/player/_/id/4689114/jaxson-dart\">Jaxson Dart</a> out for the season. Nabers scored only 7.6 fantasy points and, coupled with his 1.1-point Week 2 stinker, has turned in two of his four worst career scores in the past two weeks while working with new quarterback <a data-player-guid=\"57af2581-cec9-d5a3-2afe-7a719925f78b\" href=\"https://www.espn.com/nfl/player/_/id/2969939/jameis-winston\">Jameis Winston</a>. In those games, Nabers has been targeted at least 10 yards downfield only three times total, with one catch for 13 yards and an interception to show for it. He might have difficulty delivering even fantasy WR2 value without a quarterback upgrade, which is something the Giants are reportedly considering. <i>-- Cockcroft</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/lac.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">7. <a data-player-guid=\"757d9056-88c7-3df1-b2e3-f6f8f186780b\" href=\"https://www.espn.com/nfl/player/_/id/4685382/omarion-hampton\">Omarion Hampton</a>, RB, Los Angeles Chargers</h2>\n<p>Is his grip on the primary running back role no longer ironclad? Hampton barely edged <a data-player-guid=\"d1faa993-e3a2-38bb-9c84-8f7e017c155c\" href=\"https://www.espn.com/nfl/player/_/id/4596334/keaton-mitchell\">Keaton Mitchell</a> in snap share (42%-36%) and total touches (15-11), and Mitchell was the one of the two with better underlying metrics. Mitchell's big-play ability keeps him a relevant factor in any backfield as long as he stays healthy, and with the Chargers off to a sluggish start, offensive coordinator Mike McDaniel seems to be going with a more rotational approach. Hampton remains a fantasy RB2, but Mitchell (available in 84.4% of ESPN leagues) should be a priority pickup. <i>-- Cockcroft</i></p>\n<p><video3></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/hou.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">8. <a data-player-guid=\"c9be5cd2-4e6a-86b1-3c08-ab4e44e6b3bf\" href=\"https://www.espn.com/nfl/player/_/id/4035538/david-montgomery\">David Montgomery</a>, RB, <a data-clubhouse-guid=\"595690b3-2161-4913-a7a7-814af2fd2621\" href=\"https://www.espn.com/nfl/team/_/name/hou/houston-texans\">Houston Texans</a></h2>\n<p>After scoring 28.9 points back in Week 1, Montgomery's value has quickly declined, as he has failed to post double digit points in back-to-back games. In Sunday's loss to the Colts, Montgomery managed 33 yards rushing on 11 carries and he caught two passes for 15 yards (6.8 points). He needs consistent volume and red zone opportunities, and we aren't seeing that right now in a Houston offense that is lacking tempo and efficiency with wide receiver <a data-player-guid=\"338aa0be-bd63-1a24-1929-796af121cefb\" href=\"https://www.espn.com/nfl/player/_/id/4258173/nico-collins\">Nico Collins</a> out. For the Week 4 game versus Dallas, I see Montgomery as a touchdown-dependent Flex. <i>-- Bowen</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/tb.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">9. <a data-player-guid=\"238a73f9-bf33-3ca3-8a87-a8660792d463\" href=\"https://www.espn.com/nfl/player/_/id/4596448/bucky-irving\">Bucky Irving</a>, RB, <a data-clubhouse-guid=\"13e8b157-a75a-ff24-ae91-fa3d52ddf204\" href=\"https://www.espn.com/nfl/team/_/name/tb/tampa-bay-buccaneers\">Tampa Bay Buccaneers</a></h2>\n<p>In the Week 3 loss to the Vikings, Irving had a season-low 7.8 points, finishing with 46 yards rushing on 15 carries, plus he caught two passes for 12 yards. I'd put this more on the matchup, as this Vikings defenses creates chaos with pressure and can overwhelm offensive fronts with their multiple looks, late movement and stunting. Hard to find daylight to run the ball versus Brian Flores' unit. Irving will look to rebound in Week 4 against the Packers. -- <em>Bowen</em></p>\n<p><strong><a name=\"injuries\"></a></strong></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/car.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\">10. <a data-player-guid=\"5b060a16-d491-3595-b199-6ba05b4d9391\" href=\"https://www.espn.com/nfl/player/_/id/4685472/tetairoa-mcmillan\">Tetairoa McMillan</a>, WR, <a data-clubhouse-guid=\"647c27bf-ab86-550e-5b83-91c29e73e4a9\" href=\"https://www.espn.com/nfl/team/_/name/car/carolina-panthers\">Carolina Panthers</a></h2>\n<p>His 3.7 fantasy points in Week 3 are the second fewest he has scored in his first 20 career games (1.5, Week 17 of 2025), and credit the opposing <a data-clubhouse-guid=\"539babc5-e5fb-753b-8ae1-c15032a91ef4\" href=\"https://www.espn.com/nfl/team/_/name/cle/cleveland-browns\">Cleveland Browns</a> -- they're 2-1! -- for focusing on him in their defensive game plan. CB <a data-player-guid=\"95f2a31d-db2e-076e-b5a9-26005a9bdfd6\" href=\"https://www.espn.com/nfl/player/_/id/3915535/denzel-ward\">Denzel Ward</a> matched up with McMillan on 26 of his 47 routes and surrendered only two targets and one 12-yard catch to him. The concern is that future opponents might see this and replicate the strategy, but McMillan remains a critical part of the Panthers' offense and plenty capable of fantasy WR2 numbers most weeks, including Week 4 against the <a data-clubhouse-guid=\"56caffee-178d-f6f2-a076-b277486b8c32\" href=\"https://www.espn.com/nfl/team/_/name/det/detroit-lions\">Detroit Lions</a>. <i>-- Cockcroft</i></p>\n<p><strong><strong><strong><img alt=\"\" src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></strong></strong></strong></p>\n<h2>Injury impact</h2>\n<p><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/sf.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></p>\n<p><b><a data-player-guid=\"5073fc58-91c1-4e3d-826d-af754f9f40c7\" href=\"https://www.espn.com/nfl/player/_/id/16737/mike-evans\">Mike Evans</a>, WR, <a data-clubhouse-guid=\"985a261f-296c-c95c-32a5-addc4df75001\" href=\"https://www.espn.com/nfl/team/_/name/sf/san-francisco-49ers\">San Francisco 49ers</a></b></p>\n<p><b>What we know:</b> Evans suffered a rib injury in the second quarter versus the Cardinals, and he was declared out for the game. Before exiting, Evans caught three of six targets for 43 yards and a touchdown (12.4 points).</p>\n<p><b>What's next: </b>If Evans misses time, managers should bump up both <a data-player-guid=\"9c61fb91-fc5a-7cc3-8367-a8dbc589f97a\" href=\"https://www.espn.com/nfl/player/_/id/3040151/george-kittle\">George Kittle</a> and Deebo Samuel as priority targets in the route tree. Plus, the receiving usage for running back Christian McCaffrey (flexed from the formation) could increase, which would open the door for rookie running back <a data-player-guid=\"18da8955-6970-39eb-bc40-a716f476a1d3\" href=\"https://www.espn.com/nfl/player/_/id/4696044/kaelon-black\">Kaelon Black</a> to see more carries. <i>-- Bowen</i></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/min.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></p>\n<p><b><a data-player-guid=\"c7fb1996-2530-7f98-9f2f-572debf989f4\" href=\"https://www.espn.com/nfl/player/_/id/4262921/justin-jefferson\">Justin Jefferson</a>, WR, <a data-clubhouse-guid=\"3db556c9-ed76-a7a5-4ccb-a92fc6db4334\" href=\"https://www.espn.com/nfl/team/_/name/min/minnesota-vikings\">Minnesota Vikings</a></b></p>\n<p><b>What we know:</b> Jefferson suffered an ankle injury in the second quarter and was unable to return, ruled out early in the third quarter.</p>\n<p><b>What's next:</b> In Jefferson's absence, <a data-player-guid=\"7e13f346-0248-31d6-a4e7-8467003d0f8b\" href=\"https://www.espn.com/nfl/player/_/id/4429205/jordan-addison\">Jordan Addison</a> dominated the Vikings' receiving work, easily pacing the team in routes run (32), targets (nine) and fantasy points (20.0). Ankle injuries can linger, and Addison should be added in any of the roughly 30% of ESPN leagues in which he's available. <a data-player-guid=\"3abf6eac-14c3-1c87-1bbf-346234d9af21\" href=\"https://www.espn.com/nfl/player/_/id/3886598/jauan-jennings\">Jauan Jennings</a> and <a data-player-guid=\"35890a95-a2fa-35a7-a063-4e20206ebaec\" href=\"https://www.espn.com/nfl/player/_/id/4565185/tai-felton\">Tai Felton</a> will also move up on the depth chart if Jefferson misses additional time. <i>-- Cockcroft</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/mia.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></h2>\n<p><b><a data-player-guid=\"ce7195db-c46d-3963-a973-2fadf206a70b\" href=\"https://www.espn.com/nfl/player/_/id/4429160/devon-achane\">De'Von Achane</a>, RB, <a data-clubhouse-guid=\"af33088b-1e19-d27d-dbc0-354fd7151703\" href=\"https://www.espn.com/nfl/team/_/name/mia/miami-dolphins\">Miami Dolphins</a></b></p>\n<p><b>What we know:</b> Achane left with a knee injury in the first half versus Kansas City. He was downgraded to questionable and later ruled out of the game.</p>\n<p><b>What's next:</b> With Achane potentially facing a serious injury, managers can pivot to <a data-player-guid=\"47d181c5-f3aa-37fb-8f46-5305d4977f12\" href=\"https://www.espn.com/nfl/player/_/id/4711533/ollie-gordon-ii\">Ollie Gordon II</a> as a potential replacement. Gordon, who is available in over 98% of ESPN leagues, finished with 55 total yards and a touchdown on 20 touches (14.5 points) in relief.<i> -- Bowen</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/tb.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></h2>\n<p><b><a data-player-guid=\"5bb4376a-d089-e3e4-e49a-44f1d709a012\" href=\"https://www.espn.com/nfl/player/_/id/3052587/baker-mayfield\">Baker Mayfield</a>, QB, <a data-clubhouse-guid=\"13e8b157-a75a-ff24-ae91-fa3d52ddf204\" href=\"https://www.espn.com/nfl/team/_/name/tb/tampa-bay-buccaneers\">Tampa Bay Buccaneers</a></b></p>\n<p><b>What we know:</b> Mayfield went down late with a thumb injury in the loss to the Vikings. He is scheduled to undergo MRI testing Monday.</p>\n<p><b>What's next: </b>If Mayfield is out for the Week 4 game at Green Bay, undrafted rookie <a data-player-guid=\"aaab6e81-bfa6-3ceb-bb91-e9e31a23552b\" href=\"https://www.espn.com/nfl/player/_/id/4596472/jalon-daniels\">Jalon Daniels</a> (Kansas) would be in line to get the start. We would expect a run-heavy game script, featuring designed carries for Daniels and more play-action throws, which would limit the value of <a data-player-guid=\"48fb595b-ecda-3de2-9c05-fcc8090c4b84\" href=\"https://www.espn.com/nfl/player/_/id/4567750/emeka-egbuka\">Emeka Egbuka</a> and <a data-player-guid=\"20e1bec6-fb6a-9ab1-92e0-c13eff7a7d42\" href=\"https://www.espn.com/nfl/player/_/id/3116165/chris-godwin-jr\">Chris Godwin Jr</a>. <i>-- Bowen</i></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/car.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></p>\n<p><b><a data-player-guid=\"1461459b-e133-3455-af3e-896df9dbca39\" href=\"https://www.espn.com/nfl/player/_/id/4695883/jalen-coker\">Jalen Coker</a>, WR, <a data-clubhouse-guid=\"647c27bf-ab86-550e-5b83-91c29e73e4a9\" href=\"https://www.espn.com/nfl/team/_/name/car/carolina-panthers\">Carolina Panthers</a></b></p>\n<p><b>What we know:</b> Coker left with a quad injury in the second half in Cleveland and did not return. Before exiting, Coker caught two of four targets for 14 yards (3.8 points).</p>\n<p><b>What's next: </b>While we monitor the status of Coker this week, managers can put Panthers' wide receiver <a data-player-guid=\"34f9a2e8-0b49-682f-8830-9ddf1fa241cd\" href=\"https://www.espn.com/nfl/player/_/id/4360763/brycen-tremayne\">Brycen Tremayne</a> on the radar. With Coker out, Tremayne saw a jump in snaps, catching four of six targets (second most) for 83 yards versus the Browns. <i>-- Bowen</i></p>\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/nyj.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></h2>\n<p><b><a data-player-guid=\"51a1d50b-8a57-bc27-279e-d077fa3df4f0\" href=\"https://www.espn.com/nfl/player/_/id/4427366/breece-hall\">Breece Hall</a>, RB, New York Jets</b></p>\n<p><b>What we know:</b> Hall left early in the fourth quarter with a thigh injury and was unable to return. Per the New York Post's Brian Costello, Hall said he \"felt something\" while running.</p>\n<p><b>What's next:</b> Should Hall's injury cost him additional time, <a data-player-guid=\"a18e1e42-a004-350d-97aa-e4eb606b27dd\" href=\"https://www.espn.com/nfl/player/_/id/4685247/braelon-allen\">Braelon Allen</a> will soar to or near the top of Week 4 waiver priority lists as the probable fill-in at running back. Allen has totaled 17.2 fantasy points in limited action thus far. <i>-- Cockcroft</i></p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Matt Bowen and Tristan H. Cockcroft","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50044626"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50044626"}},"mobile":{"href":"http://m.espn.go.com/wireless/story?storyId=50044626"},"web":{"href":"https://www.espn.com/fantasy/football/story/_/page/FFSundayHighLows-50044626/nfl-week-3-fantasy-football-winners-losers-injuries-rankings-more"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:22Z","status":"success"}