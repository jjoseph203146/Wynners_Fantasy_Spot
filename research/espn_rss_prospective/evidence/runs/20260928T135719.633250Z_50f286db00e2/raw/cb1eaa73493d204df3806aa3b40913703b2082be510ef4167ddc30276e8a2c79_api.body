{"resultsCount":1,"resultsLimit":10,"resultsOffset":0,"headlines":[{"id":50047972,"nowId":"1-50047972","contentKey":"50047972-1-5-1","dataSourceIdentifier":"1ebaf08b8519b","publishedkey":"50047972","type":"HeadlineNews","feedDisplayType":"Default","headline":"Bucs QB Baker Mayfield has dislocated thumb, will undergo MRI","description":"Buccaneers quarterback Baker Mayfield suffered a dislocated right thumb in the fourth quarter of Sunday's 23-16 loss to the Vikings, coach Todd Bowles said.","title":"Bucs QB Baker Mayfield has dislocated thumb, will undergo MRI","linkText":"Bucs QB Mayfield has dislocated thumb, will undergo MRI","categorized":"2026-09-28T12:44:07Z","originallyPosted":"2026-09-27T23:53:31Z","lastModified":"2026-09-28T02:53:54Z","published":"2026-09-28T02:53:54Z","root":"nfl","section":"NFL","images":[{"dataSourceIdentifier":"e44706448af85","id":50047955,"type":"header","name":"Baker Mayfield  [1296x729]","credit":"Matt Pendleton-Imagn Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/0927/r1722745_1296x729_16-9.jpg"},{"type":"Media","name":"Baker Mayfield in visible pain after thumb injury","caption":"Baker Mayfield in visible pain after thumb injury","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/239cedc558074514a553752bb3c2ed9c1182/239cedc558074514a553752bb3c2ed9c1182.jpg"}],"video":[{"id":50047819,"dataSourceIdentifier":"d66324f62aad4","cerebroId":"6ab9a712f340d6751fab375d","pccId":"fd98890c-ced8-4f7c-af84-12a5acd4d8be","source":"espn","headline":"Baker Mayfield in visible pain after thumb injury","shortHeadline":"Baker Mayfield in visible pain after thumb injury","caption":"Baker Mayfield in visible pain after thumb injury","title":"Baker Mayfield in visible pain after thumb injury","description":"Baker Mayfield in visible pain after thumb injury","shortDescription":"Baker Mayfield in visible pain after thumb injury","lastModified":"2026-09-28T00:31:40Z","originalPublishDate":"2026-09-27T23:30:26Z","premium":false,"syndicatable":true,"duration":60,"videoRatio":"16:9,9:16","timeRestrictions":{"embargoDate":"2026-09-27T23:30:25Z","expirationDate":"2026-09-29T23:30:00Z"},"deviceRestrictions":{"devices":["settop","tablet","handset","ipad","desktop"],"type":"whitelist"},"thumbnail":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/239cedc558074514a553752bb3c2ed9c1182/239cedc558074514a553752bb3c2ed9c1182.jpg","images":[{"name":"Poster Image","caption":"","alt":"","credit":"","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/239cedc558074514a553752bb3c2ed9c1182/239cedc558074514a553752bb3c2ed9c1182.jpg"}],"posterImages":{"default":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/239cedc558074514a553752bb3c2ed9c1182/239cedc558074514a553752bb3c2ed9c1182_default.jpg","width":576,"height":324},"firstFrame":{"href":"https://cmp-espn.media.dssott.com/opp/img/espn/wsc/2026/0927/239cedc5-5807-4514-a553-752bb3c2ed9c/239cedc5-5807-4514-a553-752bb3c2ed9c/thumb-1-w720-h406-f4.jpg"},"full":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/239cedc558074514a553752bb3c2ed9c1182/239cedc558074514a553752bb3c2ed9c1182.jpg"},"square":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/239cedc558074514a553752bb3c2ed9c1182/239cedc558074514a553752bb3c2ed9c1182_1x1.jpg"},"vertical":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/239cedc558074514a553752bb3c2ed9c1182/239cedc558074514a553752bb3c2ed9c1182_9x16.jpg"},"verticalFirstFrame":{"href":"https://cmp-espn.media.dssott.com/opp/img/espn/9x16/wsc/2026/0927/239cedc5-5807-4514-a553-752bb3c2ed9c/239cedc5-5807-4514-a553-752bb3c2ed9c/thumb-1-w406-h720-f4.jpg"},"wide":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/239cedc558074514a553752bb3c2ed9c1182/239cedc558074514a553752bb3c2ed9c1182_5x2.jpg"}},"links":{"api":{"artwork":{"href":"https://artwork.api.espn.com/artwork/collections/media/fd98890c-ced8-4f7c-af84-12a5acd4d8be"},"self":{"href":"https://content.core.api.espn.com/v1/video/clips/50047819"}},"mobile":{"href":"https://watch.auth.api.espn.com/video/auth/brightcove/fd98890c-ced8-4f7c-af84-12a5acd4d8be/asset?UMADPARAMreferer=https://www.espn.com/video/clip/_/id/50047819/baker-mayfield-visible-pain-thumb-injury","alert":{"href":"https://m.espn.com/general/video/videoAlert?vid=50047819"},"progressiveDownload":{"href":"https://watch.auth.api.espn.com/video/auth/brightcove/fd98890c-ced8-4f7c-af84-12a5acd4d8be/asset?UMADPARAMreferer=https://www.espn.com/video/clip/_/id/50047819/baker-mayfield-visible-pain-thumb-injury"},"source":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/wsc/2026/0927/239cedc5-5807-4514-a553-752bb3c2ed9c/239cedc5-5807-4514-a553-752bb3c2ed9c.mp4"},"streaming":{"href":"https://watch.auth.api.espn.com/video/auth/brightcove/fd98890c-ced8-4f7c-af84-12a5acd4d8be/asset?UMADPARAMreferer=https://www.espn.com/video/clip/_/id/50047819/baker-mayfield-visible-pain-thumb-injury"}},"source":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/wsc/2026/0927/239cedc5-5807-4514-a553-752bb3c2ed9c/239cedc5-5807-4514-a553-752bb3c2ed9c.mp4","HD":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/wsc/2026/0927/239cedc5-5807-4514-a553-752bb3c2ed9c/239cedc5-5807-4514-a553-752bb3c2ed9c.mp4"},"HLS":{"href":"https://cmp-espn.media.dssott.com/opp/hls/espn/wsc/2026/0927/239cedc5-5807-4514-a553-752bb3c2ed9c/239cedc5-5807-4514-a553-752bb3c2ed9c/playlist.m3u8","9x16":{"href":"https://cmp-espn.media.dssott.com/opp/hls/espn/9x16/wsc/2026/0927/239cedc5-5807-4514-a553-752bb3c2ed9c/239cedc5-5807-4514-a553-752bb3c2ed9c/playlist.m3u8"},"HD":{"href":"https://cmp-espn.media.dssott.com/opp/hls/espn/wsc/2026/0927/239cedc5-5807-4514-a553-752bb3c2ed9c/239cedc5-5807-4514-a553-752bb3c2ed9c/playlist.m3u8"},"cmaf":{"href":"https://cmp-espn.media.dssott.com/opp/cmaf/espn/wsc/2026/0927/239cedc5-5807-4514-a55