d709a012","description":"Baker Mayfield","sportId":28,"athleteId":3052587,"athlete":{"id":3052587,"description":"Baker Mayfield","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3052587/baker-mayfield"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3052587/baker-mayfield"}}}}},{"id":2091,"type":"team","uid":"s:20~l:28~t:27","guid":"13e8b157-a75a-ff24-ae91-fa3d52ddf204","description":"Tampa Bay Buccaneers","sportId":28,"teamId":27,"team":{"id":27,"description":"Tampa Bay Buccaneers","abbreviation":"TB","shortDisplayName":"Buccaneers","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/tb/tampa-bay-buccaneers"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/tb/tampa-bay-buccaneers"}}}}},{"id":1920,"type":"team","uid":"s:20~l:28~t:16","guid":"3db556c9-ed76-a7a5-4ccb-a92fc6db4334","description":"Minnesota Vikings","sportId":28,"teamId":16,"team":{"id":16,"description":"Minnesota Vikings","abbreviation":"MIN","shortDisplayName":"Vikings","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/min/minnesota-vikings"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/min/minnesota-vikings"}}}}},{"id":664675,"type":"editorialindicator","guid":"e8acf0b3-14b1-3a2f-813e-54390eff67c3","description":"League Boost"},{"type":"event","uid":"s:20~l:28~e:401872959","guid":"a841cd56-31a5-3217-aaa6-0da50f633c69","description":"Minnesota Vikings @ Tampa Bay Buccaneers","eventId":401872959,"event":{"id":401872959,"sport":"football","league":"nfl","description":"Minnesota Vikings @ Tampa Bay Buccaneers","links":{"mobile":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872959"}},"web":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872959"}}}}}],"ad":{"bundle":"nfl_one_plays","sport":"nfl"},"contributingPartner":"wsc","contributingSystem":"wsc","tracking":{"coverageType":"OnePlay","leagueName":"NFL","program":"espnnfl","sportName":"football","trackingId":"dm_NFL_baker_mayfield_goes_down_holding_his_hand","trackingName":"NFL_One-Play (Baker Mayfield in visible pain with apparent hand injury) 2026/09/27 ESHEET"}}],"related":[{"id":50043224,"dataSourceIdentifier":"0feda34dd05f6","publishedkey":"50043224","type":"Story","headline":"Judging the biggest overreactions to NFL Week 3 games","title":"Judging the biggest overreactions to NFL Week 3 games","linkText":"Let's overreact to NFL Week 3: Brock Purdy is the MVP front-runner? Giants fine with Jameis Winston?","images":[{"dataSourceIdentifier":"0be436de64cd2","id":50047696,"type":"header","name":"Brock Purdy for OVERREACTIONS [608x342]","credit":"Darren Yamashita/Imagn Images","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0927/r1722728_608x342_16-9.jpg"}],"byline":"Dan Graziano","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50043224"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50043224"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50043224"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50043224/week-3-overreactions-2026-graziano"}},"premium":false},{"id":50043408,"dataSourceIdentifier":"25b193fb85aea","publishedkey":"50043408","type":"Story","headline":"NFL Week 3: Takeaways, questions, fantasy spin for Sunday's games","title":"NFL Week 3: Takeaways, questions, fantasy spin for Sunday's games","linkText":"Big wins for the Broncos, Ravens, Jags and Steelers? Our reporters make sense of Week 3","images":[{"dataSourceIdentifier":"00958e9fa811a","id":50048530,"type":"header","name":"SNF: Rams-Broncos photodesk [608x342]","credit":"Brooke Sutton/Getty Images","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0928/r1722776_608x342_16-9.jpg"}],"byline":"NFL Nation","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50043408"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50043408"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50043408"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50043408/week-3-sunday-games-takeaways-questions-2026"}},"premium":false}],"categories":[{"id":409224,"type":"topic","guid":"52313677-19f8-b106-ec91-d8d17e6087fe","description":"news","sportId":0,"topicId":781},{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":2091,"type":"team","uid":"s:20~l:28~t:27","guid":"13e8b157-a75a-ff24-ae91-fa3d52ddf204","description":"Tampa Bay Buccaneers","sportId":28,"teamId":27,"team":{"id":27,"description":"Tampa Bay Buccaneers","abbreviation":"TB","shortDisplayName":"Buccaneers","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/tb/tampa-bay-buccaneers"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/tb/tampa-bay-buccaneers"}}}}},{"id":184532,"type":"athlete","uid":"s:20~l:28~a:3052587","guid":"5bb4376a-d089-e3e4-e49a-44f1d709a012","description":"Baker Mayfield","sportId":28,"athleteId":3052587,"athlete":{"id":3052587,"description":"Baker Mayfield","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3052587/baker-mayfield"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3052587/baker-mayfield"}}}}},{"id":439887,"type":"athlete","uid":"s:20~l:28~a:4430834","guid":"b5e1cc88-9406-358e-986f-e2ea21704108","description":"Jalen McMillan","sportId":28,"athleteId":4430834,"athlete":{"id":4430834,"description":"Jalen McMillan","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4430834/jalen-mcmillan"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4430834/jalen-mcmillan"}}}}},{"id":696398,"type":"contributor","guid":"90a2235c-8428-34c3-8e71-9c16b29ec421","description":"Jenna Laine","slug":"jenna-laine","contributor":{"id":2664,"description":"Jenna Laine"}}],"keywords":["news","NFL","Tampa Bay Buccaneers","Baker Mayfield","Jalen McMillan","Jenna Laine"],"story":"<p>TAMPA, Fla. -- <a data-clubhouse-guid=\"13e8b157-a75a-ff24-ae91-fa3d52ddf204\" href=\"https://www.espn.com/nfl/team/_/name/tb/tampa-bay-buccaneers\">Tampa Bay Buccaneers</a> quarterback <a data-player-guid=\"5bb4376a-d089-e3e4-e49a-44f1d709a012\" href=\"https://www.espn.com/nfl/player/_/id/3052587/baker-mayfield\">Baker Mayfield</a> suffered a dislocated right thumb in his throwing arm in the fourth quarter of Sunday's <a href=\"https://www.espn.com/nfl/boxscore/_/gameId/401872959\" target=\"_blank\">23-16 loss</a> to the <a data-clubhouse-guid=\"3db556c9-ed76-a7a5-4ccb-a92fc6db4334\" href=\"https://www.espn.com/nfl/team/_/name/min/minnesota-vikings\">Minnesota Vikings</a>, coach Todd Bowles said.</p>\n<p>\"He's going to get an MRI [Monday] just to see exactly what inside is wrong with it, so we'll know tomorrow,\" Bowles said, adding that X-rays did not reveal a fracture but that the result is not definitive until further imaging is examined.</p>\n<p>MRIs can show subtle hairline cracks, soft tissue damage and ligament tears that X-rays cannot. A timetable for recovery will be determined after the MRI results.</p>\n<p>Mayfield's injury occurred with 1:54 remaining, when his pass was intercepted by Vikings linebacker <a data-player-guid=\"0178fa5f-003f-ee54-f7f6-a39070ccaf65\" href=\"https://www.espn.com/nfl/player/_/id/3133487/andrew-van-ginkel\">Andrew Van Ginkel</a>. The play happened on fourth-and-13, with Mayfield and the Bucs trying to come back from a 20-16 deficit. He was under duress for several seconds and evaded multiple defenders as he scurried to the right sideline. But as he threw the ball, he was hit by inside linebacker <a data-player-guid=\"74a9d1aa-3d92-c6e8-0d49-d5ad07fa1deb\" href=\"https://www.espn.com/nfl/player/_/id/3728281/blake-cashman\">Blake Cashman</a>.</p>\n<p>\"I thought he was going to go down, but he kept staying alive,\" Cashman said. \"I just tried to get a hit on the quarterback to affect the throw.\"</p>\n<p>Cashman pumped his fist triumphantly and proceeded to join his teammates in celebrating what was likely the game-clinching play, seemingly unaware of what was taking place on the ground. Mayfield remained down, writhing in pain as teammates and the training staff quickly gathered. He did not speak to reporters after the game but he left the locker room with his right hand wrapped in an ice bag.</p>\n<p>\"I was in shock,\" left tackle <a data-player-guid=\"91fe3c7a-d974-44dd-59c0-6f52466976ad\" href=\"https://www.espn.com/nfl/player/_/id/4240589/tristan-wirfs\">Tristan Wirfs</a> said. \"It's tough. He's a competitor. He was trying to make a play at the end of the game. That's who he is. That's who he's always been.\"</p>\n<p><alsosee></p>\n<p>Tight end <a data-player-guid=\"af7a64ab-ab3d-8b06-64c3-c53479c28fec\" href=\"https://www.espn.com/nfl/player/_/id/4243331/cade-otton\">Cade Otton</a> added, \"You just hurt for your brother, your friend.<br>\n<br>\n\"You just see how he fights for his teammates every single play. To be down like that, it sucks.\"</p>\n<p>Buccaneers wide receiver <a data-player-guid=\"b5e1cc88-9406-358e-986f-e2ea21704108\" href=\"https://www.espn.com/nfl/player/_/id/4430834/jalen-mcmillan\">Jalen McMillan</a> will undergo an MRI as well Monday after injuring his left knee, a source told ESPN. The source said it is the same knee he injured in camp. The test will determine the extent of the damage and whether it's an aggravation of the previous issue or a new injury.</p>\n<p>McMillan had just returned to game action last week and was expected to play a much bigger role against Minnesota. But on the Bucs' first possession, Mayfield went to McMillan on third-and-5 and the receiver was hit by Vikings safety <a href=\"https://www.espn.com/nfl/player/_/id/4046537/joshua-metellus\">Josh Metellus</a> while attempting to catch the pass on a corner route. It is unclear whether McMillan suffered the injury while pivoting his body or upon contact. He was able to limp off the field under his own power.</p>\n<p>\"Definitely some adversity for him, and definitely going to say a prayer for him,\" wide receiver <a data-player-guid=\"fcb8cea5-a51b-3b85-93fa-0f934f6e60ef\" href=\"https://www.espn.com/nfl/player/_/id/5220680/ted-hurst\">Ted Hurst III</a> said. \"I just hope he can get back to where he wants to be at and feel like himself again.\"</p>\n<p>Receiver <a data-player-guid=\"20e1bec6-fb6a-9ab1-92e0-c13eff7a7d42\" href=\"https://www.espn.com/nfl/player/_/id/3116165/chris-godwin-jr\">Chris Godwin Jr</a>. said, \"It's definitely -- it's a sad thing, man. You never want to see anybody go down, especially guys that you're close with. I feel for both of those guys as somebody who has been on the other side of that. My prayers are with them. I've checked on both of them and I'm going to continue to do that, continue to support them.\"</p>\n<p>Rookie quarterback <a data-player-guid=\"aaab6e81-bfa6-3ceb-bb91-e9e31a23552b\" href=\"https://www.espn.com/nfl/player/_/id/4596472/jalon-daniels\">Jalon Daniels</a> replaced Mayfield for the Buccaneers' final drive and threw an interception on a last-gasp pass. Bowles said the undrafted free agent out of Kansas, who beat out veteran <a data-player-guid=\"9b5cc348-8b21-7070-a660-a5a7e059b1a5\" href=\"https://www.espn.com/nfl/player/_/id/3886812/jake-browning\">Jake Browning</a> in the preseason, stands to be the team's quarterback going forward if Mayfield cannot play.</p>\n<p>\"Jalon right now,\" Bowles said. \"We haven't really gotten into it yet. We'll see what the MRI says tomorrow and then we'll kind of talk amongst ourselves and kind of see, but right now Jalon would probably go in.\"</p>\n<p>Mayfield's 54 regular-season starts since joining the Buccaneers are tied for most in the league. He has never missed a start in Tampa Bay despite an injury-marred season last year that saw him on the injury report for 10 out of 17 weeks.</p>\n<p>\"We'll see how he feels tomorrow and what can be done. I know he's going to be on top of it tonight, doing everything he can. We'll see what happens,\" Wirfs said of Mayfield, while also praising Daniels.</p>\n<p>\"I know he's going to work as hard as he can to get back for his team,\" Otton said, while acknowledging the reality of being 0-3 for the first time since 2014. \"But yeah, everyone's got to pick up their game for sure.\"</p>\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":false,"allowSearch":true,"byline":"Jenna Laine","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50047972"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50047972"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50047972"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50047972/bucs-qb-baker-mayfield-dislocated-thumb-undergo-mri"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:20Z","status":"success"}