0","description":"Seattle Seahawks","sportId":28,"teamId":26,"team":{"id":26,"description":"Seattle Seahawks","abbreviation":"SEA","shortDisplayName":"Seahawks","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/sea/seattle-seahawks"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/sea/seattle-seahawks"}}}}},{"id":711828,"type":"editorialindicator","guid":"b14f9e1f-2d2c-3b10-b39d-d781f4c4aba7","description":"4 Star Rating"},{"type":"event","uid":"s:20~l:28~e:401872955","guid":"80e20686-e90a-3464-b594-a94eaf23f0dd","description":"Seattle Seahawks @ Washington Commanders","eventId":401872955,"event":{"id":401872955,"sport":"football","league":"nfl","description":"Seattle Seahawks @ Washington Commanders","links":{"mobile":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872955"}},"web":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872955"}}}}}],"ad":{"bundle":"nfl_one_plays","sport":"nfl"},"contributingPartner":"wsc","contributingSystem":"wsc","tracking":{"coverageType":"Final Game Highlight","leagueName":"NFL","program":"espnnfl","sportName":"football","trackingId":"dm_20260927_NFL_seattle_seahawks_vs_washington_commanders_highlights_2026_regular_season","trackingName":"NFL_One-Play (Seattle Seahawks vs. Washington Commanders: Game Highlights) 2026/09/27 ESHEET"}}],"related":[{"id":50051074,"dataSourceIdentifier":"d7081dee4294e","publishedkey":"50051074","type":"HeadlineNews","headline":"Commanders set to re-add Austin Ekeler to RB room, sources say","title":"Commanders set to re-add Austin Ekeler to RB room, sources say","linkText":"Sources: Commanders set for Ekeler reunion, will add veteran to RB room","images":[{"dataSourceIdentifier":"c154ae47bfae3","id":46230308,"type":"header","name":"Austin Ekeler [1296x729]","credit":"Scott Taetsch/Getty Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2025/0912/r1544244_1296x729_16-9.jpg"}],"byline":"John Keim","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50051074"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50051074"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50051074"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50051074/commanders-set-re-add-austin-ekeler-rb-room-sources-say"}},"premium":false}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":1462,"type":"team","uid":"s:20~l:28~t:28","guid":"fbeaf73e-6d6c-cca4-0809-713d9d741f90","description":"Washington Commanders","sportId":28,"teamId":28,"team":{"id":28,"description":"Washington Commanders","abbreviation":"WSH","shortDisplayName":"Commanders","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/wsh/washington-commanders"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/wsh/washington-commanders"}}}}},{"id":529428,"type":"athlete","uid":"s:20~l:28~a:4426901","guid":"72018a55-453a-86f0-f259-b2a6a90ec54f","description":"Leo Chenal","sportId":28,"athleteId":4426901,"athlete":{"id":4426901,"description":"Leo Chenal","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4426901/leo-chenal"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4426901/leo-chenal"}}}}},{"id":409224,"type":"topic","guid":"52313677-19f8-b106-ec91-d8d17e6087fe","description":"news","sportId":0,"topicId":781},{"id":696301,"type":"contributor","guid":"6888b558-4336-3c01-93b4-d2a5fa77172d","description":"John Keim","slug":"john-keim","contributor":{"id":2316,"description":"John Keim"}}],"keywords":["NFL","Washington Commanders","Leo Chenal","news","John Keim"],"story":"<p><a data-clubhouse-guid=\"fbeaf73e-6d6c-cca4-0809-713d9d741f90\" href=\"https://www.espn.com/nfl/team/_/name/wsh/washington-commanders\">Washington Commanders</a> linebacker <a data-player-guid=\"72018a55-453a-86f0-f259-b2a6a90ec54f\" href=\"https://www.espn.com/nfl/player/_/id/4426901/leo-chenal\">Leo Chenal</a>, who was carted off the field during the team's 33-31 upset win over the the <a data-clubhouse-guid=\"3767a23c-a17d-294f-288a-9086ad1f0680\" href=\"https://www.espn.com/nfl/team/_/name/sea/seattle-seahawks\">Seattle Seahawks</a> on Sunday, will undergo season-ending neck surgery, sources confirmed to NFL Network's Ian Rapoport.</p>\n<p>Chenal suffered the injury in the second quarter of Washington's victory. The fifth-year veteran appeared to lead with his head while tackling Seattle's <a data-player-guid=\"c3c5bc25-8a74-30c9-8727-fa80004d4152\" href=\"https://www.espn.com/nfl/player/_/id/4887558/emanuel-wilson\">Emanuel Wilson</a> and immediately went to the ground as medical personnel were quick to run to his side.</p>\n<p>The crowd at Northwest Stadium chanted \"Leo! Leo!\" as Commanders teammates surrounded Chenal, who was taken off on a cart, raising his left hand as he approached the tunnel.</p>\n<p><alsosee></p>\n<p>The Fox broadcast reported later Sunday that Chenal had feeling in all extremities and was taken to a hospital as a precaution.</p>\n<p>NFL reporter Jordan Schultz first reported on Chenal's season-ending surgery Monday.</p>\n<p>Chenal was starting Sunday in place of the injured <a data-player-guid=\"2a6c9a31-1755-da1d-6071-0e3389949107\" href=\"https://www.espn.com/nfl/player/_/id/3127273/frankie-luvu\">Frankie Luvu</a>, who was missing his second consecutive game with a groin injury.</p>\n<p>The Commanders were thin at the position because another inside linebacker, <a data-player-guid=\"e9d91376-3ecd-d61b-53ec-5610f5d219ce\" href=\"https://www.espn.com/nfl/player/_/id/4568617/jordan-magee\">Jordan Magee</a>, was placed on injured reserve after the opener with a hamstring injury.</p>\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":false,"allowSearch":true,"byline":"John Keim","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50051498"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50051498"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50051498"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50051498/sources-leo-chenal-season-ending-neck-surgery"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:20Z","status":"success"}