{"resultsCount":1,"resultsLimit":10,"resultsOffset":0,"headlines":[{"id":50044351,"nowId":"1-50044351","contentKey":"50044351-1-6-1","dataSourceIdentifier":"42a979ce637b7","publishedkey":"50044351","type":"Story","feedDisplayType":"Default","headline":"Where has Bears TE Colston Loveland been this season?","description":"The tight end has one catch and faces a tough Eagles defense on MNF. With no Caleb Williams, can he get going?","title":"Where has Bears TE Colston Loveland been this season?","linkText":"Where has Bears TE Colston Loveland been this season?","categorized":"2026-09-28T13:00:29Z","originallyPosted":"2026-09-28T10:00:00Z","lastModified":"2026-09-28T13:00:28Z","published":"2026-09-28T13:00:28Z","root":"nfl","section":"NFL","source":"ESPN","images":[{"dataSourceIdentifier":"6d707be7c0184","id":50044878,"type":"header","name":"Colston Loveland [1296x1296]","caption":"Colston Loveland broke out in the second half of his rookie season, creating expectations for his second year that have so far gone unmet.","credit":"Ian Johnson/Icon Sportswire","height":1296,"width":1296,"url":"https://a.espncdn.com/photo/2026/0927/r1722568_1296x1296_1-1.jpg"},{"dataSourceIdentifier":"ae91b33a929fa","id":50044916,"type":"header","name":"Colston Loveland  [1296x729]","caption":"Colston Loveland led the Bears in receptions and receiving yards as a rookie, leading him to being the No. 3 TE taken in fantasy drafts this year.","credit":"Ian Johnson/Icon Sportswire","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/0927/r1722573_2_1296x729_16-9.jpg"},{"type":"Media","name":"Caleb Williams is dealing with a Grade 2 hamstring strain","caption":"Ian Rapoport provides an update on Bears QB Caleb Williams' hamstring injury and how much time he could miss.","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/dm_260927_NFL_InstantAnalysis_Bears_IA/dm_260927_NFL_InstantAnalysis_Bears_IA.jpg"}],"video":[{"id":50042986,"dataSourc