":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4239993/tee-higgins"}}}}},{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":17303,"type":"athlete","uid":"s:20~l:28~a:8439","guid":"5fbab03e-2816-55ab-ae10-83b132803d9e","description":"Aaron Rodgers","sportId":28,"athleteId":8439,"athlete":{"id":8439,"description":"Aaron Rodgers","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/8439/aaron-rodgers"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/8439/aaron-rodgers"}}}}},{"id":2776,"type":"team","uid":"s:20~l:28~t:23","guid":"debcd592-8d53-71f1-fc15-5c8b8ef9df6e","description":"Pittsburgh Steelers","sportId":28,"teamId":23,"team":{"id":23,"description":"Pittsburgh Steelers","abbreviation":"PIT","shortDisplayName":"Steelers","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/pit/pittsburgh-steelers"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/pit/pittsburgh-steelers"}}}}},{"id":2664,"type":"team","uid":"s:20~l:28~t:4","guid":"75b8623b-8926-b411-0476-3d3602b78523","description":"Cincinnati Bengals","sportId":28,"teamId":4,"team":{"id":4,"description":"Cincinnati Bengals","abbreviation":"CIN","shortDisplayName":"Bengals","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/cin/cincinnati-bengals"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/cin/cincinnati-bengals"}}}}},{"id":380063,"type":"athlete","uid":"s:20~l:28~a:4047650","guid":"c6727be7-1ac0-315c-437d-e281fe9a2e84","description":"DK Metcalf","sportId":28,"athleteId":4047650,"athlete":{"id":4047650,"description":"DK Metcalf","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4047650/dk-metcalf"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4047650/dk-metcalf"}}}}},{"id":127805,"type":"athlete","uid":"s:20~l:28~a:17372","guid":"8ad36dbe-d0e6-9493-9684-926df627f249","description":"Chris Boswell","sportId":28,"athleteId":17372,"athlete":{"id":17372,"description":"Chris Boswell","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/17372/chris-boswell"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/17372/chris-boswell"}}}}},{"id":435000,"type":"athlete","uid":"s:20~l:28~a:3915511","guid":"e6957db5-5b2e-a82d-c788-d889115d9772","description":"Joe Burrow","sportId":28,"athleteId":3915511,"athlete":{"id":3915511,"description":"Joe Burrow","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3915511/joe-burrow"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3915511/joe-burrow"}}}}},{"id":711821,"type":"editorialindicator","guid":"f3e05446-8d07-3064-a239-c10c32884ea2","description":"SC4U - Full Highlight"},{"id":711824,"type":"editorialindicator","guid":"d348c764-47d9-3e31-bd75-d39dfde52c26","description":"SC4U  - Eligible"},{"type":"event","uid":"s:20~l:28~e:401872950","guid":"f634ae31-eac4-3d02-9f57-ee51001d4485","description":"Cincinnati Bengals @ Pittsburgh Steelers","eventId":401872950,"event":{"id":401872950,"sport":"football","league":"nfl","description":"Cincinnati Bengals @ Pittsburgh Steelers","links":{"mobile":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872950"}},"web":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872950"}}}}}],"ad":{"bundle":"sportscenter","sport":"nfl"},"contributingPartner":"wsc","contributingSystem":"wsc","tracking":{"coverageType":"Final Game Highlight","leagueName":"NFL","program":"espnnfl","sportName":"football","trackingId":"dm_20260927_NFL_cincinnati_bengals_vs_pittsburgh_steelers_game_highlights","trackingName":"COM_NFL Highlight (Cincinnati Bengals vs. Pittsburgh Steelers: Game Highlights) 2026/09/27 ESHEET"}}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":2664,"type":"team","uid":"s:20~l:28~t:4","guid":"75b8623b-8926-b411-0476-3d3602b78523","description":"Cincinnati Bengals","sportId":28,"teamId":4,"team":{"id":4,"description":"Cincinnati Bengals","abbreviation":"CIN","shortDisplayName":"Bengals","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/cin/cincinnati-bengals"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/cin/cincinnati-bengals"}}}}},{"id":435000,"type":"athlete","uid":"s:20~l:28~a:3915511","guid":"e6957db5-5b2e-a82d-c788-d889115d9772","description":"Joe Burrow","sportId":28,"athleteId":3915511,"athlete":{"id":3915511,"description":"Joe Burrow","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3915511/joe-burrow"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3915511/joe-burrow"}}}}},{"id":698667,"type":"contributor","guid":"5ba7177a-701a-3abe-bdcd-f4d70f8c4cb0","description":"Ben Baby","slug":"ben-baby","contributor":{"id":3821,"description":"Ben Baby"}}],"keywords":["NFL","Cincinnati Bengals","Joe Burrow","Ben Baby"],"story":"\n<p>CINCINNATI -- Slightly hunched forward and still mostly in his game attire, <a data-clubhouse-guid=\"75b8623b-8926-b411-0476-3d3602b78523\" href=\"https://www.espn.com/nfl/team/_/name/cin/cincinnati-bengals\">Cincinnati Bengals</a> quarterback <a data-player-guid=\"e6957db5-5b2e-a82d-c788-d889115d9772\" href=\"https://www.espn.com/nfl/player/_/id/3915511/joe-burrow\">Joe Burrow</a> sat and stared at the inside of his locker as he pondered a game that slipped away.</p>\n<p>The <a data-clubhouse-guid=\"debcd592-8d53-71f1-fc15-5c8b8ef9df6e\" href=\"https://www.espn.com/nfl/team/_/name/pit/pittsburgh-steelers\">Pittsburgh Steelers</a> (2-1) halted Cincinnati's strong start to the season with <a href=\"https://www.espn.com/nfl/game/_/gameId/401872950/bengals-steelers\">a 30-27 victory</a> on Sunday at Acrisure Stadium. And as Burrow pondered what went wrong in a game Cincinnati (2-1) came close to winning, the theme of self-inflicted mistakes jumped out more than anything else.</p>\n<p>And as the Week 3 loss showed, those types of errors can be the undoing of a team with championship aspirations.</p>\n<p>\"Like last week with the penalties, we just can't shoot ourselves in the foot like that,\" Burrow said. \"You can't win in this league when you do that. It's really hard. It's really hard. We could have overcome it, but it's hard to win like that.\"</p>\n<p>Cincinnati was looking to start the season with three wins for the first time since Zac Taylor took over as the team's coach in 2019. Against Houston in Week 2, the Bengals won despite being called for 12 penalties.</p>\n<p>One week later, the mistakes by the entire team were too costly.</p>\n<p><photo1></p>\n<p>A Bengals defense that had big moments in the season's first two games surrendered 411 yards to a Pittsburgh squad that failed to score a touchdown a week earlier. Special teams had two major blunders: a roughing-the-kicker penalty that extended a drive culminating in a touchdown and a muffed punt recovered by the Steelers.</p>\n<p>That fumbled punt led to <a data-player-guid=\"8ad36dbe-d0e6-9493-9684-926df627f249\" href=\"https://www.espn.com/nfl/player/_/id/17372/chris-boswell\">Chris Boswell</a>'s 33-yard field goal with 2:15 left that proved to be the winning margin.</p>\n<p>\"We just didn't close it out,\" Taylor said. \"That's all there is to it. We had opportunities in all three phases in the fourth quarter. We didn't get it done.\"</p>\n<p>That includes the offense.</p>\n<p>Following Boswell's field goal, Cincinnati got the ball back and still had two timeouts. The Bengals worked into kicker <a data-player-guid=\"9e956ba3-1a18-c026-647f-79e699d0256f\" href=\"https://www.espn.com/nfl/player/_/id/4360234/evan-mcpherson\">Evan McPherson</a>'s range when disaster struck.</p>\n<p>After Steelers defensive tackle <a data-player-guid=\"dda3e155-2461-3379-8a26-0218bf5962c7\" href=\"https://www.espn.com/nfl/player/_/id/4682980/derrick-harmon\">Derrick Harmon</a> got a quick pressure, Burrow wriggled out of a potential sack and tried to throw the ball away. But Harmon recovered and knocked the ball loose before Burrow could get rid of it, leading to a fumble the Steelers recovered to ice the game.</p>\n<p>\"Trying to take a shot at the end zone,\" Burrow said of his final play. \"Trying not to take the sack, trying to get the ball out. Fumbled it.\"</p>\n<p><inline1></p>\n<p>It unspooled an otherwise sterling day from Cincinnati's star quarterback -- 28-of-37 passing for 282 yards and three touchdowns, including one on fourth down that put Cincinnati ahead 27-24 with 13:29 left.</p>\n<p>And it also uncovered another trend that has been lurking over the years. Dating to the start of the 2024 season, Burrow is tied for the league lead in lost turnovers in the fourth quarter or overtime, per ESPN Research. He has thrown eight interceptions and lost four fumbles in that span.</p>\n<p>When it comes to fixing some of the self-inflicted mistakes, Burrow believes he knows the elixir for Cincinnati's woes.</p>\n<p>\"Guys have to take ownership of their roles, take ownership of themselves and just be smart situational football players,\" Burrow said.</p>\n<p>For a team that doesn't just want to snap a three-year postseason drought but also wants to be a championship contender, Sunday's setback at Acrisure Stadium was nonetheless a little more palatable to swallow than previous disappointments.</p>\n<p>\"It's something that we can control,\" Bengals wide receiver <a data-player-guid=\"f9be91fa-7d8d-811b-6452-b14d1a1feb2c\" href=\"https://www.espn.com/nfl/player/_/id/4362628/jamarr-chase\">Ja'Marr Chase</a> said at his locker after the game. \"It's in our hands, not out of our hands.\"</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Ben Baby","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50048227"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50048227"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50048227"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50048227/joe-burrow-cincinnati-bengals-cant-close-steelers"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:22Z","status":"success"}