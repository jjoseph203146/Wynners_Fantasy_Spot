{"resultsCount":1,"resultsLimit":10,"resultsOffset":0,"headlines":[{"id":50048227,"nowId":"1-50048227","contentKey":"50048227-1-6-1","dataSourceIdentifier":"f20319b9476fa","publishedkey":"50048227","type":"Story","feedDisplayType":"Default","headline":"Joe Burrow, Bengals can't 'close it out' against Steelers","description":"Special teams gaffes and a Burrow fumble late in the fourth sealed Cincinnati's outcome.","title":"Joe Burrow, Bengals can't 'close it out' against Steelers","linkText":"Joe Burrow, Bengals can't 'close it out' against Steelers","categorized":"2026-09-28T10:00:03Z","originallyPosted":"2026-09-28T10:00:00Z","lastModified":"2026-09-28T10:00:02Z","published":"2026-09-28T10:00:02Z","root":"nfl","section":"NFL","source":"ESPN","images":[{"dataSourceIdentifier":"ae376401f503d","id":50048156,"type":"header","name":"Joe Burrow [1296x729]","caption":"Joe Burrow's fumble late in the fourth quarter sealed the Bengals' loss and was one of several mistakes that cost Cincinnati a winnable game.","credit":"Jeff Dean/Getty Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/0928/r1722756_1296x729_16-9.jpg"},{"type":"Media","name":"Cincinnati Bengals vs. Pittsburgh Steelers: Game Highlights","caption":"Cincinnati Bengals vs. Pittsburgh Steelers: Game Highlights","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/wsc/2026/0927/87719e71-c6e4-444b-89bd-e5e245f6d752/87719e71-c6e4-444b-89bd-e5e245f6d752.jpg"}],"video":[{"id":50045555,"dataSourceIdentifier":"b37673c823702","cerebroId":"6ab97e9c4bf4c005207b9a35","pccId":"d2d5053b-6abc-45b9-bd93-4f81aeeb6419","source":"espn","headline":"Cincinnati Bengals vs. Pittsburgh Steelers: Game Highlights","shortHeadline":"Cincinnati Bengals vs. Pittsburgh Steelers: Game Highlights","caption":"Cincinnati Bengals vs. Pittsburgh Steelers: Game Highlights","title":"Cincinnati Bengals vs. Pittsburgh Steelers: Game Highlights","description":"Cincinnati Bengals vs. Pittsburgh Ste