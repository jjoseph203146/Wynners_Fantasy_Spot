m.espn.go.com/nfl/story?storyId=50034932"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50034932/best-plays-moments-touchdowns-more"}},"premium":false}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":409222,"type":"topic","guid":"b66e959d-b64e-9bd6-7d5c-1bcb0d53c0cb","description":"daily","sportId":0,"topicId":779},{"id":12024,"type":"league","uid":"s:20~l:3080","guid":"a472a0eb-d630-3568-bf2a-59572429de6c","description":"Fantasy NFL","sportId":3080,"leagueId":3080,"league":{"id":3080,"description":"Fantasy NFL","abbreviation":"NFLFD"}},{"id":2719,"type":"team","uid":"s:20~l:28~t:5","guid":"539babc5-e5fb-753b-8ae1-c15032a91ef4","description":"Cleveland Browns","sportId":28,"teamId":5,"team":{"id":5,"description":"Cleveland Browns","abbreviation":"CLE","shortDisplayName":"Browns","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/cle/cleveland-browns"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/cle/cleveland-browns"}}}}},{"id":2776,"type":"team","uid":"s:20~l:28~t:23","guid":"debcd592-8d53-71f1-fc15-5c8b8ef9df6e","description":"Pittsburgh Steelers","sportId":28,"teamId":23,"team":{"id":23,"description":"Pittsburgh Steelers","abbreviation":"PIT","shortDisplayName":"Steelers","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/pit/pittsburgh-steelers"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/pit/pittsburgh-steelers"}}}}},{"id":1352,"type":"team","uid":"s:20~l:28~t:19","guid":"378600ea-2397-8364-8399-b7c1606a49a7","description":"New York Giants","sportId":28,"teamId":19,"team":{"id":19,"description":"New York Giants","abbreviation":"NYG","shortDisplayName":"Giants","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/nyg/new-york-giants"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/nyg/new-york-giants"}}}}},{"id":1637,"type":"team","uid":"s:20~l:28~t:25","guid":"985a261f-296c-c95c-32a5-addc4df75001","description":"San Francisco 49ers","sportId":28,"teamId":25,"team":{"id":25,"description":"San Francisco 49ers","abbreviation":"SF","shortDisplayName":"49ers","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/sf/san-francisco-49ers"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/sf/san-francisco-49ers"}}}}},{"id":138755,"type":"athlete","uid":"s:20~l:28~a:2576980","guid":"33be1f4a-d812-75b9-7b7c-5319d2a7113a","description":"Marcus Mariota","sportId":28,"athleteId":2576980,"athlete":{"id":2576980,"description":"Marcus Mariota","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/2576980/marcus-mariota"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/2576980/marcus-mariota"}}}}},{"id":537447,"type":"athlete","uid":"s:20~l:28~a:4701936","guid":"c5e38ead-375e-3df1-8989-1d7b334915a7","description":"Matthew Golden","sportId":28,"athleteId":4701936,"athlete":{"id":4701936,"description":"Matthew Golden","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4701936/matthew-golden"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4701936/matthew-golden"}}}}},{"id":489486,"type":"athlete","uid":"s:20~l:28~a:4595348","guid":"44a2174b-1d11-3acf-8e75-fe0c13db47a6","description":"Malik Nabers","sportId":28,"athleteId":4595348,"athlete":{"id":4595348,"description":"Malik Nabers","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4595348/malik-nabers"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4595348/malik-nabers"}}}}},{"id":529999,"type":"athlete","uid":"s:20~l:28~a:4361050","guid":"b36df804-8242-754d-43b1-9dec06fafcaf","description":"Isaiah Likely","sportId":28,"athleteId":4361050,"athlete":{"id":4361050,"description":"Isaiah Likely","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4361050/isaiah-likely"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4361050/isaiah-likely"}}}}},{"id":443040,"type":"athlete","uid":"s:20~l:28~a:4429205","guid":"7e13f346-0248-31d6-a4e7-8467003d0f8b","description":"Jordan Addison","sportId":28,"athleteId":4429205,"athlete":{"id":4429205,"description":"Jordan Addison","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4429205/jordan-addison"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4429205/jordan-addison"}}}}},{"id":537897,"type":"athlete","uid":"s:20~l:28~a:4685512","guid":"705bfe8e-8678-32bc-a5b8-535fcca2e1cd","description":"Jadarian Price","sportId":28,"athleteId":4685512,"athlete":{"id":4685512,"description":"Jadarian Price","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4685512/jadarian-price"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4685512/jadarian-price"}}}}},{"id":2553,"type":"team","uid":"s:20~l:28~t:13","guid":"b18540eb-6f2b-534c-e7f9-9bd930518da9","description":"Las Vegas Raiders","sportId":28,"teamId":13,"team":{"id":13,"description":"Las Vegas Raiders","abbreviation":"LV","shortDisplayName":"Raiders","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/lv/las-vegas-raiders"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/lv/las-vegas-raiders"}}}}}],"keywords":["NFL","daily","Fantasy NFL","Cleveland Browns","Pittsburgh Steelers","New York Giants","San Francisco 49ers","Marcus Mariota","Matthew Golden","Malik Nabers","Isaiah Likely","Jordan Addison","Jadarian Price","Las Vegas Raiders"],"story":"<p><video1></p>\n<p>So we're through three weeks of the NFL season, and we don't know anything. And that's <em>not</em> an overreaction.</p>\n<p>What in the name of John Madden happened on Sunday afternoon? The Seahawks <a href=\"https://www.espn.com/nfl/game/_/gameId/401872955/seahawks-commanders\">gave up 33 points</a> and lost to the <a data-player-guid=\"33be1f4a-d812-75b9-7b7c-5319d2a7113a\" href=\"http://www.espn.com/nfl/player/_/id/2576980/marcus-mariota\" target=\"_new\">Marcus Mariota</a>-led Commanders? The Bills turned the ball over five times and <a href=\"https://www.espn.com/nfl/game/_/gameId/401872953/chargers-bills\">still won</a>? The stuck-in-the-mud Steelers rolled up 411 yards of offense <a href=\"https://www.espn.com/nfl/game/_/gameId/401872950/bengals-steelers\">to beat</a> the red-hot, revamped Bengals defense? The Browns <a href=\"https://www.espn.com/nfl/game/_/gameId/401872949/panthers-browns\">improved to 2-1</a>?</p>\n<p>Just when you think you can start to make sense of this season, you check the standings and wonder what's up with the 0-3 Chargers, 0-3 Texans, 1-2 Patriots, 2-1 Giants and the entire NFC West.</p>\n<p>It's a reminder that it's <em>still</em> too early to draw any real conclusions about how this season is going to go and that so much of what we think we know is actually an overreaction. Which is the fun part, after all, right?</p>\n<p>It's our Week 3 overreactions column, where we look at five potential takeaways and judge them as legitimate stances or irrational overreactions. Plus, we hit a few fantasy football overreactions at the bottom.</p>\n<p><a name=\"purdy\"></a></p>\n<center>\n<p align=\"center\"><strong>Jump to:</strong><br>\n<a href=\"https://www.espn.com/nfl/story/_/id/50043224/week-3-overreactions-2026-graziano#purdy\">Purdy is the next NFL MVP?</a><br>\n<a href=\"https://www.espn.com/nfl/story/_/id/50043224/week-3-overreactions-2026-graziano#giants\">Giants are just fine with Jameis at QB?</a><br>\n<a href=\"https://www.espn.com/nfl/story/_/id/50043224/week-3-overreactions-2026-graziano#steelers\">The Steelers will avoid a losing season again?</a><br>\n<a href=\"https://www.espn.com/nfl/story/_/id/50043224/week-3-overreactions-2026-graziano#browns\">Todd Monken will be Coach of the Year?</a><br>\n<a href=\"http://Overreacting to NFL Week 3: Todd Monken will be the NFL coach of the year#raiders\">Mendoza isn't playing anytime soon?</a><br>\n<a href=\"https://www.espn.com/nfl/story/_/id/50043224/week-3-overreactions-2026-graziano#fantasy\">Fantasy overreactions</a></p>\n</center>\n<p><img src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></p>\n\n\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/sf.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></h2>\n<h2><a data-player-guid=\"d2e39a38-732d-5a24-f242-a4f9de87dabe\" href=\"http://www.espn.com/nfl/player/_/id/4361741/brock-purdy\" target=\"_new\">Brock Purdy</a> should be the MVP favorite right now</h2>\n<p>Has any quarterback in the league been more efficient through the first three weeks? Purdy has completed 72.3% of his passes for an average of 263 passing yards per game. He has thrown for nine touchdowns and one interception. He has rushed for 93 yards and a touchdown on 10 carries. The 49ers are bleeding wide receivers due to injury, and Purdy is just out there dicing up defenses like it's nothing.</p>\n<p><alsosee></p>\n<p>His team is 3-0 with two division wins, including that opener in Australia against everybody's offseason darlings, the Rams. The last pick in the 2022 draft has turned into one of the best quarterbacks in the NFL, and right now it's hard to find anyone playing the position any better.</p>\n<p><b>Verdict: NOT AN OVERREACTION</b></p>\n<p>Oh, there are other candidates. <a data-player-guid=\"7d76fbb1-1c5e-d9f4-954f-cad43f720ae2\" href=\"http://www.espn.com/nfl/player/_/id/3916387/lamar-jackson\" target=\"_new\">Lamar Jackson</a> just finished doing his thing in Rio. <a data-player-guid=\"37d87523-280a-9d4a-0adb-22cfc6d3619c\" href=\"http://www.espn.com/nfl/player/_/id/3139477/patrick-mahomes\" target=\"_new\">Patrick Mahomes</a> will surely be in the conversation if the Chiefs keep it up. <a data-player-guid=\"237b9f2a-4701-8fc3-60eb-250978af9893\" href=\"http://www.espn.com/nfl/player/_/id/3918298/josh-allen\" target=\"_new\">Josh Allen</a> is also there, but he had a rough one Sunday despite Buffalo's win. <a data-player-guid=\"76111495-d1d9-2333-170d-4206eebe673f\" href=\"http://www.espn.com/nfl/player/_/id/4360310/trevor-lawrence\" target=\"_new\">Trevor Lawrence</a> has been awesome in two out of three games. But no one makes a stronger case right now than Purdy, who just tied Steve Young's 49ers team record for most touchdown passes in the first three games of a season. The Niners haven't scored this many points in their first three games since 1998, which was the year Young did that. And he had Jerry Rice!</p>\n<p><a name=\"giants\"></a></p>\n\n\n<hr>\n\n\n\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/nyg.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></h2>\n<h2>The Giants are going to be <em>fine</em> with <a data-player-guid=\"57af2581-cec9-d5a3-2afe-7a719925f78b\" href=\"http://www.espn.com/nfl/player/_/id/2969939/jameis-winston\" target=\"_new\">Jameis Winston</a> at quarterback</h2>\n<p>One of the bummer developments this past week was the Giants losing quarterback <a data-player-guid=\"13e97d3e-2171-371b-9a7a-2c44670b5a62\" href=\"http://www.espn.com/nfl/player/_/id/4689114/jaxson-dart\" target=\"_new\">Jaxson Dart</a> to a <a href=\"https://www.espn.com/nfl/story/_/id/50013861/sources-jaxson-dart-season-ending-knee-surgery\">season-ending injury</a>. After Winston's dreadful performance in relief during <a href=\"https://www.espn.com/nfl/game/_/gameId/401872956/titans-giants\">Monday night's loss</a> to the Rams, the Giants spent a good part of last week <a href=\"https://www.espn.com/nfl/story/_/id/50037942/giants-set-gameplan-jameis-winston-mull-options-add-qb\">discussing potential outside options</a> while preparing Winston to start. He started Sunday and helped beat the woeful Titans in an <a href=\"https://www.espn.com/nfl/game/_/gameId/401872956/titans-giants\">ugly 12-7 slopfest</a>.</p>\n<p>He did not light up the stat sheet, but he also didn't turn the ball over, which is always a massive win with Winston. And considering the game took place during the tail end of a rainy, windy nor'easter, it would have been tough for Dart or anyone else to look much better in those conditions. Winston and the Giants needed to come out of Sunday with any type of win, and they accomplished that. They're 2-1 through three games, which isn't a bad place to be.</p>\n<p><b>Verdict: OVERREACTION</b></p>\n<p>I don't think you can draw many conclusions from what we saw Sunday. The Giants ran the ball fine, which they'll have to continue to do, but the run game won't be as dynamic without the threat of Dart's legs. Winston has been in the league for 12 seasons now. There is no mystery about the type of player he is. He'll have one or two brilliant games followed by classic postgame on-field interviews. He'll have games where he throws the ball to the other team all day.</p>\n<p><a name=\"steelers\"></a></p>\n<p>He has settled into a role as an excellent backup and mentor, but those guys aren't supposed to give you 15 games. They're supposed to get you through three or four until the starter comes back. Winning on Sunday shouldn't change whatever the Giants are doing to find another QB option, and I don't believe it will.</p>\n\n\n<hr>\n\n\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/pit.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></h2>\n<h2>The Steelers' streak of .500-or-better seasons will continue</h2>\n<p>Pittsburgh hasn't had a losing season since 2003. That's a stunning 22-year streak that comprises the final three seasons of Bill Cowher's head coaching tenure and Mike Tomlin's entire 19-year run. The decision to <a href=\"https://www.espn.com/nfl/story/_/id/47715749/sources-steelers-planning-hire-mike-mccarthy-head-coach\">hire Mike McCarthy as coach</a> and <a href=\"https://www.espn.com/nfl/story/_/id/47715749/sources-steelers-planning-hire-mike-mccarthy-head-coach\">bring back</a> 42-year-old <a data-player-guid=\"5fbab03e-2816-55ab-ae10-83b132803d9e\" href=\"http://www.espn.com/nfl/player/_/id/8439/aaron-rodgers\" target=\"_new\">Aaron Rodgers</a> at quarterback this season led many (including myself!) to wonder whether 2026 would be the end of that streak and if the run was truly a product of Tomlin magic. A lackluster performance in the Steelers' <a href=\"https://www.espn.com/nfl/game/_/gameId/401872658/falcons-steelers\">Week 1 victory</a> over the Falcons and a complete dud in <a href=\"https://www.espn.com/nfl/game/_/gameId/401872946/steelers-patriots\">Week 2</a> against the Patriots backed up that suspicion, and the Steelers were home underdogs Sunday to the division rival Bengals, who were 2-0 and flying as high as any team in the league entering Week 3.</p>\n<p>But a funny thing happened. The Steelers spent the week working on fixing their run game. They had meetings where the offensive linemen and the running backs hashed out why they weren't seeing plays the same way. They switched out the starting offensive linemen on the right side. They came out aggressively and scored touchdowns on their first two drives. <a data-player-guid=\"224e4c1e-625d-b1b2-b8ea-1316942fa7ac\" href=\"http://www.espn.com/nfl/player/_/id/4569987/jaylen-warren\" target=\"_new\">Jaylen Warren</a> had 127 rushing yards on 17 carries. Pittsburgh was opportunistic, turning two Bengals punt misplays into 10 second-half points. And the Steelers won a classic, topsy-turvy AFC North game <a href=\"https://www.espn.com/nfl/game/_/gameId/401872950/bengals-steelers\">30-27</a> to improve to 2-1.</p>\n<p><video2></p>\n<p><b>Verdict: NOT AN OVERREACTION</b></p>\n<p>I mean, McCarthy's coaching résumé tells us a winning season is more likely than not. And while Rodgers isn't the player he used to be, he fits the Steelers' opportunistic mindset. Just ask the Falcons and Bengals what happens if you give Pittsburgh a chance to beat you. The <a href=\"https://www.espn.com/nfl/team/schedule/_/name/pit/pittsburgh-steelers\">schedule looks daunting</a>, and not just because of the division the Steelers play in. They still have road games in Cleveland (<a href=\"https://www.espn.com/nfl/game/_/gameId/401872964/steelers-browns\">on Thursday</a>), Tampa, Cincinnati, Philadelphia, Jacksonville and Baltimore; home games against the Browns, Ravens and Broncos; and a game against the Saints in Paris.</p>\n<p><a name=\"browns\"></a></p>\n<p>But they also have two wins in their pocket that they kind of had no business picking up, they'll probably continue to get better on offense, and they still look like the type of team that can keep games close before stealing them in the end. That's a pretty good recipe for winning more games than you lose.</p>\n\n\n<hr>\n\n\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/cle.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></h2>\n<h2>Todd Monken will win Coach of the Year</h2>\n<p>The Browns <a href=\"https://www.espn.com/nfl/game/_/gameId/401872949/panthers-browns\">beat the Panthers</a> on Sunday to improve to 2-1. They did so behind another spectacularly average performance by <a data-player-guid=\"b6ec8e9e-3d85-a1de-9d0a-5a51621a9c20\" href=\"http://www.espn.com/nfl/player/_/id/3122840/deshaun-watson\" target=\"_new\">Deshaun Watson</a>, who is Cleveland's starting quarterback because, quite frankly, it is stuck with him. The Browns were outgained by more than 100 yards, making them 3-for-3 in games in which they gained fewer yards than their opponents. Their leading receiver, tight end <a data-player-guid=\"32593c89-2e72-352a-a204-a2e034ca9a81\" href=\"http://www.espn.com/nfl/player/_/id/5083076/harold-fannin-jr\" target=\"_new\">Harold Fannin Jr</a>., had 51 yards. Their leading rusher, <a data-player-guid=\"d5a1025a-0474-3cc4-90d2-99ebf41df879\" href=\"http://www.espn.com/nfl/player/_/id/4685702/quinshon-judkins\" target=\"_new\">Quinshon Judkins</a>, had 70.</p>\n<p>Cleveland is starting two rookie wide receivers, a second-year tight end and a second-year running back around a quarterback who hasn't been good since 2020. It has a stellar defense, despite <a href=\"https://www.espn.com/nfl/story/_/id/48939456/sources-browns-rams-finalizing-myles-garrett-blockbuster-trade\">trading away</a> the reigning Defensive Player of the Year, due to outstanding drafting and development on that side of the ball. And if the Browns beat the Steelers on <a href=\"https://www.espn.com/nfl/game/_/gameId/401872964/steelers-browns\">Thursday night</a>, they will be 3-1 and in first place in their division.</p>\n<p><inline1></p>\n<p><b>Verdict: NOT AN OVERREACTION</b></p>\n<p>You do not have to sanction the Browns' insistence on starting Watson to appreciate the job Monken is doing in his first season as a head coach. If anything, being saddled with that wreck of a quarterback situation and managing to go 2-1 in September is a feather in his cap. For much of training camp and the preseason, Monken was insisting things about his offense and his quarterbacks in news conferences that didn't make a lot of sense to those of us who aren't there every day. But it seems clear that he's making sense inside the building.</p>\n<p>He seems to have control of a situation that so many of his predecessors have not been able to control. It feels as if Monken is setting the right tone for the players and getting the most out of what he has so far. It isn't pretty, but it would be hard to be pretty with what Monken has to work with. <em>So far,</em> this is a guy making the most of a long-awaited chance at his dream job, and he appears to be in command on a level that is surprising to most. If the Browns finish with a winning record and make the playoffs, I can't see how the coach of the year race is even close.</p>\n\n\n<hr>\n\n\n\n<h2><img alt=\"\" class=\"floatleft\" src=\"http://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/lv.png?w=110&h=110&transparent=true\" style=\"font-size: 12px;\" width=\"31\"></h2>\n<h2><a data-player-guid=\"2d69f2b3-fc07-332b-bd84-8793a3a1b74a\" href=\"http://www.espn.com/nfl/player/_/id/4837248/fernando-mendoza\" target=\"_new\">Fernando Mendoza</a> won't start for the Raiders until 2027</h2>\n<p>The Raiders are 3-0! The Raiders! This was <em>not</em> supposed to be a good team. <a data-player-guid=\"53bec012-c2ed-bc7c-a8d5-438611f9faa1\" href=\"http://www.espn.com/nfl/player/_/id/14880/kirk-cousins\" target=\"_new\">Kirk Cousins</a> was supposed to be keeping the seat warm for the No. 1 pick until the team got itself in decent enough shape to help Mendoza be great. But so far ... the Raiders look like they're in pretty good shape.</p>\n<p>Cousins led them to a <a href=\"https://www.espn.com/nfl/game/_/gameId/401872961/raiders-saints\">victory over the Saints</a> in New Orleans on Sunday and has matched Purdy with nine touchdown passes in the first three games. The offensive line looks better than expected. Some young guys on defense are making plays. And Sunday was the first time all season the Raiders have had their best offensive player, tight end <a data-player-guid=\"bc4ba7ee-446b-36fd-9985-7fd2a94a98bc\" href=\"http://www.espn.com/nfl/player/_/id/4432665/brock-bowers\" target=\"_new\">Brock Bowers</a>. They could get even better! Why mess with what's working?</p>\n<inline2>\n<p><b>Verdict: OVERREACTION</b></p>\n<p>This is a really fun story, but are you banking on it lasting? The Raiders' next four opponents are the Chiefs, Patriots, Bills and Rams. Las Vegas might turn out to be one of this season's surprise teams, and the future certainly looks bright around Mendoza whenever he does get in there. But no one really expects him to sit for the whole year unless the Raiders just keep winning and stay in first place. And that's going to be a lot tougher than what they've accomplished so far.</p>\n<p>We'll see Mendoza at some point this season. It just won't be as soon as most people imagined it would be. Good on Cousins, Klint Kubiak and the whole Raiders organization for that.</p>\n\n\n<p><a name=\"fantasy\"></a></p>\n<p><img src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://g.espncdn.com/lm-static/ffl/images/ffl-shield-icon-500.png?w=110&h=110&transparent=true\" width=\"31\"></p>\n<h2>Quick-hitter fantasy overreactions</h2>\n<ul>\n<li><a data-player-guid=\"c5e38ead-375e-3df1-8989-1d7b334915a7\" href=\"http://www.espn.com/nfl/player/_/id/4701936/matthew-golden\" target=\"_new\">Matthew Golden</a> needs to be in your lineup every week. <b>NOT AN OVERREACTION.</b> I'm a <a data-player-guid=\"8f25b6b0-99c7-1923-dc47-13b3135ba608\" href=\"http://www.espn.com/nfl/player/_/id/4248528/christian-watson\" target=\"_new\">Christian Watson</a> truther, and obviously he needs to be in your lineup every week, too. But Golden looks like at least a strong 1B to Watson's 1A right now. And what are the Packers going to do? Run the ball?</li>\n<li>Marcus Mariota is a viable streaming QB with <a data-player-guid=\"f03f3238-b035-6f0e-5844-1529ca021c3a\" href=\"http://www.espn.com/nfl/player/_/id/4426348/jayden-daniels\" target=\"_new\">Jayden Daniels</a> out. <b>NOT AN OVERREACTION.</b> Why not? Washington faces a less-than-scary Colts defense <a href=\"https://www.espn.com/nfl/game/_/gameId/401872965/colts-commanders\">next week</a>. The Giants <a href=\"https://www.espn.com/nfl/game/_/gameId/401872988/giants-commanders\">after that</a>? Meh. The 49ers <a href=\"https://www.espn.com/nfl/game/_/gameId/401873008/commanders-49ers\">in Week 6</a> with maybe no <a data-player-guid=\"6a5ec871-ae65-1fde-4664-f513284ad1ba\" href=\"http://www.espn.com/nfl/player/_/id/4040605/nick-bosa\" target=\"_new\">Nick Bosa</a>? That's not that daunting. But even if the matchups looked tough, Mariota just threw three touchdown passes <a href=\"https://www.espn.com/nfl/game/_/gameId/401872955/seahawks-commanders\">against the Seahawks</a>! Mariota can run this offense and get the ball to <a data-player-guid=\"04454e17-9294-6271-f951-c0339528e97e\" href=\"http://www.espn.com/nfl/player/_/id/3121422/terry-mclaurin\" target=\"_new\">Terry McLaurin</a>. You could do worse.</li>\n</ul>\n<video3>\n<ul>\n<li><a data-player-guid=\"b36df804-8242-754d-43b1-9dec06fafcaf\" href=\"http://www.espn.com/nfl/player/_/id/4361050/isaiah-likely\" target=\"_new\">Isaiah Likely</a> and <a data-player-guid=\"44a2174b-1d11-3acf-8e75-fe0c13db47a6\" href=\"http://www.espn.com/nfl/player/_/id/4595348/malik-nabers\" target=\"_new\">Malik Nabers</a> need to be on the bench with Jaxson Dart out. <b>OVERREACTION</b>. They're still super talented players who are a big part of the Giants' plans, and Jameis Winston has supported fantasy-viable receiving options throughout his career. <a href=\"https://www.espn.com/nfl/game/_/gameId/401872956/titans-giants\">Sunday's game</a> was a rainy mess. Don't let it deter you.</li>\n<li>You can drop <a data-player-guid=\"705bfe8e-8678-32bc-a5b8-535fcca2e1cd\" href=\"http://www.espn.com/nfl/player/_/id/4685512/jadarian-price\" target=\"_new\">Jadarian Price</a> like he keeps dropping the ball. <b>OVERREACTION</b>. Price was the Seahawks' first-round pick, and <a data-player-guid=\"8d2ff97a-8928-1aaa-d9cc-20f06a9b546a\" href=\"http://www.espn.com/nfl/player/_/id/4426385/zach-charbonnet\" target=\"_new\">Zach Charbonnet</a> will remain out for a while. Seattle might not fully trust Price yet, and you might want to keep him on your bench, but don't drop him. Trade him to me!</li>\n<li><a data-player-guid=\"7e13f346-0248-31d6-a4e7-8467003d0f8b\" href=\"http://www.espn.com/nfl/player/_/id/4429205/jordan-addison\" target=\"_new\">Jordan Addison</a> is a WR1 if <a data-player-guid=\"c7fb1996-2530-7f98-9f2f-572debf989f4\" href=\"http://www.espn.com/nfl/player/_/id/4262921/justin-jefferson\" target=\"_new\">Justin Jefferson</a> <a href=\"http://espn.com/nfl/story/_/id/50046851/vikings-rule-justin-jefferson-ankle-injury\">misses time</a>. <b>NOT AN OVERREACTION</b>. Addison will be a WR2 on his most pedestrian days, and his big-play ability can vault him to WR1 status at any minute. He is the classic \"it only takes one play\" fantasy asset.</li>\n</ul>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Dan Graziano","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50043224"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50043224"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50043224"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50043224/week-3-overreactions-2026-graziano"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:21Z","status":"success"}