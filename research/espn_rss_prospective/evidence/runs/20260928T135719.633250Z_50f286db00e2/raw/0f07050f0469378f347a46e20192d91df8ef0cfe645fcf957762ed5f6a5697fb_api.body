tps://a.espncdn.com/photo/2026/0927/r1722712_2_608x342_16-9.jpg"}],"byline":"Ben Solak","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50043815"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50043815"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50043815"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50043815/week-3-key-stats-numbers-solak"}},"premium":false},{"id":50043408,"dataSourceIdentifier":"25b193fb85aea","publishedkey":"50043408","type":"Story","headline":"NFL Week 3: Takeaways, questions, fantasy spin for Sunday's games","title":"NFL Week 3: Takeaways, questions, fantasy spin for Sunday's games","linkText":"Big wins for the Broncos, Ravens, Jags and Steelers? Our reporters make sense of Week 3","images":[{"dataSourceIdentifier":"00958e9fa811a","id":50048530,"type":"header","name":"SNF: Rams-Broncos photodesk [608x342]","credit":"Brooke Sutton/Getty Images","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0928/r1722776_608x342_16-9.jpg"}],"byline":"NFL Nation","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50043408"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50043408"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50043408"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50043408/week-3-sunday-games-takeaways-questions-2026"}},"premium":false},{"id":50034932,"dataSourceIdentifier":"b322fabd720bf","publishedkey":"50034932","type":"Story","headline":"Week 3 NFL highlights: Best plays, moments, touchdowns, more","title":"Week 3 NFL highlights: Best plays, moments, touchdowns, more","linkText":"Week 3 NFL highlights: Broncos rally late in win; Ravens walk it off in Rio","source":"ESPN","images":[{"dataSourceIdentifier":"6c6fad4dd4db8","id":50049651,"type":"header","name":"Talanoa Hufanga [608x342]","credit":"Brooke Sutton/Getty Images","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0928/r1722834_608x342_16-9.jpg"}],"byline":"NFL Nation","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50034932"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50034932"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50034932"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50034932/best-plays-moments-touchdowns-more"}},"premium":false}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":409222,"type":"topic","guid":"b66e959d-b64e-9bd6-7d5c-1bcb0d53c0cb","description":"daily","sportId":0,"topicId":779},{"id":1693,"type":"team","uid":"s:20~l:28~t:26","guid":"3767a23c-a17d-294f-288a-9086ad1f0680","description":"Seattle Seahawks","sportId":28,"teamId":26,"team":{"id":26,"description":"Seattle Seahawks","abbreviation":"SEA","shortDisplayName":"Seahawks","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/sea/seattle-seahawks"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/sea/seattle-seahawks"}}}}},{"id":2321,"type":"team","uid":"s:20~l:28~t:17","guid":"0078f353-fe3e-67ed-a42c-43cca0568e21","description":"New England Patriots","sportId":28,"teamId":17,"team":{"id":17,"description":"New England Patriots","abbreviation":"NE","shortDisplayName":"Patriots","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ne/new-england-patriots"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ne/new-england-patriots"}}}}},{"id":2146,"type":"team","uid":"s:20~l:28~t:29","guid":"647c27bf-ab86-550e-5b83-91c29e73e4a9","description":"Carolina Panthers","sportId":28,"teamId":29,"team":{"id":29,"description":"Carolina Panthers","abbreviation":"CAR","shortDisplayName":"Panthers","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/car/carolina-panthers"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/car/carolina-panthers"}}}}},{"id":2610,"type":"team","uid":"s:20~l:28~t:24","guid":"84caf62b-c753-71ea-a787-44fd224a4294","description":"Los Angeles Chargers","sportId":28,"teamId":24,"team":{"id":24,"description":"Los Angeles Chargers","abbreviation":"LAC","shortDisplayName":"Chargers","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/lac/los-angeles-chargers"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/lac/los-angeles-chargers"}}}}},{"id":3053,"type":"team","uid":"s:20~l:28~t:34","guid":"595690b3-2161-4913-a7a7-814af2fd2621","description":"Houston Texans","sportId":28,"teamId":34,"team":{"id":34,"description":"Houston Texans","abbreviation":"HOU","shortDisplayName":"Texans","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/hou/houston-texans"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/hou/houston-texans"}}}}},{"id":696435,"type":"contributor","guid":"d7111a42-f0b0-3fc0-85a3-6d0e3b308fe1","description":"Bill Barnwell","slug":"bill-barnwell","contributor":{"id":1988,"description":"Bill Barnwell"}}],"keywords":["NFL","daily","Seattle Seahawks","New England Patriots","Carolina Panthers","Los Angeles Chargers","Houston Texans","Bill Barnwell"],"story":"<p><video1></p>\n<p>For the second time in three weeks, the opening window of the Sunday afternoon slate of <a href=\"https://www.espn.com/nfl/schedule\">NFL games</a> delivered a delicious bowl of chaos. While Week 1 served up a record number of points, <a href=\"https://www.espn.com/nfl/scoreboard\">Week 3</a> brought upsets and heartbreaking defeats for teams that had lofty expectations heading into this season. Five teams that made the playoffs in 2025 lost games in crushing fashion.</p>\n<p>Three of which -- the Chargers, Panthers and Texans -- held leads in the fourth quarter but couldn't hold them. A fourth -- the defending Super Bowl champ Seahawks -- lost to an 0-2 Commanders team that was down to its backup quarterback. And a fifth -- the defending AFC champ Patriots -- were blown out and appear to have secretly replaced their MVP candidate QB from a year ago with a startled, overwhelmed facsimile of <a data-player-guid=\"2fbd2f9e-624d-3e63-9bb5-9bb965782b68\" href=\"https://www.espn.com/nfl/player/_/id/4431452/drake-maye\">Drake Maye</a>. (The Rams also blew a 16-0 lead to the Broncos on <a href=\"http://www.espn.com/nfl/game/_/gameId/401872962/rams-broncos\">Sunday night</a>, but that was a narrow loss on the road to a team that also made last season's playoffs.)</p>\n<center>\n<p align=\"center\"><strong><em>Subscribe: <a href=\"http://www.espn.com/espnradio/podcast/archive?id=15230808\">'The Bill Barnwell Show'</a></em></strong></p>\n</center>\n<p>Today, I'm going to break down those five losses from teams that expected to be winning most of their games this season. Which defeat was most painful? Which raised the biggest questions about what happens next? I'll go from most crushing to least ominous, starting in Duval County, where the Jaguars (another 2025 playoff team) had no trouble stomping all over the Patriots.</p>\n<p><a name=\"ne\"></a></p>\n<center>\n<p align=\"center\"><strong>Jump to:</strong><br>\n<a href=\"https://www.espn.com/nfl/story/_/id/50043253/week-3-losses-seahawks-patriots-texans-chargers-panthers#lac\">Chargers</a> | <a href=\"http://www.espn.com/nfl/story/_/id/50043253/week-3-losses-seahawks-patriots-texans-chargers-panthers#car\">Panthers</a> | <a href=\"http://www.espn.com/nfl/story/_/id/50043253/week-3-losses-seahawks-patriots-texans-chargers-panthers#ne\">Patriots</a><br>\n<a href=\"http://www.espn.com/nfl/story/_/id/50043253/week-3-losses-seahawks-patriots-texans-chargers-panthers#sea\">Seahawks</a> | <a href=\"http://www.espn.com/nfl/story/_/id/50043253/week-3-losses-seahawks-patriots-texans-chargers-panthers#hou\">Texans</a></p>\n</center>\n<p><img src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/ne.png&h=110&w=110\" width=\"31\"></p>\n<h2><a data-clubhouse-guid=\"0078f353-fe3e-67ed-a42c-43cca0568e21\" href=\"https://www.espn.com/nfl/team/_/name/ne/new-england-patriots\">New England Patriots</a></h2>\n<p><strong><a href=\"https://www.espn.com/nfl/game/_/gameId/401872957/patriots-jaguars\">Lost 35-6 to the Jaguars</a></strong></p>\n<p>On one hand, there's nothing unrealistic or shocking about the Patriots losing to the Jaguars in Jacksonville. On the other, unlike the other four games I'll talk about here, this loss wasn't particularly close. While Mike Vrabel & Co. might feel like they played better than the final score indicated and lost 10 points on sloppy play in the red zone and a missed field goal, the Patriots aren't building on what they put together in 2025. They look like they've gone back in time to the first half of the 2024 season, when Drake Maye was a rookie, Vrabel was out of football and a half-dozen dismal plays per game typically doomed them to losses.</p>\n<p><alsosee></p>\n<p>Since <a data-player-guid=\"53cf1afe-22f9-ea1f-7d9b-a992d25c8ac5\" href=\"https://www.espn.com/nfl/player/_/id/4047646/aj-brown\">A.J. Brown</a> went <a href=\"https://www.espn.com/nfl/story/_/id/49905144/sources-patriots-aj-brown-go-ir-miss-least-4-games\">down</a> in the second half of the Week 1 <a href=\"https://www.espn.com/nfl/game/_/gameId/401872656/patriots-seahawks\">loss to the Seahawks</a>, the Patriots have looked like a completely different offense. Maye was playing well in that game, continuously taking checkdowns and small profits. With Seattle quarterback <a data-player-guid=\"0b8ae860-a909-6cdb-db2d-8e3fe1b28d83\" href=\"https://www.espn.com/nfl/player/_/id/3924327/drew-lock\">Drew Lock</a> being summoned to play on short notice with <a data-player-guid=\"938f19a1-ef9b-618c-2365-d55291e0fcc6\" href=\"https://www.espn.com/nfl/player/_/id/3912547/sam-darnold\">Sam Darnold</a>'s early injury and the Seahawks struggling to score, that would have been a logical way for the Patriots to try to win.</p>\n<p>Instead, Maye threw three interceptions to turn that game, all on throws he never should have considered making. He was better <a href=\"https://www.espn.com/nfl/game/_/gameId/401872946/steelers-patriots\">against the Steelers</a> in Week 2 but badly underthrew a pass to <a data-player-guid=\"8822527a-d2cf-e259-fbf1-8989fdec740c\" href=\"https://www.espn.com/nfl/player/_/id/4242207/patrick-queen\">Patrick Queen</a> on a crosser for an interception, one play after he had escaped pressure and found <a data-player-guid=\"931aa964-f11a-a6ef-f449-c1649f193837\" href=\"https://www.espn.com/nfl/player/_/id/4361432/romeo-doubs\">Romeo Doubs</a> on the sort of scramble drill creation Maye had excelled with last season.</p>\n<p>And on Sunday against the Jaguars, Maye continued to put the ball in danger in spots where it wasn't needed. His first interception was a disaster -- a throw offensive coordinators try to pry out of their quarterbacks after they turn pro. Booting to the right on the same fast-to-the-flat concept so many teams are running these days, Maye's first option, running back <a data-player-guid=\"819826d3-6398-f473-46df-252be8a68036\" href=\"https://www.espn.com/nfl/player/_/id/4569173/rhamondre-stevenson\">Rhamondre Stevenson</a>, was taken away. Under pressure from <a data-player-guid=\"a95ee0df-7287-18ed-a5a2-b1ad7f63f8ea\" href=\"https://www.espn.com/nfl/player/_/id/3050073/foyesade-oluokun\">Foyesade Oluokun</a>, Maye realistically should have thrown the ball away on a third-and-goal situation and either lived to try on fourth down or picked up three points. Instead, he threw against his body to <a data-player-guid=\"aa4d3e91-bafe-5ffe-bae4-36e00386dd19\" href=\"https://www.espn.com/nfl/player/_/id/3046439/hunter-henry\">Hunter Henry</a>, and <a data-player-guid=\"c39cf8be-f94e-3db4-9c3a-fcc72135a03f\" href=\"https://www.espn.com/nfl/player/_/id/4685415/travis-hunter\">Travis Hunter</a> made the interception. It was the wrong risk at the wrong time.</p>\n<p>Maye also had the ball slip out of his hands in the middle of a dropback for a fumble, an issue he attributed after the game to a <a href=\"https://www.bostonherald.com/2026/09/27/drake-maye-blames-blood-for-bizarre-turnover-in-patriots-loss-to-jaguars/\" target=\"_new\">bloody football</a>. He lost another one at the end of a scramble, costing the Patriots another drive that ended inside the 5-yard line. And while his second interception might have been more on wide receiver <a data-player-guid=\"359ec99e-3714-88dc-c5de-1dc522b8369f\" href=\"https://www.espn.com/nfl/player/_/id/4613202/kyle-williams\">Kyle Williams</a> (who didn't offer much physicality on a contested catch situation on the sideline), it certainly feels like Maye is pressing or trying to make too much happen.</p>\n<p>Still, Maye does have stretches where he's playing well. He was fine for most of the game against the Seahawks and made several important plays, mostly with his legs, late in the contest to get the Pats back in a position to tie or take the lead before his final ill-advised pick. And there were multiple third downs in this game against Jacksonville where Maye was pressured, escaped, reset and delivered a ball that either hit his receiver in the hands or went through them. <a data-player-guid=\"f125b093-8b6f-4d5d-8984-87d3babbc871\" href=\"https://www.espn.com/nfl/player/_/id/2991662/mack-hollins\">Mack Hollins</a> taking a taunting penalty after a 9-yard catch on third-and-10 down 28-3 in the fourth quarter isn't on Maye and probably wasn't a great idea (even if that's a score that might feel comfortable for Patriots fans).</p>\n<p>Is it just the fact that the Patriots are playing tougher opponents than they were in 2025? I think that's certainly part of the issue. If you go back to 2025, Maye wasn't turning the ball over this often against top-tier competition. Including the postseason, Maye played nine games against top-15 defenses by DVOA last season, and he threw eight interceptions in those nine games. We don't know if the Seahawks, Jaguars and Steelers will finish as elite defenses in 2026, but he now has six picks in three games and might have been lucky to leave Jacksonville without adding even more to that total.</p>\n<p><video3></p>\n<p>I would say more specifically that Maye was not punished anywhere near as often for putting the ball into dangerous situations a year ago. Remember that he had multiple wideouts run <a href=\"https://bsky.app/profile/billbarnwell.com/post/3mbh6ku2ri22m\" target=\"_new\">remarkable catch rates over expectation</a> last season, with <a data-player-guid=\"399d0ebb-43a6-3c68-a978-cb744c759208\" href=\"https://www.espn.com/nfl/player/_/id/4429022/kayshon-boutte\">Kayshon Boutte</a>, <a data-player-guid=\"d6ba7023-458c-f59a-4af2-638770067518\" href=\"https://www.espn.com/nfl/player/_/id/2976212/stefon-diggs\">Stefon Diggs</a> and Hollins all coming in 10-plus percentage points ahead of expected. I'm not saying that Maye was careless, but when he did take risks, he typically came out unscathed.</p>\n<p>Maye completed 47.7% of his tight-window throws in 2025, which was 11.4 percentage points better than his expected completion percentage on those attempts. He threw four picks on 88 tight-window attempts. This season, he has more interceptions (three) than completions (two) on tight-window passes, going 2-of-9 there. And after running a plus-9.0% completion percentage over expectation across all his throws in the 2025 regular season, Maye is at plus-2.4% this season.</p>\n<p>The offense around him hasn't been as effective, in part because of injuries. The Patriots were the sixth-healthiest offense in the league last season by adjusted games lost. This year, they've already lost Brown to a high-ankle sprain and right guard <a data-player-guid=\"44a779a5-c59c-bc8a-bb5f-c1e03b12aa76\" href=\"https://www.espn.com/nfl/player/_/id/4046545/mike-onwenu\">Mike Onwenu</a> to a <a href=\"https://www.espn.com/nfl/story/_/id/49990760/patriots-starting-rg-mike-onwenu-carted-ankle-injury\">fractured ankle</a>. They miss Diggs, who was one of the NFL's most efficient receivers on a per-snap basis, even if the Patriots only used him for about 50% of their offensive snaps. Hollins has instead been their unlikely lead receiver, as Doubs has been inconsistent. (Doubs' drop against the Seahawks before a Maye interception looms in the memories of Patriots fans.)</p>\n<p>The word that keeps coming to mind when I watch this version of Maye, though, is inexperienced. That ability to calibrate decisions? To know when and where to put the ball in danger? To be a quarterback who both simultaneously makes the best possible decision within a play and the broader context of the game situation? It's tough to watch Maye and say he has a great handle on that part of the job right now. And that's not completely uncommon for a QB in Year 3. But Maye was perhaps able to cover over those issues last season while playing from ahead so often against teams that couldn't make him pay.</p>\n<p>The Patriots might consider acting accordingly now. They're already calling designed runs on first down nearly 57% of the time this season, the ninth-highest rate in the NFL. Could they lean even more into the run on early downs? Could they up the play-action rate to create easy completions for Maye when only four offenses run play fakes less often?</p>\n<p>Or should the Patriots just stick it out and trust that Maye will get right? After all, the guy who finished ahead of Maye in the MVP balloting last season is a lot more experienced than his younger predecessor, and <a data-player-guid=\"20c41c33-a33f-6dc2-7e1f-0771e39ce49a\" href=\"https://www.espn.com/nfl/player/_/id/12483/matthew-stafford\">Matthew Stafford</a> has four interceptions in three games, too, including a pick-six that helped the Broncos back into things Sunday night. With games against the 3-0 Bills and Raiders on the way, though, the Patriots can't afford to watch Maye learn on the fly given their expectations heading into 2026.</p>\n<p><video4></p>\n<p><a name=\"lac\"></a></p>\n<hr>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/lac.png&h=110&w=110\" width=\"31\"></p>\n<h2><a data-clubhouse-guid=\"84caf62b-c753-71ea-a787-44fd224a4294\" href=\"https://www.espn.com/nfl/team/_/name/lac/los-angeles-chargers\">Los Angeles Chargers</a></h2>\n<p><a href=\"https://www.espn.com/nfl/game/_/gameId/401872953/chargers-bills\"><strong>Lost 24-16 to the Bills</strong></a></p>\n<p>If not now, then when? If the Chargers were ever going to turn around their season amid a brutal slate of opponents, wouldn't it have come in the sort of game we saw Sunday afternoon in Buffalo? A Chargers defense that had looked like a sieve through two losses to start the season suddenly lurched back to life against one of the league's best offenses, forcing <em>five</em> turnovers. A moribund Chargers offense that hasn't been able to sustain drives got to start three inside Buffalo territory. Receiver <a data-player-guid=\"ea99dfb4-efbc-32ae-aefe-267c745f722b\" href=\"https://www.espn.com/nfl/player/_/id/4612826/ladd-mcconkey\">Ladd McConkey</a> was back for a full complement of snaps after being limited last week, and the Bills lost top cornerback <a data-player-guid=\"540fc1a9-bf7d-f24d-ae8a-dcbd8d365dcd\" href=\"https://www.espn.com/nfl/player/_/id/4379778/christian-benford\">Christian Benford</a> to an in-game toe injury.</p>\n<p>But the Chargers still lost. Across Jim Harbaugh's career with Stanford, Michigan, the 49ers and the Chargers, he had gone 11-0 when his team posted a turnover margin of plus-four or better. The Chargers lost with a plus-four margin Sunday -- and they needed a field goal with 1:59 left to even get within one score. They started the fourth quarter with a three-point lead and immediately got the ball after strip-sacking <a data-player-guid=\"237b9f2a-4701-8fc3-60eb-250978af9893\" href=\"https://www.espn.com/nfl/player/_/id/3918298/josh-allen\">Josh Allen</a> for their fifth turnover of the game. They ended it relying on an onside kick to even have a shot at winning.</p>\n<p>Some of this was a disastrous day from Harbaugh, who appeared to respond to his team's 0-2 start by turtling up and going 25 years into the past. After going up 7-0 and getting the ball back courtesy of an Allen interception, the Chargers made their way into the red zone. Facing a third-and-5, the Chargers chose to run the ball with <a data-player-guid=\"d1faa993-e3a2-38bb-9c84-8f7e017c155c\" href=\"https://www.espn.com/nfl/player/_/id/4596334/keaton-mitchell\">Keaton Mitchell</a>, who picked up 2 yards. You can understand why. Offenses are more willing to run the ball on third-and-medium because they're open to going for it on fourth-and-short; that opens up the playbook on third down. Defenses have to respect the run in those situations, which only frees up the passing game in the process. Nothing new here.</p>\n<p>Well, all that made sense until Harbaugh sent out his kicker and went up 10-0. There were anecdotal arguments for kicking -- Tom Brady noted the benefits of making it a two-score game and locking in points early -- but analytical models weren't impressed. ESPN's model had the decision to kick as a <a href=\"https://x.com/SethWalder/status/2104263968726344007\" target=\"_new\">1.9 percentage point swing</a>. Playing for a two-possession game in the first quarter against the Bills, who can move the ball and score at will, was naive.</p>\n<p><inline2></p>\n<p>Even worse, it signaled a disconnect between the head coach and offensive playcaller. Mike McDaniel is the guy in charge of the offense, and when he was the head coach with the Dolphins, he could call a run on third-and-5 knowing that he'd have the final say on whether to go for it on fourth down. Here, while McDaniel is the playcaller, Harbaugh is the head coach and the guy who decides what to do on fourth down. That gap led to what was clearly a suboptimal combination, where the Chargers didn't do the thing on third down that maximized their chances of getting a first down on one play, then kicked on fourth down when that also hurt their chances.</p>\n<p>Harbaugh then doubled down with an even worse decision. Facing a fourth-and-goal from the 3-yard line with the score tied in the third quarter, Harbaugh again sent out <a data-player-guid=\"95bcfbce-0656-189a-21e9-5550b3d70ce6\" href=\"https://www.espn.com/nfl/player/_/id/4362081/cameron-dicker\">Cameron Dicker</a> to give the Chargers the lead. ESPN's model saw this as an <a href=\"https://x.com/SethWalder/status/2104283983244579161\">even bigger swing</a>, with the decision itself costing the Chargers 5.8 percentage points of win probability. Los Angeles would have been better off going for it if it had believed its chances of converting were merely 25%.</p>\n<p>Between those two calls, the Chargers' chances of winning dropped by nearly eight full points. Again, doing this against the Bills and their offense is even worse. While Los Angeles was able to hold off Buffalo by forcing takeaways, the points inevitably came for the Bills, who punted only once all game. Buffalo produced 55- and 80-yard drives at the end of the first half for 10 points, then scored touchdowns on back-to-back drives in the fourth quarter to take over the game.</p>\n<p>Managing the score in the first quarter or even the third quarter against a high-powered offense is shortsighted. When a team is in position to score touchdowns against a great offense as a significant underdog, it needs to take them. Yes, there's risk in failing, but as the Chargers showed here, you can kick field goals and still find a way to fail. And by the end of the game, having turned down fourth-and-short twice, they had to try to convert a fourth-and-10 to extend the game with 5:14 to go. They failed.</p>\n<p>While this was comfortably their best performance of the season, I would be very hesitant to draw significant conclusions about this being something closer to the Chargers many people expected heading into the season. There's no question that the defense played better, but L.A. can't count on forcing (and particularly recovering) three fumbles every game. Safety <a data-player-guid=\"9ca63f11-bdce-3a4d-8e30-975419f12cb3\" href=\"https://www.espn.com/nfl/player/_/id/4950551/genesis-smith\">Genesis Smith</a> had two picks, and while one was a nice job of jumping a route as a quarters safety, the other came on a contested catch where the rookie had the ball land on his stomach as he was falling and rolling on the ground. If Smith has those sort of hands, the Chargers should move him to wide receiver!</p>\n<p>Speaking of which, another <a data-player-guid=\"84bbb266-ee47-3828-9628-a26e48c152c8\" href=\"https://www.espn.com/nfl/player/_/id/4429025/quentin-johnston\">Quentin Johnston</a> drop conspicuously led the way in a messy day for the offense. This was the Chargers' best game on the ground so far, with Mitchell and <a data-player-guid=\"757d9056-88c7-3df1-b2e3-f6f8f186780b\" href=\"https://www.espn.com/nfl/player/_/id/4685382/omarion-hampton\">Omarion Hampton</a> combining for 108 yards on 24 carries, but there was still little hint of the explosiveness McDaniels' run game was supposed to produce.</p>\n<p><video2></p>\n<p>The offense scored 16 points, and 10 of those came on drives that started in Bills territory after takeaways. Even those needed some extra help, as the Bills produced roughing the passer penalties on both possessions to push the ball forward for the Chargers. When the Los Angeles did produce a pair of long drives? One ended with a missed kick by Dicker. The other landed at the 1-yard line before a pair of false starts bumped the Chargers back to the 11, where a checkdown and that second Harbaugh decision to kick a field goal saw the Chargers end up with three points. The execution from this team continues to be remarkably sloppy.</p>\n<p>Herbert went 20-of-34 for 226 yards and a passing touchdown that came on a tap pass to Mitchell. Sixty-nine of those passing yards came on the final drive of the game, when the Chargers trailed by 11 points and the Bills were in prevent mode. Herbert threw an interception from just outside the red zone to <a href=\"https://www.espn.com/nfl/player/_/id/4034953/cj-gardner-johnson\">C.J. Gardner-Johnson</a> on a third-and-5 to cost the Chargers points, and while he dealt with drops from his wideouts yet again, Herbert also benefitted from the Bills dropping at least one more would-be interception.</p>\n<p>Winning in Buffalo wouldn't have fixed what's wrong with the Chargers. But it would have given a team that feels like nothing's going right some reason to believe that it can pull out of an awful rut. Now, after their third frustrating loss of the season, the Chargers have to travel up north and play the defending Super Bowl champs in Seattle <a href=\"https://www.espn.com/nfl/game/_/gameId/401872977/chargers-seahawks\">next Sunday</a>. And speaking of the Seahawks, they'll also be cranky about what they put out in Week 3 ...</p>\n<p><a name=\"sea\"></a></p>\n<hr>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/sea.png&h=110&w=110\" width=\"31\"></p>\n<h2><a data-clubhouse-guid=\"3767a23c-a17d-294f-288a-9086ad1f0680\" href=\"https://www.espn.com/nfl/team/_/name/sea/seattle-seahawks\">Seattle Seahawks</a></h2>\n<p><a href=\"https://www.espn.com/nfl/game/_/gameId/401872955/seahawks-commanders\"><strong>Lost 33-31 to the Commanders</strong></a></p>\n<p>The Seahawks might have felt invulnerable. The champs were riding a 12-game winning streak and hadn't lost in 314 days. They had survived Sam Darnold's <a href=\"https://www.espn.com/nfl/story/_/id/49944756/seahawks-say-sam-darnold-unique-soft-tissue-injury\">hip injury</a> to beat the <a href=\"https://www.espn.com/nfl/game/_/gameId/401872656/patriots-seahawks\">Patriots</a> and <a href=\"https://www.espn.com/nfl/game/_/gameId/401872943/seahawks-cardinals\">Cardinals</a>, and they were getting their starting quarterback back in the mix against the Commanders, who were going to be without arguably their three best offensive players in <a data-player-guid=\"f03f3238-b035-6f0e-5844-1529ca021c3a\" href=\"https://www.espn.com/nfl/player/_/id/4426348/jayden-daniels\">Jayden Daniels</a>, <a data-player-guid=\"0634573a-c005-bef4-552c-bc7dfd85b082\" href=\"https://www.espn.com/nfl/player/_/id/3051890/laremy-tunsil\">Laremy Tunsil</a> and <a data-player-guid=\"5ed1f0d9-1930-0aa5-4c0f-81f78ff4dedb\" href=\"https://www.espn.com/nfl/player/_/id/4262199/sam-cosmi\">Sam Cosmi</a>. While the Seahawks were banged-up at safety, this would have been a game they expected to win.</p>\n<p><inline3></p>\n<p>Instead, the Commanders got their season back on track, sealing the win with a pair of runs to burn the Seahawks' timeouts and the clock. Facing a third-and-9 and an all-out blitz look from Mike Macdonald with less than two minutes left, Commanders offensive coordinator David Blough handed the ball to <a data-player-guid=\"bcbc6499-ee45-3e7d-854a-52d76796786c\" href=\"https://www.espn.com/nfl/player/_/id/4697815/rachaad-white\">Rachaad White</a>, who picked up 19 yards to start squeezing Seattle. Then with a third-and-7 and a chance to end the game, Blough dialed up the quarterback run game and had Mariota read <a data-player-guid=\"d261b9e9-4068-8758-68d7-9661bf985195\" href=\"https://www.espn.com/nfl/player/_/id/16802/demarcus-lawrence\">DeMarcus Lawrence</a>, who crashed inside to take the running back. Mariota kept the ball on his first and only designed run of the game and beat the Seahawks to the sticks to seal up a critical victory.</p>\n<p>Losing to an 0-2 team with a backup quarterback is never going to feel great, and I'm sure this wasn't a pleasant flight back to the Pacific Northwest for the Seahawks. It also doesn't feel like a disastrous performance. Mariota's arguably the best backup quarterback in the league. The defense limited the Commanders to 2.6 yards per carry on the ground and 4.0 yards per play overall. In his return to the lineup, Darnold threw for 379 yards and four touchdowns, and the Commanders weren't able to sack him even once.</p>\n<p>What the Commanders did create, though, was something we haven't seen from the Seahawks offense in a while: turnovers. Between the Week 18 victory <a href=\"https://www.espn.com/nfl/game/_/gameId/401772961/seahawks-49ers\">over the 49ers</a> that clinched the top seed in the NFC, their three-game playoff run to a Lombardi Trophy and the first two games of the 2026 season, the Seahawks had turned the ball over just once across their past six contests. During Macdonald's time in Seattle, creating multi-takeaway games has been the way to beat the Seahawks. Since the start of 2024, the Seahawks are 9-9 when they turn the ball over two times or more, but they're 20-1 when they either go turnover-free or turn the ball over just once. Everyone's better when they protect the football, of course, but the Seahawks are virtually unbeatable when they do so.</p>\n<p>Instead, the Seahawks turned the ball over three times on Sunday. Those plays produced 21 points for Washington. <a data-player-guid=\"705bfe8e-8678-32bc-a5b8-535fcca2e1cd\" href=\"https://www.espn.com/nfl/player/_/id/4685512/jadarian-price\">Jadarian Price</a> fumbled on his own 21-yard line in the first quarter, with the Commanders scoring a touchdown four plays later. Darnold has a pass tipped at the line and picked off by dynamic rookie <a data-player-guid=\"34317f06-1e97-3466-9be9-3186599b2d87\" href=\"https://www.espn.com/nfl/player/_/id/5081807/sonny-styles\">Sonny Styles</a> at the Seattle 42-yard line, with the Commanders needing three plays to score this time. And an attempt by Darnold to check down on a naked bootleg was read and picked off by <a data-player-guid=\"4a393e3c-e035-528c-3ec5-6c22d690a37c\" href=\"https://www.espn.com/nfl/player/_/id/4427984/kain-medrano\">Kain Medrano</a>, who was taking the first defensive snaps of his career in this game after <a data-player-guid=\"72018a55-453a-86f0-f259-b2a6a90ec54f\" href=\"https://www.espn.com/nfl/player/_/id/4426901/leo-chenal\">Leo Chenal</a> was <a href=\"https://www.espn.com/nfl/story/_/id/50044065/commanders-lb-leo-chenal-injured-making-tackle-carted-off\">injured</a> early. Medrano returned Darnold's errant throw himself for a pick-six.</p>\n<p>Interceptions are part of life with Darnold, who can bunch picks together at times. Even while playing the best football of his career over the past two seasons, he had two multi-interception games in 2024 for the Vikings and three a year ago for the Seahawks, including six across the two regular-season games against the Rams. The tipped pick Sunday wasn't really his fault, but every QB runs into a few unlucky interceptions. Darnold has run relatively hot avoiding picks in his past few games, including the Super Bowl, where the Patriots were aggressively trying to chase him into throwing one early on.</p>\n<p><video5></p>\n<p>The other guy who made a big impact on offense in the Super Bowl is also conspicuous by his absence. Trading away <a data-player-guid=\"593e3c58-2b92-e0f1-f4a8-84215e27f023\" href=\"https://www.espn.com/nfl/player/_/id/15864/geno-smith\">Geno Smith</a> and signing Darnold in free agency in the 2025 offseason was a masterstroke for general manager John Schneider, but while the jury's still out on his decisions from the 2026 offseason, there might not be a Seahawks fan alive who doesn't wish that Seattle had re-signed running back <a data-player-guid=\"c0a76b7f-7b5d-be73-5e81-258439651478\" href=\"https://www.espn.com/nfl/player/_/id/4567048/kenneth-walker\">Kenneth Walker III</a>.</p>\n<p>In part, that's because Walker has looked fantastic with the Chiefs. Playing in something closer to a full-time role after splitting time for most of his Seahawks career, Walker leads the league with 360 rushing yards through three games. He's averaging 5.5 yards per carry on the ground while making life easier for <a data-player-guid=\"37d87523-280a-9d4a-0adb-22cfc6d3619c\" href=\"https://www.espn.com/nfl/player/_/id/3139477/patrick-mahomes\">Patrick Mahomes</a>, who looks utterly revitalized and relieved to finally have an explosive run game. After Chiefs backs had a league-low 10 explosive runs in 2025, Walker already has eight through his first three games in Kansas City.</p>\n<p>The Seahawks, meanwhile, are struggling to replace their former starter. Schneider used a first-round pick to select Price, who has looked explosive as a runner at times but has also now lost fumbles in consecutive games. Price was a rotational back behind <a data-player-guid=\"56491a70-2fa6-3f66-9731-4167ecbeb252\" href=\"https://www.espn.com/nfl/player/_/id/4870808/jeremiyah-love\">Jeremiyah Love</a> at Notre Dame, and after leaving the Week 2 win over the Cardinals with a chest injury, the Seahawks are going to be careful about expanding his workload too quickly.</p>\n<p>One of the places they don't really seem to trust Price is near the goal line, where new coordinator Brian Fleury has instead used the combo of <a data-player-guid=\"c3c5bc25-8a74-30c9-8727-fa80004d4152\" href=\"https://www.espn.com/nfl/player/_/id/4887558/emanuel-wilson\">Emanuel Wilson</a> and <a data-player-guid=\"31c62cd4-f12f-20bb-a436-5416989e35e1\" href=\"https://www.espn.com/nfl/player/_/id/4429835/george-holani\">George Holani</a>. It's not going all that well. Running backs typically convert about 49% of their carries inside the 2-yard line into touchdowns. During his time in Seattle, Walker scored on 11 of his 26 attempts inside the 2, which was below average but still a pretty reasonable 42% figure.</p>\n<p>Yet Wilson and Holani are 0-for-6 to start the season, picking up a combined minus-2 yards in the process. Wilson tried to bounce outside away from an unblocked Chenal and lost 2 yards early in the second quarter, and after a penalty gave the Seahawks a new set of downs, <a data-player-guid=\"3c1b9124-32f5-acb0-ffd6-c382b764638d\" href=\"https://www.espn.com/nfl/player/_/id/4259491/javon-kinlaw\">Javon Kinlaw</a> split through a pair of blockers to stuff Holani for no gain.</p>\n<p>Darnold hit <a data-player-guid=\"edf87204-0e8c-331c-ac63-c6e04a89ee76\" href=\"https://www.espn.com/nfl/player/_/id/4430878/jaxon-smith-njigba\">Jaxon Smith-Njigba</a> for a touchdown after Holani was stopped, but the Seahawks had little interest in running near the goal line again. When they got the ball back, Darnold drove the Seahawks to the 2-yard line at the two-minute warning of the first half, only for Fleury to dial up three straight pass plays. In a situation where teams typically want to run because it's both efficient and forces the opposing team to either let the clock bleed or use their timeouts, the Seahawks threw on second down, threw on third down and threw on fourth down -- all of which went incomplete.</p>\n<p><inline1></p>\n<p>The Commanders took over with 1:40 on the clock and improbably had time to launch two drives before halftime. While the first was stopped with little progress and led to the Seahawks kicking a field goal, the second allowed the Commanders to get into field goal range themselves, where <a data-player-guid=\"7ef250e0-f67b-3125-8b83-10482d3ce325\" href=\"https://www.espn.com/nfl/player/_/id/5081335/drew-stevens\">Drew Stevens</a> hit a 57-yarder that proved to be very crucial in a game that would be decided by two points.</p>\n<p>All winning streaks eventually come to an end. The Seahawks will be fine in the big picture, and five of their next six games are at home -- although that run includes the 49ers, Broncos, Chiefs and Bears. They'll hope to start a new winning streak next Sunday <a href=\"https://www.espn.com/nfl/game/_/gameId/401872977/chargers-seahawks\">against the Chargers</a>.</p>\n<p><a name=\"hou\"></a></p>\n<hr>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/hou.png&h=110&w=110\" width=\"31\"></p>\n<h2><a data-clubhouse-guid=\"595690b3-2161-4913-a7a7-814af2fd2621\" href=\"https://www.espn.com/nfl/team/_/name/hou/houston-texans\">Houston Texans</a></h2>\n<p><a href=\"https://www.espn.com/nfl/game/_/gameId/401872951/texans-colts\"><strong>Lost 19-17 to the Colts</strong></a></p>\n<p>\"We've done it before\" is always good to hear, but proof of concept doesn't always guarantee that you'll get what you want. The 2025 Texans started 0-3 and still made it to the postseason, a feat only one other team (the 2018 Texans) has managed to pull off during the NFL's 32-team era. That's a little easier in a league that has 14-team playoffs these days, but last season's Texans didn't sneak in as a seventh seed. Instead, they went on a 12-2 run, were the fifth seed in the AFC and advanced to the divisional round for the third consecutive year.</p>\n<p>If the Texans want to try to advance past the second round of the playoffs for the first time in the <a data-player-guid=\"147e6862-2ac0-3a97-8f36-e3b1c0147320\" href=\"https://www.espn.com/nfl/player/_/id/4432577/cj-stroud\">C.J. Stroud</a> era, they'll need to pull out something equally as impressive in 2026. For the second year in a row, a narrow loss to a divisional rival has dropped the Texans to 0-3. Last year, the Jags held the Texans to one lone touchdown in a <a href=\"https://www.espn.com/nfl/game/_/gameId/401772734/texans-jaguars\">17-10 defeat</a>.</p>\n<p>This time, the Texans weren't able to hold a lead. After going up 17-16 on a <a data-player-guid=\"bd8cfa24-9145-3c9e-b8e7-60669972052c\" href=\"https://www.espn.com/nfl/player/_/id/4429059/woody-marks\">Woody Marks</a> touchdown run with 1:48 to go, DeMeco Ryans' defense needed one stop to finally land their team a victory. This was their best defensive performance of the season, with <a data-player-guid=\"d08ac2e7-518c-3ca3-b3b8-9262906e6a27\" href=\"https://www.espn.com/nfl/player/_/id/4685724/will-anderson-jr\">Will Anderson Jr</a>. producing nine pressures and running over Colts right tackle <a data-player-guid=\"db97d6d2-326c-3ed5-9cec-fac86bebd60a\" href=\"https://www.espn.com/nfl/player/_/id/4892240/jalen-travis\">Jalen Travis</a> for a pair of strip sacks of <a data-player-guid=\"5ad1bcc2-57bc-bb72-bcd0-0cdd0d945444\" href=\"https://www.espn.com/nfl/player/_/id/3917792/daniel-jones\">Daniel Jones</a>, who also threw an interception while in field goal range in the third quarter. <a data-player-guid=\"ddd8786c-fd5a-4e55-ccc8-6ddf6f1ede33\" href=\"https://www.espn.com/nfl/player/_/id/4242335/jonathan-taylor\">Jonathan Taylor</a> had been held to 64 yards on 21 carries, and the Colts had scored just three points on four drives in the second half. One more stop would land a much-needed win for the Texans and likely knock the Colts out of the playoff picture before the end of September.</p>\n<p><inline4></p>\n<p>The Texans could not get that stop. Given time, Jones was able to hit <a data-player-guid=\"778bd937-b286-8098-a8f2-1e1818ccb67e\" href=\"https://www.espn.com/nfl/player/_/id/3051889/laquon-treadwell\">Laquon Treadwell</a> on a 20-yard dig, getting the Colts on Houston's side of the field in two plays. Indy coach Shane Steichen proceeded to get the ball into Taylor's hands for two consecutive carries.</p>\n<p>Ryans was excoriated after the game for not using his first timeout after Taylor's 5-yard run got the ball to the Houston 40-yard line until about 35 seconds had passed. Frankly, I'm not sure it was the worst decision. The Texans were staring down a 58-yard field goal attempt at that point from <a data-player-guid=\"bd38713e-d779-d178-0745-9f0873baadc6\" href=\"https://www.espn.com/nfl/player/_/id/4571557/spencer-shrader\">Spencer Shrader</a>, who had injured his groin during warmups. The Colts running clock, keeping the ball in Taylor's hands and settling for an extremely long field goal attempt wasn't such a bad thing.</p>\n<p>After the Texans stopped Taylor and used a timeout, however, Jones was able to find <a data-player-guid=\"c22ef201-95ad-1740-dd33-3ae06d7e7e68\" href=\"https://www.espn.com/nfl/player/_/id/15818/keenan-allen\">Keenan Allen</a> for a 6-yard completion against soft zone coverage on third-and-7. And while that didn't move the sticks for Indianapolis, it made Shrader's ensuing field goal try much more comfortable. The 27-year-old hit from 53 yards out, and the Colts were back on top for good, breaking what had been a 10-game losing streak going back to their 2025 bye.</p>\n<p>The Texans were able to overcome their 0-3 start a year ago by fielding one of the league's best defenses over the ensuing 14 games of the season. And as I <a href=\"https://www.espn.com/nfl/story/_/id/50006560/ranking-winless-two-loss-teams-playoffs-barnwell-2026\">wrote last Thursday</a>, this year's defense has not yet been on that level. Even after their impressive performance against the Colts, the Texans are 17th in EPA allowed per play and 20th in points against per drive through three games.</p>\n<p>Frankly, they did enough to win. They forced three turnovers and held the Colts to one touchdown on three red zone trips. Limit the opposing team to 19 points on 10 drives and set your offense up with two short fields after takeaways, and you've held up your end of the bargain (even if you did allow that 20-yard completion on the final possession of the game).</p>\n<p>With the Texans, though, there's an overwhelming reliance on the things the team does right to overcome their weaknesses. The defense has to compensate for the offense. Stroud has to overcome an absent running game. Ryans has to overcome his own predilections for conservative decision-making and game management, and when he does get brave enough to go for it on fourth-and-short -- as he did for the second consecutive week -- the Texans have to deliver. Again, they did not, with <a data-player-guid=\"c9be5cd2-4e6a-86b1-3c08-ab4e44e6b3bf\" href=\"https://www.espn.com/nfl/player/_/id/4035538/david-montgomery\">David Montgomery</a> stuffed on a fourth-and-1 rush attempt after sixth lineman <a data-player-guid=\"17c3ff27-570a-3bde-95e5-bce26b8b4977\" href=\"https://www.espn.com/nfl/player/_/id/4432699/blake-fisher\">Blake Fisher</a> failed to get any push.</p>\n<p>I already covered the Texans at length last week, and the issues we saw in this game weren't much different than the ones we saw over the first two weeks of the season. Things will be better on offense once receiver <a data-player-guid=\"338aa0be-bd63-1a24-1929-796af121cefb\" href=\"https://www.espn.com/nfl/player/_/id/4258173/nico-collins\">Nico Collins</a> returns from his <a href=\"https://www.espn.com/nfl/story/_/id/50028897/texans-wr-nico-collins-hamstring-miss-second-straight-game\">hamstring injury</a>. The defense looks like it's rounding back into form. What might be cause for alarm for other teams is business as usual for the Texans.</p>\n<p><video6></p>\n<p>I'm just not sure Houston's strengths are really all that strong at the moment. The defense hadn't been at its dominant best until Sunday. Stroud had an impressive opener against the Bills, but he has a 44.7 Total QBR without Collins on the field over the past two weeks. Yes, we know the Texans can get themselves out of this hole. Doing it once, though, isn't a guarantee in pulling it off a second time.</p>\n<p><a name=\"car\"></a></p>\n<hr>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/car.png&h=110&w=110\" width=\"31\"></p>\n<h2><a data-clubhouse-guid=\"647c27bf-ab86-550e-5b83-91c29e73e4a9\" href=\"https://www.espn.com/nfl/team/_/name/car/carolina-panthers\">Carolina Panthers</a></h2>\n<p><a href=\"https://www.espn.com/nfl/game/_/gameId/401872949/panthers-browns\"><strong>Lost 21-18 to the Browns</strong></a></p>\n<p>Injuries continue to plague the Panthers, who came into the season (alongside the 49ers) as the league's most banged-up team. Things have only gotten worse. One week after he came up with two interceptions, two tackles for loss and a sack, linebacker <a data-player-guid=\"54cd4cbb-ae10-82e1-4801-f1722a8add90\" href=\"https://www.espn.com/nfl/player/_/id/4243256/devin-lloyd\">Devin Lloyd</a> missed this game with a <a href=\"https://www.espn.com/nfl/story/_/id/50028146/panthers-scratch-lb-devin-lloyd-wrs-coker-legette-questionable\">calf injury</a>. Starting safety <a data-player-guid=\"570fa894-2df1-7a40-29a3-880b05911f73\" href=\"https://www.espn.com/nfl/player/_/id/3116179/nick-scott\">Nick Scott</a> also missed it with a rib injury, while rotational back <a data-player-guid=\"c349695b-9c76-39bf-878f-699e76ba2131\" href=\"https://www.espn.com/nfl/player/_/id/4678008/jonathon-brooks\">Jonathon Brooks</a> hit <a href=\"https://www.espn.com/nfl/story/_/id/50012387/sources-panthers-rb-jonathon-brooks-set-surgery-ir-move\">injured reserve</a> during the week. Carolina lost several more starters during the game, including wideout <a data-player-guid=\"1461459b-e133-3455-af3e-896df9dbca39\" href=\"https://www.espn.com/nfl/player/_/id/4695883/jalen-coker\">Jalen Coker</a> and cornerback <a data-player-guid=\"84d391c4-5184-3c62-5729-1f90bf26c8fa\" href=\"https://www.espn.com/nfl/player/_/id/3917853/mike-jackson\">Mike Jackson</a>.</p>\n<p>The injuries played an essential role on some of the most important snaps of Sunday's defeat. The Panthers went just 4-of-15 on third down and then 0-for-3 on fourth down. The Browns, meanwhile, converted two fourth downs, including one for a touchdown, before failing on an attempt to seal the game up three in the final minutes.</p>\n<p>On a fourth-and-3, left tackle <a data-player-guid=\"a2900084-6b30-1120-e194-23a1829b7960\" href=\"https://www.espn.com/nfl/player/_/id/4361429/rasheed-walker\">Rasheed Walker</a> was driven back into <a data-player-guid=\"975cc6da-01e5-3dcc-8a1a-1c9ecdb27d58\" href=\"https://www.espn.com/nfl/player/_/id/4685720/bryce-young\">Bryce Young</a>'s lap by Browns edge rusher <a data-player-guid=\"766e5e7b-7a10-7546-f027-91f35983a982\" href=\"https://www.espn.com/nfl/player/_/id/4578085/jared-verse\">Jared Verse</a>, leaving Carolina's QB with no way to see <a data-player-guid=\"d8843331-59d8-249e-7862-3b75104db19b\" href=\"https://www.espn.com/nfl/player/_/id/2576925/darren-waller\">Darren Waller</a> come open on a crosser as part of a mesh concept. Young was sacked by <a data-player-guid=\"9167867c-52d4-3d9e-982c-f4b7ad9f259b\" href=\"https://www.espn.com/nfl/player/_/id/4873232/mason-graham\">Mason Graham</a> to end the play. Walker might not be in the lineup if not for injuries to 2025 starting tackles <a data-player-guid=\"73e3d8e5-b2bd-bdae-11a3-dcaf7a35e458\" href=\"https://www.espn.com/nfl/player/_/id/4427132/ikem-ekwonu\">Ikem Ekwonu</a> and <a data-player-guid=\"a9d960e7-140d-ed68-d984-7f0622735ae8\" href=\"https://www.espn.com/nfl/player/_/id/2973051/taylor-moton\">Taylor Moton</a>, which forced first-round pick <a data-player-guid=\"04146b01-ba4a-3d1c-9208-aec23febb131\" href=\"https://www.espn.com/nfl/player/_/id/4870694/monroe-freeling\">Monroe Freeling</a> to play right tackle and kept Walker in on the blind side.</p>\n<p><video7></p>\n<p>The Browns, meanwhile, converted a fourth-and-3 in the second quarter when <a data-player-guid=\"0385d73f-aa41-3619-868a-98942554ba97\" href=\"https://www.espn.com/nfl/player/_/id/4870653/kc-concepcion\">KC Concepcion</a> came in motion and was too fast for cornerback <a data-player-guid=\"3a9ac713-273a-fba8-8bc7-5d8c179bfd7a\" href=\"https://www.espn.com/nfl/player/_/id/4244607/akayleb-evans\">Akayleb Evans</a> on a speed out. Evans entered the lineup after Jackson went down with a groin injury in the first quarter and did not return. <a data-player-guid=\"b6ec8e9e-3d85-a1de-9d0a-5a51621a9c20\" href=\"https://www.espn.com/nfl/player/_/id/3122840/deshaun-watson\">Deshaun Watson</a> hit <a data-player-guid=\"32593c89-2e72-352a-a204-a2e034ca9a81\" href=\"https://www.espn.com/nfl/player/_/id/5083076/harold-fannin-jr\">Harold Fannin Jr</a>. for a touchdown pass on fourth-and-goal from the 2-yard line at the end of the quarter after the tight end ran away from safety <a data-player-guid=\"76d65c01-c5fa-3175-8e55-f7ffc74eaa81\" href=\"https://www.espn.com/nfl/player/_/id/4566384/zakee-wheatley\">Zakee Wheatley</a>, who was in the lineup for Scott.</p>\n<p>Let's fast-forward. Carolina scored to take the lead with 4:25 to go in the game when <a data-player-guid=\"1a7c9d99-ee13-0a64-d3a0-b460a61f19f9\" href=\"https://www.espn.com/nfl/player/_/id/4567096/john-metchie\">John Metchie III</a> (playing in Coker's absence) caught a touchdown. But leading by five, the Panthers failed to convert on the ensuing two-pointer. Left guard <a data-player-guid=\"5fad68ec-cc68-6b5d-7d35-d727ad902598\" href=\"https://www.espn.com/nfl/player/_/id/4362647/damien-lewis\">Damien Lewis</a> was dealing with a balky elbow and couldn't block Graham, who helped slow down and tackle <a data-player-guid=\"7c6b0551-49b5-aa13-9e26-7db2f9dad46f\" href=\"https://www.espn.com/nfl/player/_/id/4241416/chuba-hubbard\">Chuba Hubbard</a> short of the end zone. The Panthers were unable to get their lead to seven.</p>\n<p>Nearly three minutes later, the Browns made them pay. Facing a third-and-10 with 1:55 on the clock, Watson hit Fannin for his second score of the game. The Panthers were able to defend initially, but when Watson extended the play, <a data-player-guid=\"2c5e7ba5-3477-6e44-1925-2a2b431b7447\" href=\"https://www.espn.com/nfl/player/_/id/3117253/bobby-okereke\">Bobby Okereke</a> tried to chase down the quarterback, leaving <a data-player-guid=\"52337012-dfb6-688e-1676-4feeac731b00\" href=\"https://www.espn.com/nfl/player/_/id/4035232/tyrel-dodson\">Tyrel Dodson</a> (making his season debut for the injured Lloyd) to match to Fannin. Neither linebacker got where they needed to go, leaving an easy throw for a touchdown. I won't claim to know how the Panthers pattern match their zone coverages to route distributions on scramble drills, but that's going to be tougher to do and more subject to mistakes with two guys who only signed with Carolina at the end of the preseason.</p>\n<p>There are also the issues that the injuries might have impacted more subtly. Free agent edge rusher <a data-player-guid=\"ab9c9a20-5a41-25e0-b9d1-51a589d4e5bc\" href=\"https://www.espn.com/nfl/player/_/id/4242975/jaelan-phillips\">Jaelan Phillips</a> was on the sideline for that play, but would the Panthers have been able to keep Watson from extending if <a data-player-guid=\"5e1030a4-d268-5d62-315f-0a15cf90df23\" href=\"https://www.espn.com/nfl/player/_/id/4058925/tershawn-wharton\">Tershawn Wharton</a> (out after <a href=\"https://www.espn.com/nfl/story/_/id/48808745/panthers-d-lineman-tershawn-wharton-undergoes-neck-surgery\">neck surgery</a>) and <a data-player-guid=\"612dd487-79ec-3903-ac83-7b6b79f27cf9\" href=\"https://www.espn.com/nfl/player/_/id/4833355/nic-scourton\">Nic Scourton</a> (done for the year with a <a href=\"https://www.espn.com/nfl/story/_/id/49433276/panthers-scourton-carted-knee-injury-1st-day-camp\">torn ACL</a>) were healthy enough to play? Would Brooks have helped spell Hubbard and <a data-player-guid=\"7d561919-7fde-fbee-8c41-eb0805faa25f\" href=\"https://www.espn.com/nfl/player/_/id/4239934/aj-dillon\">AJ Dillon</a>, who had a 30% success rate on the ground?</p>\n<p>What about Coker? Young has been excellent generating big plays over the first two weeks of the season, in part because Coker's emergence has given him a second big wideout to call upon down the sideline. Over the first two weeks of the season, Young was 7-of-11 for 238 yards on deep passes, which NFL Next Gen Stats defines as passes traveling 20 or more yards in the air. Coker already had three deep completions this season, including a 51-yard touchdown <a href=\"https://www.espn.com/nfl/game/_/gameId/401872661/bears-panthers\">against the Bears</a>.</p>\n<p><video8></p>\n<p>This week, Young went just 2-of-6 for 81 yards on deep pass attempts, and one of those completions came against a prevent defense late in the contest. While Metchie scored a touchdown in his expanded role after Coker left the game, and <a data-player-guid=\"34f9a2e8-0b49-682f-8830-9ddf1fa241cd\" href=\"https://www.espn.com/nfl/player/_/id/4360763/brycen-tremayne\">Brycen Tremayne</a> caught four balls for a team-high 81 yards while helping fill in for Coker and <a data-player-guid=\"a286b774-0d65-9813-67aa-945ba3567e4e\" href=\"https://www.espn.com/nfl/player/_/id/4430034/xavier-legette\">Xavier Legette</a>, Young has been a different quarterback without Coker on the field. Since the start of 2024, Young has a Total QBR of 64.0 with Coker out there and a 40.5 mark without him in the lineup. That's the difference between being 10th and 30th in QBR.</p>\n<p>It's incredibly tough to overcome this many injuries in such a short period of time. The good news for the Panthers, I suppose, is that there's some rest coming up soon. After playing the Lions on <a href=\"https://www.espn.com/nfl/game/_/gameId/401872978/lions-panthers\">Sunday night</a> next week, the Panthers will get an early-season bye in Week 5. The NFC South remains wide open given that the Buccaneers and Saints both lost in Week 3, but Carolina needs to get healthy -- and fast -- if it wants to have any shot of playing meaningful football in January.</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Bill Barnwell","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50043253"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50043253"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50043253"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50043253/week-3-losses-seahawks-patriots-texans-chargers-panthers"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:20Z","status":"success"}