athletes":{"href":"https://www.espn.com/college-football/player/_/id/4911529/trinidad-chambliss"}}}}},{"id":608263,"type":"athlete","uid":"s:20~l:23~a:5152158","guid":"ba70f2d6-607c-3c66-8aea-d7d15eaa3af7","description":"Deuce Alexander","sportId":23,"athleteId":5152158,"athlete":{"id":5152158,"description":"Deuce Alexander","links":{"mobile":{"athletes":{"href":"https://www.espn.com/college-football/player/_/id/5152158/deuce-alexander"}},"web":{"athletes":{"href":"https://www.espn.com/college-football/player/_/id/5152158/deuce-alexander"}}}}},{"type":"event","uid":"s:20~l:23~e:401856699","guid":"c4a628d2-a3fb-3280-9b58-06241c70fc0d","description":"Ole Miss Rebels @ Florida Gators","eventId":401856699,"event":{"id":401856699,"sport":"football","league":"college-football","description":"Ole Miss Rebels @ Florida Gators","links":{"mobile":{"event":{"href":"https://www.espn.com/college-football/game/_/gameId/401856699"}},"web":{"event":{"href":"https://www.espn.com/college-football/game/_/gameId/401856699"}}}}}],"ad":{"bundle":"ncf_top_plays","sport":"ncf"},"contributingPartner":"wsc","contributingSystem":"wsc","tracking":{"coverageType":"OnePlay","leagueName":"NCAA Football","program":"ABC","sportName":"football","trackingId":"dm_20260926_NCF_trinidad_chambliss_throws_2yard_td_pass_to_deuce_alexander","trackingName":"NCF_One-Play (Trinidad Chambliss finds Deuce Alexander for an Ole Miss TD) 2026/09/26 ESHEET"}}],"related":[{"id":50033850,"dataSourceIdentifier":"746cdc901188b","publishedkey":"50033850","type":"Story","headline":"Projecting the College Football Playoff top 12 after Week 4","title":"Projecting the College Football Playoff top 12 after Week 4","linkText":"Projecting the CFP top 12 after Week 4: Gators claw into contention","images":[{"dataSourceIdentifier":"6785d754b3445","id":50038469,"type":"header","name":"London Montgomery [1296x729]","caption":"London Montgomery (24) and the Gators can celebrate a 4-0 start to the season.","credit":"Dustin Markland/Getty Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/0927/r1722264_1296x729_16-9.jpg"}],"byline":"Heather Dinich","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50033850"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50033850"}},"mobile":{"href":"http://m.espn.go.com/ncf/story?storyId=50033850"},"web":{"href":"https://www.espn.com/college-football/story/_/id/50033850/projecting-2026-college-football-playoff-top-12-week-4"}},"premium":false},{"id":49684109,"dataSourceIdentifier":"5da328692dee0","publishedkey":"49684109","type":"Story","headline":"2027 NFL mock draft: Reid's preseason first-round predictions","title":"2027 NFL mock draft: Reid's preseason first-round predictions","linkText":"Reid's preseason 2027 NFL mock draft: Quarterbacks go 1-2-3 ... and one team trades up for the top pick","images":[{"dataSourceIdentifier":"c0f5f05b409e5","id":49723583,"type":"header","name":"260826_nfl_jordan-reid-mock-draft [608x342]","caption":"Where could Indiana WR Charlie Becker, Oregon QB Dante Moore, Texas edge rusher Colin Simmons and Georgia CB Ellis Robinson IV end up?","alt":"260826_nfl_jordan-reid-mock-draft","credit":"ESPN Illustration","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0825/260826_nfl_jordan-reid-mock-draft_16x9_608x342.jpg"}],"byline":"Jordan Reid","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/49684109"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=49684109"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=49684109"},"web":{"href":"https://www.espn.com/nfl/draft2027/story/_/id/49684109/2027-nfl-mock-draft-reid-preseason-first-round-predictions-32-picks-manning-moore-carr"}},"premium":false},{"id":49814399,"dataSourceIdentifier":"0e3c86d0f4971","publishedkey":"49814399","type":"Story","headline":"2027 NFL draft: Kiper's early predictions on top prospects","title":"2027 NFL draft: Kiper's early predictions on top prospects","linkText":"Let's predict the NFL draft -- eight months early: Kiper's 10 big preseason takes","images":[{"dataSourceIdentifier":"871d255093e7e","id":49817844,"type":"header","name":"Jadan Baugh [608x342]","credit":"Matt Pendleton-Imagn Images","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0903/r1711062_2_608x342_16-9.jpg"}],"byline":"Mel Kiper Jr.","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/49814399"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=49814399"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=49814399"},"web":{"href":"https://www.espn.com/nfl/draft2027/story/_/id/49814399/2027-nfl-draft-mel-kiper-predictions-top-prospects-qbs-sleepers-college-football-playoff"}},"premium":false}],"categories":[{"id":30937,"type":"league","guid":"4509a056-5f02-4fb8-b6bb-de7cc5a923ec","description":"NFL Draft","sportId":0,"leagueId":3400,"league":{"id":3400,"description":"NFL Draft"}},{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":9571,"type":"league","uid":"s:20~l:23","guid":"0f8e3d42-fa27-3f60-9e8d-276e4892f50e","description":"NCAA Football","sportId":23,"leagueId":23,"league":{"id":23,"description":"NCAA Football","abbreviation":"NCAAF","links":{"mobile":{"leagues":{"href":"https://www.espn.com/college-football/"}},"web":{"leagues":{"href":"https://www.espn.com/college-football/"}}}}},{"id":1077,"type":"team","uid":"s:20~l:23~t:251","guid":"013a8bab-0dd5-f6a0-45e6-1128a124f34b","description":"Texas Longhorns","sportId":23,"teamId":251,"team":{"id":251,"description":"Texas Longhorns","abbreviation":"TEX","shortDisplayName":"Texas","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/251/texas-longhorns"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/251/texas-longhorns"}}}}},{"id":251,"type":"team","guid":"a5881f63-e491-3e48-9064-916de4a4849a","description":"University of Texas","sportId":3170,"teamId":251,"team":{"id":251,"description":"University of Texas","abbreviation":"Texas","shortDisplayName":"Texas"}},{"id":1090,"type":"team","uid":"s:20~l:23~t:57","guid":"fe74bfd9-c15e-7b3a-ab25-ff4e5636282e","description":"Florida Gators","sportId":23,"teamId":57,"team":{"id":57,"description":"Florida Gators","abbreviation":"FLA","shortDisplayName":"Florida","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/57/florida-gators"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/57/florida-gators"}}}}},{"id":57,"type":"team","guid":"97faef39-d222-37b0-94fc-9944321184e4","description":"University of Florida","sportId":3170,"teamId":57,"team":{"id":57,"description":"University of Florida","abbreviation":"Florida","shortDisplayName":"Florida"}},{"id":1091,"type":"team","uid":"s:20~l:23~t:61","guid":"4351fef8-fe69-53b1-ea57-72684b36ec35","description":"Georgia Bulldogs","sportId":23,"teamId":61,"team":{"id":61,"description":"Georgia Bulldogs","abbreviation":"UGA","shortDisplayName":"Georgia","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/61/georgia-bulldogs"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/61/georgia-bulldogs"}}}}},{"id":61,"type":"team","guid":"429cd0c4-212a-3660-9508-9e74776b5442","description":"University of Georgia","sportId":3170,"teamId":61,"team":{"id":61,"description":"University of Georgia","abbreviation":"Georgia","shortDisplayName":"Georgia"}},{"id":1099,"type":"team","uid":"s:20~l:23~t:145","guid":"f6196074-c394-4821-7b0b-c4271d9467de","description":"Ole Miss Rebels","sportId":23,"teamId":145,"team":{"id":145,"description":"Ole Miss Rebels","abbreviation":"MISS","shortDisplayName":"Ole Miss","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/145/ole-miss-rebels"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/145/ole-miss-rebels"}}}}},{"id":145,"type":"team","guid":"858e51f9-aa4c-36c9-8f15-ff77c703ad51","description":"University of Mississippi","sportId":3170,"teamId":145,"team":{"id":145,"description":"University of Mississippi","abbreviation":"Ole Miss","shortDisplayName":"Ole Miss"}},{"id":1095,"type":"team","uid":"s:20~l:23~t:2633","guid":"de276cc4-dc02-159f-0c1c-67ddaf02a9ea","description":"Tennessee Volunteers","sportId":23,"teamId":2633,"team":{"id":2633,"description":"Tennessee Volunteers","abbreviation":"TENN","shortDisplayName":"Tennessee","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/2633/tennessee-volunteers"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/2633/tennessee-volunteers"}}}}},{"id":2633,"type":"team","guid":"ff43c27b-3b2b-3a29-b1b9-4920b47b1c69","description":"University of Tennessee","sportId":3170,"teamId":2633,"team":{"id":2633,"description":"University of Tennessee","abbreviation":"Tennessee","shortDisplayName":"Tennessee"}},{"id":1111,"type":"team","uid":"s:20~l:23~t:2483","guid":"116d333f-cf1a-0c67-d450-36a834af56de","description":"Oregon Ducks","sportId":23,"teamId":2483,"team":{"id":2483,"description":"Oregon Ducks","abbreviation":"ORE","shortDisplayName":"Oregon","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/2483/oregon-ducks"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/2483/oregon-ducks"}}}}},{"id":2483,"type":"team","guid":"94cc8326-138d-3d76-8f6e-65e8744e6d92","description":"University of Oregon","sportId":3170,"teamId":2483,"team":{"id":2483,"description":"University of Oregon","abbreviation":"Oregon","shortDisplayName":"Oregon"}},{"id":1065,"type":"team","uid":"s:20~l:23~t:228","guid":"02382072-a5a3-24ff-6bd1-422a029bd33c","description":"Clemson Tigers","sportId":23,"teamId":228,"team":{"id":228,"description":"Clemson Tigers","abbreviation":"CLEM","shortDisplayName":"Clemson","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/228/clemson-tigers"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/228/clemson-tigers"}}}}},{"id":228,"type":"team","guid":"babdc0ea-f349-3077-9d84-b02f8cdc09e5","description":"Clemson University","sportId":3170,"teamId":228,"team":{"id":228,"description":"Clemson University","abbreviation":"Clemson","shortDisplayName":"Clemson"}},{"id":1093,"type":"team","uid":"s:20~l:23~t:238","guid":"f2c5bf52-4c7d-78ea-ce4d-6a91faee67c8","description":"Vanderbilt Commodores","sportId":23,"teamId":238,"team":{"id":238,"description":"Vanderbilt Commodores","abbreviation":"VAN","shortDisplayName":"Vanderbilt","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/238/vanderbilt-commodores"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/238/vanderbilt-commodores"}}}}},{"id":238,"type":"team","guid":"16289c7a-8f0e-33d7-8027-833c67cb0482","description":"Vanderbilt University","sportId":3170,"teamId":238,"team":{"id":238,"description":"Vanderbilt University","abbreviation":"Vanderbilt","shortDisplayName":"Vanderbilt"}}],"keywords":["NFL Draft","NFL","NCAA Football","Texas Longhorns","University of Texas","Florida Gators","University of Florida","Georgia Bulldogs","University of Georgia","Ole Miss Rebels","University of Mississippi","Tennessee Volunteers","University of Tennessee","Oregon Ducks","University of Oregon","Clemson Tigers","Clemson University","Vanderbilt Commodores","Vanderbilt University"],"story":"<p><video1></p>\n<p>The biggest storylines coming out of <a href=\"https://www.espn.com/college-football/scoreboard\">Week 4</a> of the <a href=\"https://www.espn.com/college-football/schedule\">2026 college football season</a> include Texas <a href=\"https://www.espn.com/college-football/game/_/gameId/401856704/texas-tennessee\">surviving</a> against Tennessee behind five sacks from <a data-player-guid=\"82773726-0e38-31fc-a028-ab67acc9d259\" href=\"http://www.espn.com/college-football/player/_/id/5079689/colin-simmons\">Colin Simmons</a>, Florida <a href=\"https://www.espn.com/college-football/game/_/gameId/401856699/ole-miss-florida\">knocking off</a> Ole Miss after <a data-player-guid=\"411a457d-d949-3b9b-918b-a65390dd848a\" href=\"http://www.espn.com/college-football/player/_/id/5079322/jadan-baugh\">Jadan Baugh</a> scored three TDs, Oregon <a href=\"https://www.espn.com/college-football/game/_/gameId/401858469/oregon-usc\">getting past</a> USC even after <a data-player-guid=\"499a514b-f7d0-35f9-a71a-4ec131562fa1\" href=\"http://www.espn.com/college-football/player/_/id/4870921/dante-moore\">Dante Moore</a> was <a href=\"https://www.espn.com/college-football/story/_/id/50039664/raiola-steps-injured-moore-rallies-oregon-usc\">forced out</a> of the game and Iowa <a href=\"https://www.espn.com/college-football/game/_/gameId/401858463/iowa-michigan\">coming back</a> to top Michigan on the final play. Mississippi State also <a href=\"https://www.espn.com/college-football/game/_/gameId/401856703/missouri-mississippi-st\">defeated</a> Missouri on a big <a data-player-guid=\"543cd135-b090-3928-92fb-e296216c4167\" href=\"http://www.espn.com/college-football/player/_/id/5177084/kamario-taylor\">Kamario Taylor</a> day, Wake Forest <a href=\"https://www.espn.com/college-football/game/_/gameId/401858243/wake-forest-louisville\">upset</a> Louisville and Wisconsin <a href=\"https://www.espn.com/college-football/game/_/gameId/401858466/wisconsin-penn-state\">edged</a> Penn State.</p>\n<p>What about the top <a href=\"https://www.espn.com/nfl/draft/news\">2027 NFL draft</a> prospects? Who stood out? Yes, the draft is still about seven months away, but our analysts are always looking down the road, taking early notes on top players and starting to stack their rankings for an exciting class.</p>\n<p>With that in mind, Mel Kiper Jr. and Jordan Reid will size up CFB action through a draft-centric lens on Sundays all season long. They are answering lingering questions on the best 2027 prospects, sharing insights from scouts, picking out risers to watch and pulling back the curtain on their evaluation process. Here is what they saw and heard through Week 4.</p>\n<p><a name=\"week4\"></a></p>\n<center>\n<p align=\"center\"><strong>Jump to:</strong><br>\n<a href=\"http://www.espn.com/nfl/draft2027/story/_/id/49881131/2027-nfl-draft-risers-questions-college-football-prospects#week4\">Week 4</a> | <a href=\"https://www.espn.com/nfl/draft2027/story/_/id/49881131/2027-nfl-draft-risers-questions-college-football-prospects#week3\">Week 3</a> | <a href=\"http://www.espn.com/nfl/draft2027/story/_/id/49881131/2027-nfl-draft-risers-questions-college-football-prospects#week2\">Week 2</a></p>\n</center>\n<p><img src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></p>\n<h2>Sept. 27</h2>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/251.png&h=110&w=110\" width=\"31\"></p>\n<p><b>Is <a data-player-guid=\"82773726-0e38-31fc-a028-ab67acc9d259\" href=\"http://www.espn.com/college-football/player/_/id/5079689/colin-simmons\">Colin Simmons</a> the runaway top edge rusher in this class?</b></p>\n<p><strong>Reid:</strong> The scouting trail continued for me this week in Knoxville, Tennessee, where I had a front-row seat for Simmons' five-sack performance against the Vols. It tied the Texas single-game record set in 1990. Outside of an <a href=\"https://www.espn.com/video/clip/_/id/50035009/texas-colin-simmons-penalized-miming-urinating-field\">excessive sack celebration</a> from Simmons, it was one of the best defensive performances that I've <em>ever</em> seen. At 6-foot-3 and 246 pounds, his combination of upfield burst and closing speed make it challenging for blockers to keep pace with him. Most impressive was how many different spots he got pressure from. Simmons not only rushed from both edges but also reduced down inside on late downs and wreaked havoc from there, as well.</p>\n<p>I got to see South Carolina's <a data-player-guid=\"3333a35a-548d-351a-a364-24f78c6686dd\" href=\"http://www.espn.com/college-football/player/_/id/5079709/dylan-stewart\">Dylan Stewart</a> last week <a href=\"https://www.espn.com/college-football/game/_/gameId/401856691/mississippi-st-south-carolina\">against Mississippi State</a>, and he should be a top pick, too. It's likely going to be a \"traits against production\" debate between the two; Stewart is the more explosive athlete with better size (6-foot-5, 250 pounds), but Simmons continues to produce at an elite level (seven sacks this season). But yes ... Simmons is the clear top player at the position at this point in the season.</p>\n<hr>\n<p><alsosee></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/57.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>What's the earliest <a data-player-guid=\"411a457d-d949-3b9b-918b-a65390dd848a\" href=\"http://www.espn.com/college-football/player/_/id/5079322/jadan-baugh\">Jadan Baugh</a> could come off the board if he keeps this up?</strong></p>\n<p><strong>Reid:</strong> A tough and rugged runner at 6-foot-1 and 225 pounds, Baugh has the makings of a top-20 pick. I think the Florida standout could go in the teens, as there are a lot of NFL teams that need a true RB1.</p>\n<p>How good has Baugh been? Per ESPN Research, he became only the second player in the past 20 seasons with at least 100 rushing yards and two rushing touchdowns in each of the first four games of a season, joining Leonard Fournette (2015). After 142 yards and three touchdowns against Ole Miss, he now has 600 rushing yards and 11 TDs on the season -- both top-two numbers in the FBS. The clear RB1 in the class so far, Baugh has terrific contact balance and lower-body quickness. With back-to-back games with at least 25 carries, he has proved that he's capable of taking on a heavy workload.</p>\n<hr>\n<p><b>What else are you hearing this week?</b></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/2483.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> Obviously the <a data-player-guid=\"499a514b-f7d0-35f9-a71a-4ec131562fa1\" href=\"http://www.espn.com/college-football/player/_/id/4870921/dante-moore\">Dante Moore</a> injury was the biggest news out of Oregon's win against USC, but the Ducks did get tight end <a data-player-guid=\"ffcee867-627d-33f2-876c-9fa85d1be58c\" href=\"http://www.espn.com/college-football/player/_/id/4922988/jamari-johnson\">Jamari Johnson</a> back from his own <a href=\"https://www.espn.com/college-football/story/_/id/49977640/oregon-jeremiah-mcclellan-jamari-johnson-sit-84-0-win-vs-portland-state-injuries\">injury</a>. And that offense just looks different with him out there. Johnson caught seven passes for 119 yards. He also made a terrific one-handed catch that was called back due to a penalty.</p>\n<p>At 6-foot-5 and 255 pounds, his game features physicality and athleticism. He has the speed to be a constant threat down the middle of the field, and he displays the hands and catch radius to haul in anything. Go back to the 2025 tape, and you'll see the ability to make defenders miss after the catch, too. His blocking is a work in progress, but he could be a first-rounder as he battles with LSU's <a data-player-guid=\"931ed4f8-615a-3172-8e6c-bdb7424f12d8\" href=\"http://www.espn.com/college-football/player/_/id/5079420/treydez-green\">Trey'Dez Green</a> for the TE1 title in the class.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/61.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> Georgia linebacker <a data-player-guid=\"e616f52f-1970-6982-e1d0-7ba9caa9072c\" href=\"http://www.espn.com/college-football/player/_/id/5145410/chris-cole\">Chris Cole</a> continued his tremendous start to the season. In the <a href=\"https://www.espn.com/college-football/game/_/gameId/401856700/oklahoma-georgia\">win against Oklahoma</a>, he finished with eight tackles and a sack. He also had two fumble recoveries, including an 85-yard scoop-and-score. Cole's range and physicality have consistently stood out. I think his ability to diagnose and attack downhill as a run defender has improved, too. Cole is my top-ranked linebacker and is positioning himself to be a mid-to-late first-rounder.</p>\n<p><strong>Kiper:</strong> Cole was all over the field Saturday. He might be 6-foot-3 and 235 pounds, but he looked like a safety on those fumble returns. He is going to run really well in predraft testing. Defensive coordinators in the pros will love his ability to impact every facet of the game; he can make plays against the run, drop into coverage, or use his bend-and-burst off the edge to get home on the QB. Cole is the perfect linebacker for today's game, and his versatility allows him to play off-ball or outside. He jumps off the tape, and I love his football IQ.</p>\n<p>But let's also give some credit to the Bulldogs' other linebacker, <a data-player-guid=\"bc4fb4fb-ee8f-3846-b4d5-0f917543f734\" href=\"http://www.espn.com/college-football/player/_/id/4871074/raylen-wilson\">Raylen Wilson</a>. He had 11 tackles and a sack Saturday. This is a dynamic duo; Cole is in the Round 1 discussion, and Wilson could go Day 2.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/145.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> The draft stock of Ole Miss wide receiver <a data-player-guid=\"ba70f2d6-607c-3c66-8aea-d7d15eaa3af7\" href=\"http://www.espn.com/college-football/player/_/id/5152158/deuce-alexander\">Deuce Alexander</a> continues to soar. Speaking to scouts over the summer, there were big expectations for the 6-foot, 180-pounder as he stepped into the WR1 role for the Rebels' offense. Despite a disappointing loss to Florida, he finished with seven catches for 134 yards and a touchdown. Don't be surprised to see him enter Round 1 conversations. Few other wideouts in this class offer his level of vertical speed and suddenness.</p>\n<p><video5></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/228.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> Jordan talked about Clemson cornerback <a data-player-guid=\"c668f497-da01-3164-9278-6ded82772ac5\" href=\"http://www.espn.com/college-football/player/_/id/5127738/ashton-hampton\">Ashton Hampton</a> last week, and he had another big game in coverage Saturday. Playing both press and off coverage, he had three tackles and three pass breakups <a href=\"https://www.espn.com/college-football/game/_/gameId/401858234/clemson-california\">against Cal</a>. Hampton crowds the receiver and gets in his hip pocket, disrupting routes right away at the line of scrimmage. He shows good recovery speed and can turn to locate the ball in coverage. And Hampton also shows the ability to plant and drive on the ball, helping him to four picks and 19 pass breakups over this career. Lockdown corner.</p>\n<p>But how about the other Clemson corner? <a data-player-guid=\"35c19d19-5bff-38b0-adf5-f5b9c06b309e\" href=\"http://www.espn.com/college-football/player/_/id/4871026/elliot-washington-ii\">Elliot Washington II</a> came over from Penn State, and he has been outstanding. He picked off two passes Saturday and has made at least one impact play in every game this season. At 5-foot-11 and 200 pounds, he is not as tall as Hampton (6-foot-2 and 205 pounds), but he has length. James Franklin used to rave about this kid. Whereas Hampton is a first-rounder, Washington probably goes on Day 2. He's a good special-teamer, too.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/2633.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> Tennessee defensive tackle <a data-player-guid=\"7b901160-8e77-3d9a-abe9-be3786bd4434\" href=\"http://www.espn.com/college-football/player/_/id/5146422/xavier-gilliam\">Xavier Gilliam</a> popped up on my radar this week (four tackles and a sack against Texas). He kept creating negative plays by getting quick penetration in the backfield. He also showed his stout presence as a run defender. The 6-foot-2, 305-pound transfer from Penn State is a name to monitor and should be added to the mix of top interior defenders in the class.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/238.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> Vanderbilt <a href=\"https://www.espn.com/college-football/game/_/gameId/401856698/vanderbilt-auburn\">lost to Auburn</a>, but safety <a data-player-guid=\"3cf18488-1a1e-3da4-a6a4-b39370ba40d5\" href=\"http://www.espn.com/college-football/player/_/id/5079471/cj-heard\">CJ Heard</a> looked good. He led Florida Atlantic in tackles in 2024 (80). He led Vandy in tackles in 2025 (71). And after nine more on Saturday, he leads the Commodores once more in 2026 (31). Heard can play centerfield or in the box because he's so quick to trigger -- he simply finds the ball. At 5-foot-11 and 210 pounds, he's compact and strong. Heard shows toughness and closing speed, and he's aggressive. I have a fourth-round grade on him, but the arrow is pointing up.</p>\n<p><a name=\"week3\"></a></p>\n<p><img src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></p>\n<h2>Sept. 20</h2>\n<p><b><a data-player-guid=\"a4f48e48-f06b-3cfc-a19d-2487eac549a9\" href=\"http://www.espn.com/college-football/player/_/id/4911529/trinidad-chambliss\">Trinidad Chambliss</a> and <a data-player-guid=\"eaed114d-6659-3a14-b8ac-3604531f81ae\" href=\"http://www.espn.com/college-football/player/_/id/5121169/darian-mensah\">Darian Mensah</a> are the current Heisman Trophy favorites. Has either QB played his way into the first round?</b></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/145.png&h=110&w=110\" width=\"31\"><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/2390.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> I do have Chambliss in Round 1 now, but I'm taking a wait-and-see approach with Mensah; Miami just hasn't played anyone yet.</p>\n<p>Let's start with the 6-foot-3, 205-pound Mensah, whom I saw in person Friday when Miami <a href=\"https://www.espn.com/college-football/game/_/gameId/401858226/miami-wake-forest\">faced Wake Forest</a>. He started the game with an impressive 24 straight completions and finished 30-of-34 for 220 passing yards and three touchdowns. I saw real poise and command -- he seemed to be in full control of the offense during the first three quarters. I would classify his arm strength as slightly above average, as he has displayed beautiful touch down the field and enough velocity to drive the ball. The fourth quarter was the first time we saw him pressured and knocked off schedule this season, and the Hurricane's modest schedule so far brings curiosity. How will Mensah look against a higher quality opponent? Scouts already have Nov. 7 circled -- that's when Miami <a href=\"https://www.espn.com/college-football/game/_/gameId/401858291/miami-notre-dame\">travels to Notre Dame</a>. Mensah is certainly in the first-round conversation, but I want to see him against better competition.</p>\n<p><video4></p>\n<p>Chambliss, meanwhile, went 33-of-48 for 363 passing yards, two passing touchdowns and one interception against LSU. Since taking over during the third game of last season, he has quickly become one of the most dynamic signal-callers in the country. His size (6-foot, 205 pounds) and age (will be a 25-year-old NFL rookie) will be major talking points, but his entire career has been about defying the odds. What gives me confidence about his next-level projection? How he elevates his play in big games and how efficiently he attacks the middle of the field. That second part is the worry with shorter passers, but Chambliss threw strike after strike Saturday night. His measurables won't be for everyone, but <a data-player-guid=\"2b8b596d-4804-3a7c-8647-21acde2398cc\" href=\"http://www.espn.com/college-football/player/_/id/5447060/russell-wilson\">Russell Wilson</a> is the NFL comparison that I use for him. If the current trend continues, I believe a team will take him in Round 1.</p>\n<hr>\n<p><b>What is one shift on your board you didn't expect to make this early?</b></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/84.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> <a data-player-guid=\"536b691f-5f45-3356-a345-02aa5d5f418c\" href=\"http://www.espn.com/college-football/player/_/id/5146735/charlie-becker\">Charlie Becker</a> is my new WR2. Coming into the season, I put a big grade on the Indiana receiver, ranking him as my No. 9 overall prospect. I also put him at No. 10 overall in my <a href=\"https://www.espn.com/nfl/draft2027/story/_/id/49684109/2027-nfl-mock-draft-reid-preseason-first-round-predictions-32-picks-manning-moore-carr\">most recent mock draft</a> as the third wideout off the board behind Ohio State's <a data-player-guid=\"d946ce07-3355-3ac6-98b1-ca667acef1d7\" href=\"http://www.espn.com/college-football/player/_/id/5079720/jeremiah-smith\">Jeremiah Smith</a> and Texas' <a data-player-guid=\"ed7d8278-f366-3d03-ab66-c3829337bcf9\" href=\"http://www.espn.com/college-football/player/_/id/5079376/cam-coleman\">Cam Coleman</a>. But after five catches, 127 yards and his sixth touchdown of the season <a href=\"https://www.espn.com/college-football/game/_/gameId/401858449/western-ky-indiana\">against Western Kentucky</a>, I have Becker over Coleman.</p>\n<p>At 6-foot-4 and 208 pounds, he's a smooth vertical threat who is capable of running the full route tree. He had only eight career starts coming into the season, but he's off to a fast start. Keep in mind that he has played North Texas, Howard and WKU so far, but he produced the same results in the back end of last season and into the College Football Playoff, when he was the Hoosiers' go-to target. Becker has a knack for creating separation and rare hand-eye coordination to come down with contested catches.</p>\n<hr>\n<p><b>What else are you hearing this week?</b></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/252.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> It's impressive to watch BYU running back <a data-player-guid=\"a55dc6b2-57a6-32e1-8a55-8645f15aa383\" href=\"http://www.espn.com/college-football/player/_/id/4918126/lj-martin\">LJ Martin</a> run the football. He has been consistent, durable and reliable over his career, going for 1,305 yards last season, and he looked dominant on Saturday <a href=\"https://www.espn.com/college-football/game/_/gameId/401856795/byu-colorado-st\">against Colorado State</a> with 175 yards and three scores. The 6-foot-2, 225-pound back moves with power. He breaks tackles and has <em>just enough</em> wiggle to shake some defenders. He's a north-south rusher who can bust loose and do some damage (i.e., his 56-yard TD on Saturday). Martin is a willing blocker, too, and while he hasn't been asked to catch the football a ton, he has some receiving chops. I have Martin in the Day 2 mix right now.</p>\n<p><video3></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/2579.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> South Carolina edge rusher <a data-player-guid=\"3333a35a-548d-351a-a364-24f78c6686dd\" href=\"http://www.espn.com/college-football/player/_/id/5079709/dylan-stewart\">Dylan Stewart</a> (6-foot-5, 250 pounds) made his season debut <a href=\"https://www.espn.com/college-football/game/_/gameId/401856691/mississippi-st-south-carolina\">against Mississippi State</a> and didn't disappoint. On his very first play, he forced an errant high throw that resulted in an incompletion on third down. Stewart also had a nice run stop where he showed physicality against a puller on his way to his only tackle for loss of the game. Stewart still needs to develop countermoves, as he often got stuck if his initial plan didn't work, and he's still working his way into game shape. But overall, I thought he had a good debut and showed flashes of why many evaluators believe he has the potential to be a top-five pick.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/52.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> I recently talked about Florida State receiver <a data-player-guid=\"32786979-4699-3df5-b4e9-9b47686fd6be\" href=\"http://www.espn.com/college-football/player/_/id/4870922/duce-robinson\">Duce Robinson</a> on the \"First Draft\" podcast. This kid is <em>huge</em> at 6-foot-6 and 230 pounds. He's in his second season with the Seminoles after transferring from USC, and he looks dynamic. He hasn't always used his frame to play like a power forward, but I saw it this weekend <a href=\"https://www.espn.com/college-football/game/_/gameId/401856685/florida-st-alabama\">against Alabama</a>. Robinson posted a 6-135-1 line, boosting his average per catch this season to 19.1 yards. He has dependable hands and can shield defenders from the ball with his body control. On his touchdown catch at the back of the end zone, he did a great job tracking the ball and getting a foot down. I see a solid Day 2 prospect.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/25.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> Cal safety <a data-player-guid=\"22b3dbcc-e49d-3656-8732-b7b6784c4738\" href=\"http://www.espn.com/college-football/player/_/id/5087950/kingston-lopa\">Kingston Lopa</a> continued his hot start <a href=\"https://www.espn.com/college-football/game/_/gameId/401858233/wagner-california\">against Wagner</a> with another interception, his fifth in three games. At 6-foot-5 and 210 pounds, he's a uniquely built safety who has flourished in his first season with the Golden Bears. He followed head coach Tosh Lupoi from Oregon to Cal, and Lopa has quickly caught my eye. Most scouts that I have talked to have late-Day 2 grades on him, and he's certainly trending upward.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/8.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> Wide receiver <a data-player-guid=\"c42451ae-2965-3b07-af98-efd990af65e8\" href=\"http://www.espn.com/college-football/player/_/id/4717430/chris-marshall\">Chris Marshall</a> has been all over. He started his career at Texas A&M, then went to Ole Miss. After being <a href=\"https://www.espn.com/college-football/story/_/id/34876814/aggies-suspend-3-football-players-indefinitely-sources-said\">dismissed for a violation of team rules</a>, he played at Kilgore College and then Boise State. Now he's with Arkansas. And the 6-foot-3, 213-pounder was great Saturday <a href=\"https://www.espn.com/college-football/game/_/gameId/401856686/georgia-arkansas\">against Georgia</a>, with seven catches for 104 yards. Marshall can make acrobatic circus catches look easy, high-pointing the ball and using his catch radius to pluck it out of the air. I had him in the later parts of Day 3 coming into the season -- and he's probably still a Day 3 guy -- but he is ascending. Keep an eye on him.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/228.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> Clemson's <a data-player-guid=\"c668f497-da01-3164-9278-6ded82772ac5\" href=\"http://www.espn.com/college-football/player/_/id/5127738/ashton-hampton\">Ashton Hampton</a> came into the season as my third-ranked cornerback, behind only <a data-player-guid=\"255cc855-104b-31d7-86b8-9bd4cc0afb67\" href=\"http://www.espn.com/college-football/player/_/id/5079629/leonard-moore\">Leonard Moore</a> (Notre Dame) and <a data-player-guid=\"0094feb3-ef33-39b3-8f8d-26a24985edc1\" href=\"http://www.espn.com/college-football/player/_/id/5079698/ellis-robinson-iv\">Ellis Robinson IV</a> (Georgia) ... but he's making the CB2 race very interesting. The 6-foot-3, 205-pounder has the makings of a top-15 player. His technique and ball skills have continued to improve, and while his turnover production still needs to get better, he has constantly affected throwing windows through the first three games of the season.</p>\n<p><inline2></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/2.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> Auburn has used linebacker <a data-player-guid=\"a003fd02-7b98-363b-a534-300a56058180\" href=\"http://www.espn.com/college-football/player/_/id/5079309/xavier-atkins\">Xavier Atkins</a> both off the edge and off the ball, and he just keeps making plays, with nine tackles, a sack and two tackles for loss <a href=\"https://www.espn.com/college-football/game/_/gameId/401856687/florida-auburn\">against Florida</a>. At 6-foot and 210 pounds, he is quick to read and react, diagnosing in an instant. But he's not just instinctive; he's also super fast to the football. That's a good combination. Atkins is in the Day 2 conversation, but he has to cut down on the missed tackles and be more aware of where the blockers are in the play. I'm going to be watching that over the rest of the season.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/259.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> Through three weeks, Virginia Tech tight end <a data-player-guid=\"1dbcbd3d-8435-3707-81af-cf33ab00d55e\" href=\"http://www.espn.com/college-football/player/_/id/5138451/luke-reynolds\">Luke Reynolds</a> is a major stock-up prospect. He already has his single-season career high for receiving yards (265). The Penn State transfer finished with 12 catches for 107 yards and a touchdown <a href=\"https://www.espn.com/college-football/game/_/gameId/401858232/virginia-tech-maryland\">against Maryland</a>. He's now one catch away from tying his total from <em>all</em> of last season (26). I think he is playing his way into Day 2 discussions, and he has an argument as TE3 right now behind <a data-player-guid=\"931ed4f8-615a-3172-8e6c-bdb7424f12d8\" href=\"http://www.espn.com/college-football/player/_/id/5079420/treydez-green\">Trey'Dez Green</a> (LSU) and <a data-player-guid=\"ffcee867-627d-33f2-876c-9fa85d1be58c\" href=\"http://www.espn.com/college-football/player/_/id/4922988/jamari-johnson\">Jamari Johnson</a> (Oregon).</p>\n<p><strong>Kiper:</strong> I wanted to see how Reynolds adjusted to the new team this season, but he is certainly moving up. At 6-foot-4 and 250 pounds, he finds soft spots in the defense and displays sure hands.</p>\n<p><a name=\"week2\"></a></p>\n<p><img src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></p>\n<h2>Sept. 13</h2>\n<p><b>Oregon's <a data-player-guid=\"499a514b-f7d0-35f9-a71a-4ec131562fa1\" href=\"http://www.espn.com/college-football/player/_/id/4870921/dante-moore\">Dante Moore</a> lost. Texas' <a data-player-guid=\"d499f837-dace-3ada-8168-eaaa41b706e3\" href=\"http://www.espn.com/college-football/player/_/id/4870906/arch-manning\">Arch Manning</a> pulled off a comeback. Is there any movement at the top of the QB class?</b></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/2483.png&h=110&w=110\" width=\"31\"><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/251.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> We are only two weeks into the season and there's still plenty of evaluation time left, but Week 2 spoke loudly for the top of the 2027 quarterback class. Through two weeks, Moore -- and Oregon as a whole -- has looked extremely inconsistent. He got off to a woeful start in the surprising 39-31 loss to Oklahoma State, going 1-of-6 for 9 yards in the first quarter. I saw three overthrows, and Moore didn't seem able to get comfortable. He was my top passer entering the season, but the QB1 race seems to have opened up a bit.</p>\n<p>In fact, Manning is now my top-ranked quarterback. He led the Longhorns to 21 unanswered points in the fourth quarter in an epic 24-23 comeback win over Ohio State. He made two impressive throws in the first half that weren't even completions. He placed the ball nicely on both the bizarre interception off <a data-player-guid=\"ed7d8278-f366-3d03-ab66-c3829337bcf9\" href=\"http://www.espn.com/college-football/player/_/id/5079376/cam-coleman\">Cam Coleman</a> and the clear drop by <a data-player-guid=\"218aef0a-2d40-3f91-afea-239b07a6fe9d\" href=\"http://www.espn.com/college-football/player/_/id/5218633/ryan-wingo\">Ryan Wingo</a> near the end zone. In the second half, Manning was 16-of-23 for 136 yards and one touchdown, and he was much more poised as he executed the offense.</p>\n<p>Oklahoma State's <a data-player-guid=\"a0c750f4-989f-3b88-bf11-4bd18a46deb1\" href=\"http://www.espn.com/college-football/player/_/id/5219834/drew-mestemaker\">Drew Mestemaker</a> made a statement. In his very first game against a Power 4 opponent, he finished with 317 passing yards and two touchdowns while adding another 109 yards and a score on the ground. Mestemaker -- along with Miami's <a data-player-guid=\"eaed114d-6659-3a14-b8ac-3604531f81ae\" href=\"http://www.espn.com/college-football/player/_/id/5121169/darian-mensah\">Darian Mensah</a> -- are certainly staking their own claims in the QB1 race. But I have Manning at the moment.</p>\n<p><inline1></p>\n<p><strong>Kiper:</strong> I don't know that there even is a true QB1 right now. Remember when Moore looked like Superman <a href=\"https://www.espn.com/college-football/game/_/gameId/401752854/oregon-penn-state\">against Penn State</a> last season? I keep waiting for him to show that again, but he just hasn't taken over a game since then. And while Manning led the Longhorns back, I want to see consistency across the whole game.</p>\n<p>Mestemaker was definitely the better quarterback in that Oregon-Oklahoma State game, but he still has 17 career starts (and threw two interceptions for the second straight game). Notre Dame's <a data-player-guid=\"9efd8aae-3821-39dd-8c77-23abfe62bcb5\" href=\"http://www.espn.com/college-football/player/_/id/5079369/cj-carr\">CJ Carr</a> and Miami's Mensah have looked awesome, but neither QB plays anyone of significance until they face each other ... in November (though Carr does get BYU next month). <a data-player-guid=\"4991b943-c4bf-3c82-9aed-4a2334c2efc7\" href=\"http://www.espn.com/college-football/player/_/id/5078810/sam-leavitt\">Sam Leavitt</a> threw three interceptions for LSU <a href=\"https://www.espn.com/college-football/game/_/gameId/401867796/louisiana-tech-lsu\">against Louisiana Tech</a> on Saturday, and NC State's <a data-player-guid=\"b5f10eb9-ecea-3dc5-9a68-5bdeee374f35\" href=\"http://www.espn.com/college-football/player/_/id/5079301/cj-bailey\">CJ Bailey</a> has had uneven play.</p>\n<p>So far, this quarterback class -- one that was widely expected to be amazing -- has underwhelmed. There's still a lot of time. We're only through Week 2. But I want to see the group level up and play with more consistency. This is the reason I don't do rankings until October -- we have to let these guys play a bit.</p>\n<hr>\n<p><b>Even in the loss, it was a huge game for Ohio State WR <a data-player-guid=\"d946ce07-3355-3ac6-98b1-ca667acef1d7\" href=\"http://www.espn.com/college-football/player/_/id/5079720/jeremiah-smith\">Jeremiah Smith</a>. What has impressed you most about his start to the season?</b></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/194.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> There aren't enough words to describe how special Smith is as a prospect. The most impressive part about his start is that <em>everyone</em> knows that the Buckeyes are going to target No. 4, and yet nobody has managed to stop him. He finished with eight catches for 164 yards and a touchdown Saturday, meaning Smith has now surpassed 150-plus receiving yards in three consecutive games dating back to last season (he had 151, plus two touchdowns, last weekend <a href=\"https://www.espn.com/college-football/game/_/gameId/401858432/ball-state-ohio-state\">vs. Ball State</a>). That's the longest streak for an Ohio State receiver in at least the past 30 seasons, per ESPN Research.</p>\n<p>Smith is capable of winning with speed or power, and he's a true mismatch for any coverage that secondaries attempt to play against him. He entered the season as the top prospect overall on my board and could end up with the highest grade that I've ever given out to a receiver.</p>\n<p><strong>Kiper:</strong> Smith has worked on becoming more dominant after the catch, and it's showing. He can power through with his physicality, but adding that YAC fear factor could make him even more of a problem for opponents. And Smith looks quicker and more dynamic once the ball is in his hands right now.</p>\n<hr>\n<p><b>What else are you hearing this week?</b></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/99.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> LSU edge rusher <a data-player-guid=\"3cfd9881-b1f3-3bcd-b8c1-59adfce6828f\" href=\"http://www.espn.com/college-football/player/_/id/4917971/princewill-umanmielen\">Princewill Umanmielen</a> had three sacks and four tackles for loss against Louisiana Tech. At 6-foot-4 and 244 pounds, he shows impressive speed off the edge and just explodes out of the blocks. But he also shows a really good inside move to beat offensive tackles and even makes plays in pursuit. I think Umanmielen could still add weight to his frame -- he gets swallowed up at times -- but he has a track record of being disruptive. He could be a good rotational pass rusher in the NFL, and I'd slot him into the second-round range right now (though he could play his way into Round 1 if he keeps this up).</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/344.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid: </strong>The scouting trail continued for me this weekend, as I made a stop in Minnesota to see the <a href=\"https://www.espn.com/college-football/game/_/gameId/401856677/mississippi-st-minnesota\">Gophers against Mississippi State</a>. One prospect that I wanted to pay close attention to was Bulldogs cornerback <a data-player-guid=\"4804952d-c6ce-3ec0-8451-c65d1eca47d4\" href=\"http://www.espn.com/college-football/player/_/id/5076950/kelley-jones\">Kelley Jones</a>. At 6-foot-4 and 205 pounds, he checks a ton of boxes for pro secondaries. His length, technique and ball skills all carried over into the game; he had a pass breakup and caused plenty of trouble for wideouts at the line of scrimmage. Jones is viewed as a potential top-40 pick, and I believe that he can end up at the back end of Round 1.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/9.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> Arizona State receiver <a data-player-guid=\"42e667f3-7182-31d1-91c7-329181018431\" href=\"http://www.espn.com/college-football/player/_/id/5031157/reed-harris\">Reed Harris</a> keeps catching my eye. The Boston College transfer finished with nine catches for 189 yards and two touchdowns <a href=\"https://www.espn.com/college-football/game/_/gameId/401856683/arizona-st-texas-am\">against Texas A&M</a>. At 6-foot-5 and 220 pounds, he has an outstanding frame and showcased his long speed on a 58-yard touchdown. Harris is viewed as a middle-round prospect, but with continued production, he could find himself squarely in the Day 2 mix.</p>\n<p><strong>Kiper:</strong> I was impressed with Harris, too. He has length and big hands, and he tracks the ball really well. He has averaged 20.7 yards per catch over his career; big plays are his calling card. And while he's being used mainly outside, I think he could be a big slot receiver at the next level. I have a similar grade on Harris at the moment, Jordan -- he's probably in that late-Day 2, early-Day 3 range.</p>\n<p><video2></p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/251.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> We weren't even sure Texas offensive tackle <a data-player-guid=\"73a6b5ab-154d-33d4-bb2d-30a9affcb008\" href=\"http://www.espn.com/college-football/player/_/id/4918430/trevor-goosby\">Trevor Goosby</a> would be playing early in the season, with the <a href=\"https://www.espn.com/college-football/story/_/id/49649538/sources-texas-lt-goosby-bone-bruise-knee-status-unclear\">bone bruise in his knee</a> after an August injury in practice. But he's out there, and he played solid on Saturday night against the Buckeyes. Goosby anchors well, making him tough to beat in pass protection. But despite not being the most athletic OT prospect, he also made a nice block in space. The 6-foot-7, 325-pounder remains very consistent, and he's a clear early-to-mid Round 1 guy.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/130.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Reid:</strong> Michigan edge rusher <a data-player-guid=\"8c23c1c8-ce63-3396-9664-2bdf690fadab\" href=\"http://www.espn.com/college-football/player/_/id/5160962/john-henry-daley\">John Henry Daley</a> was a major addition in the transfer portal for the Wolverines, and he showed why in the 17-10 upset victory over Oklahoma. At 6-foot-5 and 252 pounds, he finished with a sack and three tackles for loss, as his tenacious effort and deep repertoire of pass-rush moves were on full display. Daley suffered a <a href=\"https://www.espn.com/college-football/story/_/id/47065043/standout-utah-de-john-henry-daley-injures-leg-vs-kansas-state\">torn Achilles</a> last November while at Utah, and there were question marks about his overall explosiveness post-injury, but he has shown why many scouts believe he's a top-100 prospect with the potential to climb even higher.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/333.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> Alabama's <a data-player-guid=\"2fd0ccdb-4d22-3388-8fad-a1375512d32d\" href=\"http://www.espn.com/college-football/player/_/id/4905925/devan-thompkins\">Devan Thompkins</a> is going to have a lot of NFL eyes on him this fall if he keeps playing this way. At 6-foot-5 and 300 pounds, he is probably a 3-4 defensive end in the pros. He can win off the edge, he can win with a rip move, and he can win with his bull rush. Despite his size, he can even drop into coverage, and he made a nice play there <a href=\"https://www.espn.com/college-football/game/_/gameId/401856674/alabama-kentucky\">against Kentucky</a>. Thompkins brings scheme versatility, and you'll see him move inside at times. But no matter where he lines up, he brings imposing size at the point of attack and plays with high intensity. Thompkins had two sacks Saturday. He's a second-round player with the potential to rise.</p>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/ncaa/500/142.png&h=110&w=110\" width=\"31\"></p>\n<p><strong>Kiper:</strong> I think Missouri quarterback <a data-player-guid=\"77a8f463-e563-3ac9-b08f-36c8af08d626\" href=\"http://www.espn.com/college-football/player/_/id/5141684/austin-simmons\">Austin Simmons</a> might be a 2028 guy because he has started only four games, but he has looked <em>good</em> so far this season. The Ole Miss transfer can spin it with the best of them, and the ball jumps out of the lefty's hand. He throws with accuracy and touch -- he's a pure passer. After three TD passes <a href=\"https://www.espn.com/college-football/game/_/gameId/401856678/missouri-kansas\">against Kansas</a> on Friday night, he has a spotless 7-0 touchdown-to-interception ratio on the season.</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Mel Kiper Jr. and Jordan Reid","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/49881131"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=49881131"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=49881131"},"web":{"href":"https://www.espn.com/nfl/draft2027/story/_/id/49881131/2027-nfl-draft-risers-questions-college-football-prospects"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:23Z","status":"success"}