{"resultsCount":1,"resultsLimit":10,"resultsOffset":0,"headlines":[{"id":50049013,"nowId":"1-50049013","contentKey":"50049013-1-6-1","dataSourceIdentifier":"a295b6fbf02fe","publishedkey":"50049013","type":"Story","feedDisplayType":"Default","headline":"Cardinals rookie Jeremiyah Love earns bigger role in offense","description":"The running back out of Notre Dame rushed 21 times for 90 yards and caught five passes, including a TD.","title":"Cardinals rookie Jeremiyah Love earns bigger role in offense","linkText":"Cardinals rookie Jeremiyah Love earns bigger role in offense","categorized":"2026-09-28T10:43:34Z","originallyPosted":"2026-09-28T01:22:37Z","lastModified":"2026-09-28T10:43:33Z","published":"2026-09-28T10:43:33Z","root":"nfl","section":"NFL","images":[{"dataSourceIdentifier":"3ab33a2042a41","id":50049084,"type":"header","name":" Jeremiyah Love [1296x729]","caption":"Jeremiyah Love ran 21 times for 90 yards and caught a TD pass in his biggest game yet.","credit":"Ezra Shaw/Getty Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/0928/r1722801_1296x729_16-9.jpg"},{"type":"Media","name":"49ers move to 3-0 after beating the Cardinals 36-30","caption":"49ers move to 3-0 after beating the Cardinals 36-30","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/wsc/2026/0927/40ad9f1e-b420-49d6-ad71-2ec6d7ded607/40ad9f1e-b420-49d6-ad71-2ec6d7ded607.jpg"}],"video":[{"id":50047834,"dataSourceIdentifier":"3da58bb33a83f","cerebroId":"6ab9a7c275ba89659fc64a4b","pccId":"9e69285d-bc2d-4d49-8bb0-36ed6d0e7c71","source":"espn","headline":"49ers move to 3-0 after beating the Cardinals 36-30","shortHeadline":"49ers move to 3-0 after beating the Cardinals 36-30","caption":"49ers move to 3-0 after beating the Cardinals 36-30","title":"49ers move to 3-0 after beating the Cardinals 36-30","description":"49ers move to 3-0 after beating the Cardinals 36-30","shortDescription":"49ers move to 3-0 after beating the Cardinals 36-30","