yer/_/id/2578570/jacoby-brissett"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/2578570/jacoby-brissett"}}}}},{"id":126377,"type":"athlete","uid":"s:20~l:28~a:16737","guid":"5073fc58-91c1-4e3d-826d-af754f9f40c7","description":"Mike Evans","sportId":28,"athleteId":16737,"athlete":{"id":16737,"description":"Mike Evans","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/16737/mike-evans"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/16737/mike-evans"}}}}},{"id":166874,"type":"athlete","uid":"s:20~l:28~a:3117251","guid":"db08ac19-dbd9-a776-5885-de1fe6830bc2","description":"Christian McCaffrey","sportId":28,"athleteId":3117251,"athlete":{"id":3117251,"description":"Christian McCaffrey","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3117251/christian-mccaffrey"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3117251/christian-mccaffrey"}}}}},{"id":1583,"type":"team","uid":"s:20~l:28~t:22","guid":"8fc7b962-95e1-3cb8-6a7d-b499de9ad546","description":"Arizona Cardinals","sportId":28,"teamId":22,"team":{"id":22,"description":"Arizona Cardinals","abbreviation":"ARI","shortDisplayName":"Cardinals","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ari/arizona-cardinals"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ari/arizona-cardinals"}}}}},{"id":711824,"type":"editorialindicator","guid":"d348c764-47d9-3e31-bd75-d39dfde52c26","description":"SC4U  - Eligible"},{"id":711821,"type":"editorialindicator","guid":"f3e05446-8d07-3064-a239-c10c32884ea2","description":"SC4U - Full Highlight"},{"type":"event","uid":"s:20~l:28~e:401872958","guid":"c5afebc3-aee2-338e-b5c9-37c3ca5725db","description":"Arizona Cardinals @ San Francisco 49ers","eventId":401872958,"event":{"id":401872958,"sport":"football","league":"nfl","description":"Arizona Cardinals @ San Francisco 49ers","links":{"mobile":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872958"}},"web":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872958"}}}}}],"ad":{"bundle":"nfl_one_plays","sport":"nfl"},"contributingPartner":"wsc","contributingSystem":"wsc","tracking":{"coverageType":"Final Game Highlight","leagueName":"NFL","program":"espnnfl","sportName":"football","trackingId":"dm_20260927_NFL_49ers_move_to_30_after_beating_the_cardinals_3630","trackingName":"COM_NFL Highlight (49ers move to 3-0 after beating the Cardinals 36-30) 2026/09/27 ESHEET"}}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":1583,"type":"team","uid":"s:20~l:28~t:22","guid":"8fc7b962-95e1-3cb8-6a7d-b499de9ad546","description":"Arizona Cardinals","sportId":28,"teamId":22,"team":{"id":22,"description":"Arizona Cardinals","abbreviation":"ARI","shortDisplayName":"Cardinals","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ari/arizona-cardinals"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ari/arizona-cardinals"}}}}},{"id":605430,"type":"athlete","uid":"s:20~l:28~a:4870808","guid":"56491a70-2fa6-3f66-9731-4167ecbeb252","description":"Jeremiyah Love","sportId":28,"athleteId":4870808,"athlete":{"id":4870808,"description":"Jeremiyah Love","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4870808/jeremiyah-love"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4870808/jeremiyah-love"}}}}},{"id":696416,"type":"contributor","guid":"ff2bd78b-f473-3bf6-bd0e-12c35dabe606","description":"Josh Weinfuss","slug":"josh-weinfuss","contributor":{"id":2330,"description":"Josh Weinfuss"}}],"keywords":["NFL","Arizona Cardinals","Jeremiyah Love","Josh Weinfuss"],"story":"\n<p>SANTA CLARA, Calif. --  Rookie <a data-player-guid=\"56491a70-2fa6-3f66-9731-4167ecbeb252\" href=\"https://www.espn.com/nfl/player/_/id/4870808/jeremiyah-love\">Jeremiyah Love</a> became the <a data-clubhouse-guid=\"8fc7b962-95e1-3cb8-6a7d-b499de9ad546\" href=\"https://www.espn.com/nfl/team/_/name/ari/arizona-cardinals\">Arizona Cardinals</a>' primary running back Sunday, but the rookie felt as if he didn't take full advantage of his additional reps in a <a href=\"https://www.espn.com/nfl/game/_/gameId/401872958/cardinals-49ers\">36-30</a> loss to the <a data-clubhouse-guid=\"985a261f-296c-c95c-32a5-addc4df75001\" href=\"https://www.espn.com/nfl/team/_/name/sf/san-francisco-49ers\">San Francisco 49ers</a> -- despite finishing with 90 rushing yards on 21 carries.</p>\n<p>\"Left a lot out there, I feel like,\" Love said. \"I feel like I could help the team a lot more. </p>\n<p>\"The runs that I got, I tried to take advantage of them the best way that I could, but there was a lot that I left out on the field. I could have got a lot more yards, a lot more conversions.\"</p>\n<p>Love said he felt he got into a groove in the second half when he ran for 41 yards. Arizona was down 17-6 at halftime and quickly went down 23-6 about 4 minutes into the third quarter, so the Cardinals were forced to throw the ball more than expected in the second half. Yet, Love still made waves.</p>\n<p>\"Whenever I was getting the ball more and more and more, I was getting in the groove, getting a feel for the game, trying to loosen up a little bit because, at first, I'm getting the ball trying to make sure I'm taking care of the ball,\" Love said. \"If guys come to tackle me, take care of the ball, get down, get as much as you can. Usually I'm the type of guy that likes to finesse and juke and do a lot of extra stuff. So I would say the more I was getting the ball, the more carries I was getting, I was getting back to my old self and trying to finesse a little bit.\"</p>\n<p>Love played in 52 snaps compared to <a data-player-guid=\"e2899a55-b6d2-e844-df8f-f9b928ed3c53\" href=\"https://www.espn.com/nfl/player/_/id/4373626/tyler-allgeier\">Tyler Allgeier</a>'s 30. This was the first game in which Love played more snaps than Allgeier.</p>\n<p><inline1></p>\n<p>In addition to his added role in the running game, Love was more active in the passing game. He finished with five catches on six targets for 19 yards and a touchdown.</p>\n<p>Love said he was ready -- and grateful -- for the increased workload and believes he can get only better. He said had he hit some of his holes full speed \"like I usually do, I'm probably going for at least one of them.\"</p>\n<p>\"So, statistically, you may look at the statistics and say, 'Hey, 21 for 90, you did pretty good,'\" Love said. \"But in my head, got to do better.\"</p>\n<p>Whether he gets the same kind of responsibility in the next game against the <a data-clubhouse-guid=\"378600ea-2397-8364-8399-b7c1606a49a7\" href=\"https://www.espn.com/nfl/team/_/name/nyg/new-york-giants\">New York Giants</a> will be determined this week, coach Mike LaFleur said, but LaFleur said Love handled the workload \"well.\"</p>\n<p>\"I thought he got in a groove right there,\" LaFleur said. \"It's like I just told him, I said, 'Hey, you just keep trusting your reads, keep taking the ball.'</p>\n<p>\"These guys got to go and play their game and see it and play fast, and I thought he did that.\"</p>\n<p>Arizona's longest run was for eight yards, which happened three times.</p>\n<p>Despite the lack of explosive run plans, quarterback <a data-player-guid=\"efcb42e5-0bef-62d1-b58b-dbc17fde2479\" href=\"https://www.espn.com/nfl/player/_/id/2578570/jacoby-brissett\">Jacoby Brissett</a> said Love looked comfortable Sunday.</p>\n<p>\"I think he's handled it pretty well,\" Brissett said. \"Obviously, leaning on him a lot today and I thought he answered the bell, made a lot of good plays for us and obviously finding ways to keep it going.\"</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Josh Weinfuss","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50049013"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50049013"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50049013"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50049013/cardinals-rookie-jeremiyah-love-earns-bigger-role-offense"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:22Z","status":"success"}