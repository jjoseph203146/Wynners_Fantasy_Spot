{"resultsCount":1,"resultsLimit":10,"resultsOffset":0,"headlines":[{"id":50046851,"nowId":"1-50046851","contentKey":"50046851-1-5-1","dataSourceIdentifier":"83cafbd81e318","publishedkey":"50046851","type":"HeadlineNews","feedDisplayType":"Default","headline":"Jefferson injured in Vikings' victory, will be reevaluated","description":"Vikings star receiver Justin Jefferson was ruled out of Sunday's game against the Tampa Bay Buccaneers after a first-quarter injury to his left ankle.","title":"Jefferson injured in Vikings' victory, will be reevaluated","linkText":"Injured Jefferson exits Vikings' victory, was 'close' to returning","categorized":"2026-09-28T12:44:08Z","originallyPosted":"2026-09-27T22:20:22Z","lastModified":"2026-09-28T02:26:01Z","published":"2026-09-28T02:26:01Z","root":"nfl","section":"NFL","images":[{"dataSourceIdentifier":"4e14077fac3c4","id":50049250,"type":"header","name":"Justin Jefferson [600x600]","credit":"Icon Sportswire","height":600,"width":600,"url":"https://a.espncdn.com/photo/2026/0928/r1722809_600x600_1-1.jpg"},{"type":"Media","name":"Kevin O'Connell provides update on Justin Jefferson's ankle injury","caption":"Kevin O'Connell provides update on Justin Jefferson's ankle injury","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/ss_20260927_204935897_3678097/ss_20260927_204935897_3678097.jpg"}],"video":[{"id":50048576,"dataSourceIdentifier":"a6c13543effe4","cerebroId":"6ab9b99d75ba89659fc64cb7","pccId":"dae70171-cd9b-48cb-b4e2-4a1bd7cc3327","source":"espn","headline":"Kevin O'Connell provides update on Justin Jefferson's ankle injury","shortHeadline":"Kevin O'Connell provides update on Justin Jefferson's ankle injury","caption":"Kevin O'Connell provides update on Justin Jefferson's ankle injury","title":"Kevin O'Connell provides update on Justin Jefferson's ankle injury","description":"Kevin O'Connell provides update on Justin Jefferson's ankle injury","shortDescription":"Kevin O'Connell provides update on Justin Jefferson's ankle injury","lastModified":"2026-09-28T00:56:46Z","originalPublishDate":"2026-09-28T00:49:33Z","premium":false,"syndicatable":true,"duration":24,"videoRatio":"16:9","timeRestrictions":{"embargoDate":"2026-09-28T00:49:32Z","expirationDate":"2026-09-30T00:49:32Z"},"deviceRestrictions":{"devices":["settop","tablet","handset","ipad","desktop"],"type":"whitelist"},"thumbnail":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/ss_20260927_204935897_3678097/ss_20260927_204935897_3678097.jpg","images":[{"name":"Poster Image","caption":"","alt":"","credit":"","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/ss_20260927_204935897_3678097/ss_20260927_204935897_3678097.jpg"}],"posterImages":{"default":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/ss_20260927_204935897_3678097/ss_20260927_204935897_3678097_default.jpg","width":576,"height":324},"firstFrame":{"href":"https://cmp-espn.media.dssott.com/opp/img/espn/2026/0927/ss_20260927_204935897_3678097/ss_20260927_204935897_3678097/thumb-1-w720-h406-f4.jpg"},"full":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/ss_20260927_204935897_3678097/ss_20260927_204935897_3678097.jpg"},"square":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/ss_20260927_204935897_3678097/ss_20260927_204935897_3678097_1x1.jpg"},"wide":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/ss_20260927_204935897_3678097/ss_20260927_204935897_3678097_5x2.jpg"}},"links":{"api":{"artwork":{"href":"https://artwork.api.espn.com/artwork/collections/media/dae70171-cd9b-48cb-b4e2-4a1bd7cc3327"},"self":{"href":"https://content.core.api.espn.com/v1/video/clips/50048576"}},"mobile":{"href":"https://watch.auth.api.espn.com/video/auth/brightcove/dae70171-cd9b-48cb-b4e2-4a1bd7cc3327/asset?UMADPARAMreferer=https://www.espn.com/video/clip/_/id/50048576/kevin-oconnell-provides-update-ju