/dm_260209_nfl_disney_superbowlpromo/dm_260209_nfl_disney_superbowlpromo.mp4"}},"sportscenter":{"href":"sportscenter://x-callback-url/showVideo?videoID=47876309&videoDSI=b20d9bce65c25"},"web":{"href":"https://www.espn.com/video/clip/_/id/47876309/next-year-disney-going-super-bowl","self":{"href":"https://www.espn.com/video/clip/_/id/47876309/next-year-disney-going-super-bowl","dsi":{"href":"https://www.espn.com/video/clip?id=b20d9bce65c25"}}}},"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":664676,"type":"editorialindicator","guid":"4d71b783-6916-3446-9c19-fab94dc60c1e","description":"Big Boost"},{"id":112926,"type":"topic","guid":"f123f941-21b0-b3d9-7a2b-25c6029f605b","description":"super bowl","sportId":0,"topicId":4}],"ad":{"bundle":"no_ad","sport":"nfl"},"tracking":{"coverageType":"Analysis","leagueName":"NFL","sportName":"football","trackingId":"dm_260209_nfl_disney_superbowlpromo","trackingName":"COM_NFL Promo (Next year, Disney's going to the Super Bowl!) 2026/2/9"}}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":409222,"type":"topic","guid":"b66e959d-b64e-9bd6-7d5c-1bcb0d53c0cb","description":"daily","sportId":0,"topicId":779},{"id":156754,"type":"topic","guid":"79ace1b6-bda3-b907-2c4c-36f408c6a575","description":"news - analytics","sportId":0,"topicId":499},{"id":112926,"type":"topic","guid":"f123f941-21b0-b3d9-7a2b-25c6029f605b","description":"super bowl","sportId":0,"topicId":4},{"id":701887,"type":"contributor","guid":"3139123a-2bc7-3127-b40d-448cdb859378","description":"ESPN Staff Profile","slug":"espn-staff-profile","contributor":{"id":2462,"description":"ESPN Staff Profile"}}],"keywords":["NFL","daily","news - analytics","super bowl","ESPN Staff Profile"],"story":"<p><video1></p>\n<p>The <a href=\"https://www.espn.com/nfl/schedule\">2026 NFL season</a> is underway, and while it's still very early, we're already starting to track the <a href=\"https://www.espn.com/nfl/standings\">playoff picture</a> and the road to <a href=\"https://www.espn.com/nfl/super-bowl/\">Super Bowl LXI</a>. Which teams have the best chances to make the 14-team postseason field? Which have a lot of work to do to ultimately get in?</p>\n<p>We used ESPN's <a href=\"https://www.espn.com/nfl/fpi\">Football Power Index</a> to project the rest of the season, looking at the playoff picture for both conferences. We included updated odds for every team to <a href=\"https://www.espn.com/nfl/standings/_/view/playoff\">make the postseason</a>, clinch its division and even make the Super Bowl in February. Plus, we also have the FPI's projections for every game on the upcoming slate and how a win -- or a loss -- might impact each team's playoff chances, independent of other results.</p>\n<p>Here's everything you need to know about the playoff picture right now, including which teams are trending up and down in each conference.</p>\n<p><a name=\"afcpic\"></a></p>\n<center>\n<p align=\"center\"><strong>Jump to:</strong><br>\n<a href=\"https://www.espn.com/nfl/story/_/id/49745176/2026-nfl-playoff-predictions-afc-nfc-odds-super-bowl#afcpic\">AFC picture</a> | <a href=\"https://www.espn.com/nfl/story/_/id/49745176/2026-nfl-playoff-predictions-afc-nfc-odds-super-bowl#nfcpic\">NFC picture</a><br>\n<a href=\"https://www.espn.com/nfl/story/_/id/49745176/2026-nfl-playoff-predictions-afc-nfc-odds-super-bowl#games\">Game stakes</a></p>\n</center>\n<p><img src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></p>\n<p><inline1></p>\n<p><a name=\"nfcpic\"></a></p>\n<hr>\n<p><inline2></p>\n<p><a name=\"games\"></a></p>\n<hr>\n<p><inline3></p>\n<hr>\n<h2>NFL playoff schedule</h2>\n<p><strong>Jan. 16-18, 2027:</strong> <a href=\"https://www.espn.com/nfl/schedule/_/week/1/year/2026/seasontype/3\">Wild-card round</a><br>\n<strong>Jan. 23-24:</strong> <a href=\"https://www.espn.com/nfl/schedule/_/week/2/year/2026/seasontype/3\">Divisional round</a><br>\n<strong>Jan. 31:</strong> <a href=\"https://www.espn.com/nfl/schedule/_/week/3/year/2026/seasontype/3\">AFC and NFC championship games</a><br>\n<strong>Feb. 14:</strong> <a href=\"https://www.espn.com/nfl/game/_/gameId/401873270\">Super Bowl LXI (in Los Angeles)</a></p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"ESPN staff","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/49745176"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=49745176"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=49745176"},"web":{"href":"https://www.espn.com/nfl/story/_/id/49745176/2026-nfl-playoff-predictions-afc-nfc-odds-super-bowl"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:22Z","status":"success"}