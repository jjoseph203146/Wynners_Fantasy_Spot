4f3","description":"nfl game footage","sportId":0,"topicId":615},{"type":"event","uid":"s:20~l:28~e:401872957","guid":"ee8e9c7d-d10c-37bb-99c5-6d6d384dea3e","description":"New England Patriots @ Jacksonville Jaguars","eventId":401872957,"event":{"id":401872957,"sport":"football","league":"nfl","description":"New England Patriots @ Jacksonville Jaguars","links":{"mobile":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872957"}},"web":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872957"}}}}}],"ad":{"bundle":"nfl_one_plays","sport":"nfl"},"contributingPartner":"wsc","contributingSystem":"wsc","tracking":{"coverageType":"OnePlay","leagueName":"NFL","program":"CBS","sportName":"football","trackingId":"dm_NFL_trevor_lawrence_kneels_down_instead_of_scoring_a_td_with_8_minutes_left_in_the_game_","trackingName":"NFL_One-Play (Trevor Lawrence kneels down instead of scoring a TD with 8 minutes left in the game) 2026/09/27 ESHEET"}}],"related":[{"id":50046373,"dataSourceIdentifier":"938f51c7d4291","publishedkey":"50046373","type":"Story","headline":"Ravens' jab at Cowboys after win in Rio leads Week 3 trolls","title":"Ravens' jab at Cowboys after win in Rio leads Week 3 trolls","linkText":"'Rio's team now': Ravens poke fun at Cowboys after win in Rio, topping Week 3 trolls","images":[{"dataSourceIdentifier":"bdb74665229b1","id":50048246,"type":"header","name":"ravens celebrate [608x342]","credit":"(Photo by Wagner Meier/Getty Images)","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0928/r1722760_608x342_16-9.jpg"}],"byline":"Anthony Gharib","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50046373"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50046373"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50046373"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50046373/nfl-week-3-trolls-2026"}},"premium":false},{"id":50023585,"dataSourceIdentifier":"b70093798ce27","publishedkey":"50023585","type":"Story","headline":"NFL Week 3's best arrivals, led by Davante Adams","title":"NFL Week 3's best arrivals, led by Davante Adams","linkText":"Davante Adams before 'SNF' leads NFL Week 3's most fashionable arrivals","images":[{"dataSourceIdentifier":"22f94f63a6c4b","id":50047534,"type":"header","name":"davante adams snf [608x342]","credit":"Brevin Townsell / Los Angeles Rams","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0927/r1722720_608x342_16-9.jpg"}],"byline":"Cameron Wolfe","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50023585"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50023585"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50023585"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50023585/nfl-week-3-fashionable-arrivals"}},"premium":false}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":2996,"type":"team","uid":"s:20~l:28~t:30","guid":"ca6fb778-cbf6-d9a3-3e93-01230335fcab","description":"Jacksonville Jaguars","sportId":28,"teamId":30,"team":{"id":30,"description":"Jacksonville Jaguars","abbreviation":"JAX","shortDisplayName":"Jaguars","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/jax/jacksonville-jaguars"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/jax/jacksonville-jaguars"}}}}},{"id":470112,"type":"athlete","uid":"s:20~l:28~a:4360310","guid":"76111495-d1d9-2333-170d-4206eebe673f","description":"Trevor Lawrence","sportId":28,"athleteId":4360310,"athlete":{"id":4360310,"description":"Trevor Lawrence","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4360310/trevor-lawrence"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4360310/trevor-lawrence"}}}}},{"id":499240,"type":"athlete","uid":"s:20~l:28~a:4882093","guid":"7c6344a7-ae7c-372e-8337-ed04ccb56cc0","description":"Bhayshul Tuten","sportId":28,"athleteId":4882093,"athlete":{"id":4882093,"description":"Bhayshul Tuten","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4882093/bhayshul-tuten"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4882093/bhayshul-tuten"}}}}},{"id":696428,"type":"contributor","guid":"78ca7d48-dcc9-3573-978f-14d30db9cc4f","description":"Michael Dirocco","slug":"michael-dirocco","contributor":{"id":2145,"description":"Michael Dirocco"}}],"keywords":["NFL","Jacksonville Jaguars","Trevor Lawrence","Bhayshul Tuten","Michael Dirocco"],"story":"<p><video1></p>\n<p>JACKSONVILLE, Fla. -- <a data-player-guid=\"76111495-d1d9-2333-170d-4206eebe673f\" href=\"https://www.espn.com/nfl/player/_/id/4360310/trevor-lawrence\">Trevor Lawrence</a> lost track of time, and as a result, some fantasy football managers lost six points.</p>\n<p><alsosee></p>\n<p>Lawrence took a knee at the 1-yard line on a scramble with nearly nine minutes remaining in the <a data-clubhouse-guid=\"ca6fb778-cbf6-d9a3-3e93-01230335fcab\" href=\"https://www.espn.com/nfl/team/_/name/jax/jacksonville-jaguars\">Jacksonville Jaguars</a>' 35-6 victory over the <a data-clubhouse-guid=\"0078f353-fe3e-67ed-a42c-43cca0568e21\" href=\"https://www.espn.com/nfl/team/_/name/ne/new-england-patriots\">New England Patriots</a> on Sunday afternoon. The Jaguars were leading 28-6 at the time, so his decision was confusing because they didn't need to run more time off the clock to ensure their victory.</p>\n<p>And then running back <a data-player-guid=\"7c6344a7-ae7c-372e-8337-ed04ccb56cc0\" href=\"https://www.espn.com/nfl/player/_/id/4882093/bhayshul-tuten\">Bhayshul Tuten</a> scored on the next play, which meant Tuten's fantasy owners ended up with six points instead.</p>\n<p>Lawrence good-naturedly owned up to his goof after the game.</p>\n<p><inline1></p>\n<p>\"When I broke free and no one tackled me, it's something we talk about all the time potentially in those situations, going down, keeping the clock running,\" Lawrence said. \"That was too much time. I looked at the clock after and I was like ugh, there's still eight minutes left. Probably unnecessary there, but just trying to eat as much clock is possible, trying to give them as few chances as possible to get back in the game.</p>\n<p>\"If you do the analytics, people will probably be all over it online, I'm sure. Probably wasn't the best decision, but we scored the next play. Give Bhayshul a touchdown. That's cool. Let him get in the end zone.\"</p>\n<p>That was the only thing coach Liam Coen could think was running through his quarterback's mind.</p>\n<p>\"I think he wanted to give a touchdown to somebody else,\" Coen joked after the game.</p>\n<p>Lawrence said he doesn't remember Coen saying anything to him after the play or on the sideline after Tuten's touchdown run. But his teammates certainly were talking.</p>\n<p>\"Everybody's just kind of making fun of me,\" he said. \"So yeah, maybe overthought that one just a little bit.\"</p>\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Michael Dirocco","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50046652"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50046652"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50046652"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50046652/jaguars-trevor-lawrence-kneel-eight-minutes-fantasy-implications"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:23Z","status":"success"}