"Brooke Sutton/Getty Images","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0928/r1722776_608x342_16-9.jpg"}],"byline":"NFL Nation","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50043408"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50043408"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50043408"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50043408/week-3-sunday-games-takeaways-questions-2026"}},"premium":false},{"id":50034932,"dataSourceIdentifier":"b322fabd720bf","publishedkey":"50034932","type":"Story","headline":"Week 3 NFL highlights: Best plays, moments, touchdowns, more","title":"Week 3 NFL highlights: Best plays, moments, touchdowns, more","linkText":"Week 3 NFL highlights: Broncos rally late in win; Ravens walk it off in Rio","source":"ESPN","images":[{"dataSourceIdentifier":"6c6fad4dd4db8","id":50049651,"type":"header","name":"Talanoa Hufanga [608x342]","credit":"Brooke Sutton/Getty Images","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0928/r1722834_608x342_16-9.jpg"}],"byline":"NFL Nation","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50034932"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50034932"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50034932"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50034932/best-plays-moments-touchdowns-more"}},"premium":false}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":409222,"type":"topic","guid":"b66e959d-b64e-9bd6-7d5c-1bcb0d53c0cb","description":"daily","sportId":0,"topicId":779},{"id":3053,"type":"team","uid":"s:20~l:28~t:34","guid":"595690b3-2161-4913-a7a7-814af2fd2621","description":"Houston Texans","sportId":28,"teamId":34,"team":{"id":34,"description":"Houston Texans","abbreviation":"HOU","shortDisplayName":"Texans","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/hou/houston-texans"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/hou/houston-texans"}}}}},{"id":2942,"type":"team","uid":"s:20~l:28~t:11","guid":"582d14eb-da61-e505-cc40-d972a1b60ed1","description":"Indianapolis Colts","sportId":28,"teamId":11,"team":{"id":11,"description":"Indianapolis Colts","abbreviation":"IND","shortDisplayName":"Colts","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ind/indianapolis-colts"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ind/indianapolis-colts"}}}}},{"id":2776,"type":"team","uid":"s:20~l:28~t:23","guid":"debcd592-8d53-71f1-fc15-5c8b8ef9df6e","description":"Pittsburgh Steelers","sportId":28,"teamId":23,"team":{"id":23,"description":"Pittsburgh Steelers","abbreviation":"PIT","shortDisplayName":"Steelers","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/pit/pittsburgh-steelers"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/pit/pittsburgh-steelers"}}}}},{"id":2610,"type":"team","uid":"s:20~l:28~t:24","guid":"84caf62b-c753-71ea-a787-44fd224a4294","description":"Los Angeles Chargers","sportId":28,"teamId":24,"team":{"id":24,"description":"Los Angeles Chargers","abbreviation":"LAC","shortDisplayName":"Chargers","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/lac/los-angeles-chargers"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/lac/los-angeles-chargers"}}}}},{"id":1462,"type":"team","uid":"s:20~l:28~t:28","guid":"fbeaf73e-6d6c-cca4-0809-713d9d741f90","description":"Washington Commanders","sportId":28,"teamId":28,"team":{"id":28,"description":"Washington Commanders","abbreviation":"WSH","shortDisplayName":"Commanders","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/wsh/washington-commanders"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/wsh/washington-commanders"}}}}},{"id":2035,"type":"team","uid":"s:20~l:28~t:18","guid":"97d2f6c9-2f22-459c-306a-046941ccab2a","description":"New Orleans Saints","sportId":28,"teamId":18,"team":{"id":18,"description":"New Orleans Saints","abbreviation":"NO","shortDisplayName":"Saints","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/no/new-orleans-saints"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/no/new-orleans-saints"}}}}},{"id":2553,"type":"team","uid":"s:20~l:28~t:13","guid":"b18540eb-6f2b-534c-e7f9-9bd930518da9","description":"Las Vegas Raiders","sportId":28,"teamId":13,"team":{"id":13,"description":"Las Vegas Raiders","abbreviation":"LV","shortDisplayName":"Raiders","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/lv/las-vegas-raiders"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/lv/las-vegas-raiders"}}}}}],"keywords":["NFL","daily","Houston Texans","Indianapolis Colts","Pittsburgh Steelers","Los Angeles Chargers","Washington Commanders","New Orleans Saints","Las Vegas Raiders"],"story":"<p><video1></p>\n<p>If you had the Raiders at 3-0 and Texans at 0-3 after three weeks, good on you. The NFL is always wacky in September -- and never wackier than when <a data-player-guid=\"33be1f4a-d812-75b9-7b7c-5319d2a7113a\" href=\"https://www.espn.com/nfl/player/_/id/2576980/marcus-mariota\">Marcus Mariota</a> leads the Commanders to a <a href=\"https://www.espn.com/nfl/game/_/gameId/401872955/seahawks-commanders\">win</a> over the Super Bowl champion Seahawks.</p>\n<p>Every Sunday, I'll find several of the coolest advanced stats from the day's NFL action to share with you -- stats to explain all the action and what it means. Some call them NFL Next Gen Stats. I call them Next Ben Stats: the data that might not make it on the broadcast but will make you a smarter fan (and laugh a little bit, probably).</p>\n<p>Let's start <a href=\"https://www.espn.com/nfl/schedule\">Week 3</a>'s list with coaching mistakes that might have cost the Texans a much-needed divisional win.</p>\n<p><a name=\"hou\"></a></p>\n<center>\n<p align=\"center\"><strong>Jump to an eye-popping stat on:</strong><br>\n<a href=\"https://www.espn.com/nfl/story/_/id/50043815/week-3-five-key-stats-numbers-solak#hou\">Texans decisions</a> | <a href=\"http://www.espn.com/nfl/story/_/id/50043815/week-3-five-key-stats-numbers-solak#ind\">Jones up the middle</a><br>\n<a href=\"http://www.espn.com/nfl/story/_/id/50043815/week-3-five-key-stats-numbers-solak#pit\">Rodgers time to pass</a> | <a href=\"http://www.espn.com/nfl/story/_/id/50043815/week-3-five-key-stats-numbers-solak#wsh\">Styles impact</a><br>\n<a href=\"http://www.espn.com/nfl/story/_/id/50043815/week-3-five-key-stats-numbers-solak#lac\">Chargers takeaways</a> | <a href=\"http://www.espn.com/nfl/story/_/id/50043815/week-3-five-key-stats-numbers-solak#lvno\">Raiders-Saints TEs</a></p>\n<p align=\"center\"><img src=\"http://a.espncdn.com/i/infographics/20170710_nfl_fpr/charts/_end_rule.png\" width=\"100%\"></p>\n</center>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/hou.png&h=110&w=110\" width=\"31\"></p>\n<h2>3.6%: How much win probability the Texans lost when they kicked a field goal on fourth-and-4</h2>\n<p>That was via ESPN's model. The NFL Next Gen Stats model was <em>even worse</em> at 5.5%.</p>\n<p>The Texans are 0-3 for a lot of reasons, and clock and game management is a solid chunk of it. This particular fourth down came with Houston losing 16-7 with 7:36 remaining. The Texans knew they'd need a touchdown to get back into it but elected to instead kick the field goal from inside the 10-yard line.</p>\n<p><alsosee></p>\n<p>It looked like it worked out. Houston forced a fumble on the ensuing drive, then scored the go-ahead touchdown with <a data-player-guid=\"bd8cfa24-9145-3c9e-b8e7-60669972052c\" href=\"https://www.espn.com/nfl/player/_/id/4429059/woody-marks\">Woody Marks</a>. But with the score at 17-16, all the Colts needed to get back on top was a field goal. They ultimately got it to go ahead 19-17. But that wasn't the real concerning part -- it's how much clock Houston coach DeMeco Ryans let run on Indy's drive before using his timeouts. After a first-and-10 run of 5 yards from <a data-player-guid=\"ddd8786c-fd5a-4e55-ccc8-6ddf6f1ede33\" href=\"https://www.espn.com/nfl/player/_/id/4242335/jonathan-taylor\">Jonathan Taylor</a>, the clock rolled from 1:04 to 0:29 (and an expiring play clock) ... and <em>then</em> Ryans called the timeout. Houston <a href=\"https://www.espn.com/nfl/game/_/gameId/401872951/texans-colts\">lost 19-17</a> after getting the ball back with just 11 seconds on the clock.</p>\n<p>This isn't the first questionable fourth-down call for Ryans. He opted to kick a field goal on fourth-and-1 from the Bengals' 40 in <a href=\"https://www.espn.com/nfl/game/_/gameId/401872934/bengals-texans\">last week's loss</a>, a decision that cost him 7.4% in win probability. Against the Bengals and the Colts, an early fourth-down run was stuffed, and those failures seem to cut Ryans' confidence in fourth-down decisions at the knees. It's often the case that defensive-minded head coaches default to punts and field goals, but in the case of a struggling offense such as the Texans' unit, it's even more important to go for fourth downs when near the end zone -- you're unlikely to keep getting back there!</p>\n<p><a name=\"ind\"></a></p>\n<hr>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/ind.png&h=110&w=110\" width=\"31\"></p>\n<h2>198: How many passing yards <a data-player-guid=\"5ad1bcc2-57bc-bb72-bcd0-0cdd0d945444\" href=\"https://www.espn.com/nfl/player/_/id/3917792/daniel-jones\">Daniel Jones</a> had between the numbers</h2>\n<p>Consider that he had only 235 passing yards altogether in the win over Houston. Here are Jones' overall numbers throwing to the middle of the field: 20-for-25, 198 yards and one touchdown. Jones had a 113.0 passer rating there, and it was the eighth-most total dropback EPA (13.3) while throwing between the numbers in a game.</p>\n<p>The Texans' defense remains an overall good unit, but it has a clear weakness in the middle of the field. The injury to starting linebacker <a data-player-guid=\"bbc3c6dd-5a52-d17f-3376-278d42820bcc\" href=\"https://www.espn.com/nfl/player/_/id/4426350/henry-tootoo\">Henry To'oTo'o</a> has put backups <a data-player-guid=\"70964d1d-e2b4-fbab-45ca-93762041f7e6\" href=\"https://www.espn.com/nfl/player/_/id/4033812/jake-hansen\">Jake Hansen</a> and <a data-player-guid=\"532220d9-c618-3c66-a73c-1a93a0d85e82\" href=\"https://www.espn.com/nfl/player/_/id/4837286/wade-woodaz\">Wade Woodaz</a> on the field, and that duo was getting hammered in coverage Sunday. When <a data-player-guid=\"3ce75e87-2c6d-5a79-e349-2caa21b3cb07\" href=\"https://www.espn.com/nfl/player/_/id/3919117/azeez-al-shaair\">Azeez Al-Shaair</a> had to miss time because of a groin injury, the Texans had no intermediate-middle presence to speak of in their zone looks.</p>\n<p>Ideally, a strong box safety such as <a data-player-guid=\"d54cc2ba-73fb-a76c-b5cb-cb7c5a7c9d0d\" href=\"https://www.espn.com/nfl/player/_/id/4243956/reed-blankenship\">Reed Blankenship</a> alleviates some of these concerns -- but Blankenship has had some big misses. All too easily, opposing quarterbacks can ignore <a data-player-guid=\"20a10a50-95ee-3243-52da-67eeb2286eb2\" href=\"https://www.espn.com/nfl/player/_/id/4426434/derek-stingley-jr\">Derek Stingley Jr</a>. and <a data-player-guid=\"67e6616b-c75f-3103-8d03-dd4b24b55824\" href=\"https://www.espn.com/nfl/player/_/id/4602699/kamari-lassiter\">Kamari Lassiter</a> on the outside. Jones had such a quick release hitting interior windows in this game, and it minimized the impact of the Texans' pass rush (as much as such a pass rush can be minimized).</p>\n<p><video2></p>\n<p><a name=\"pit\"></a></p>\n<hr>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/pit.png&h=110&w=110\" width=\"31\"></p>\n<h2>3.19: How many seconds <a data-player-guid=\"5fbab03e-2816-55ab-ae10-83b132803d9e\" href=\"https://www.espn.com/nfl/player/_/id/8439/aaron-rodgers\">Aaron Rodgers</a> averaged to throw</h2>\n<p>That's his longest time to throw in a game for the Steelers. And it's an enormous, enormous leap from what he has typically done for Pittsburgh. Since the start of last season, he had averaged 2.73 seconds heading into this game, the fastest among all league passers. He was fearful of taking hits and too quick to go to his checkdown.</p>\n<p>Not on Sunday <a href=\"https://www.espn.com/nfl/game/_/gameId/401872950/bengals-steelers\">against the Bengals</a>! The Steelers looked like a balanced passing attack willing to use prolonged play-action dropbacks to push the ball downfield, and they found more success through the air than either the Texans or Buccaneers did against the Bengals as a reward for their aggression. Rodgers had five completions of at least 20 yards, tied for his most in a game for the Steelers. He had 15 attempts of at least 10 air yards -- also his most in a game for the Steelers.</p>\n<p>Pittsburgh also had a lights-out performance from its offensive line, both in pass protection and in the running game, which allowed for explosive rushes and kept Cincinnati defensive tackle <a data-player-guid=\"ac126158-4522-b807-e3bc-bc4256320611\" href=\"https://www.espn.com/nfl/player/_/id/4035483/dexter-lawrence-ii\">Dexter Lawrence II</a> from taking over the game. Right guard (<a data-player-guid=\"547214f1-6644-5f2b-938c-6f6ee89d4e3d\" href=\"https://www.espn.com/nfl/player/_/id/4241087/brock-hoffman\">Brock Hoffman</a>) and right tackle (first-round pick <a data-player-guid=\"34173f97-1414-3c47-9903-211a42f7f785\" href=\"https://www.espn.com/nfl/player/_/id/5150136/max-iheanachor\">Max Iheanachor</a>) were new starters, and the personnel shift worked. Rodgers had time to dissect a Bengals secondary that likes to conceal coverages with clever rotations -- something a savvy vet like him can do with the appropriate amount of protection and aggression.</p>\n<p><a name=\"lac\"></a></p>\n<hr>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/lac.png&h=110&w=110\" width=\"31\"></p>\n<h2>3: How many games the Chargers have lost since 2015 in which they won the turnover margin by four or more</h2>\n<p>The rest of the NFL has two <em>combined</em>. The games in question:</p>\n<ul>\n<li>The infamous <a href=\"https://www.espn.com/nfl/game/_/gameId/401437998/chargers-jaguars\">2022 playoff loss to the Jaguars</a>, in which the Chargers surrendered a 27-0 lead</li>\n<li>A <a href=\"https://www.espn.com/nfl/game/_/gameId/400791687/chargers-broncos\">2015 end-of-season catastrophe</a> for a 4-11 San Diego team against an 11-4 Denver squad</li>\n<li>The game we just watched them <a href=\"https://www.espn.com/nfl/game/_/gameId/401872953/chargers-bills\">lose to the Bills</a></li>\n</ul>\n<p><inline2></p>\n<p>As <a href=\"https://www.espn.com/nfl/story/_/id/49999213/week-3-seven-things-solak-thinks-baker-mayfield-patriots-chargers\">I wrote Tuesday</a>, the Chargers are a dysfunctional team across the board. Not even five Bills turnovers for a plus-4 overall margin could account for all of their errors. <a data-player-guid=\"ec880cbc-1490-cdae-548f-f844104974ae\" href=\"https://www.espn.com/nfl/player/_/id/4038941/justin-herbert\">Justin Herbert</a> threw a back-breaking pick against the goal line in the fourth quarter. Coach Jim Harbaugh didn't go for it on fourth downs when he should have ... then attempted a fourth-and-10 late in the fourth quarter he didn't need to try at all. The offense had five penalties in the first quarter, tying its fourth quarter in Week 1 for the most penalties by a unit in one quarter this season.</p>\n<p>Bad team. Takeaways are great, and I liked the play of the pass rush and rookie safety <a data-player-guid=\"9ca63f11-bdce-3a4d-8e30-975419f12cb3\" href=\"https://www.espn.com/nfl/player/_/id/4950551/genesis-smith\">Genesis Smith</a> to generate them. But they don't save a bad team.</p>\n<p><a name=\"wsh\"></a></p>\n<hr>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/wsh.png&h=110&w=110\" width=\"31\"></p>\n<h2>2,870: How many days it had been since a rookie LB last had an interception and a forced fumble in the same game</h2>\n<p><a data-player-guid=\"9766eec0-fd54-e6df-90c6-025eb40ff548\" href=\"https://www.espn.com/nfl/player/_/id/3056362/shaquille-leonard\">Shaquille Leonard</a> did it Nov. 18, 2018, for the Colts. And <a data-player-guid=\"34317f06-1e97-3466-9be9-3186599b2d87\" href=\"https://www.espn.com/nfl/player/_/id/5081807/sonny-styles\">Sonny Styles</a> did it Sunday for the Commanders.</p>\n<p>Want to know what a top-10 pick at off-ball linebacker looks like? Want to see what an upset of the Super Bowl champion Seahawks with a backup quarterback starting requires? The intersection of that Venn diagram is the play of Styles.</p>\n<p>He was a force in his third career game. His interception was the play of a centerfielder, tracking a tipped ball as it pop-flied through the air. His forced fumble was nearly a game-changing play -- he forced it at the 1-yard line and was unlucky to see it ricochet right back into the Seahawks' hands.</p>\n<p>It's the plays that didn't stuff the stat sheet that really impressed, though. Styles shot a gap to hit running back <a data-player-guid=\"705bfe8e-8678-32bc-a5b8-535fcca2e1cd\" href=\"https://www.espn.com/nfl/player/_/id/4685512/jadarian-price\">Jadarian Price</a> at the line of scrimmage in the first quarter, and cornerback <a data-player-guid=\"fcc68f0d-751c-c464-180b-643b74c68fa7\" href=\"https://www.espn.com/nfl/player/_/id/4239694/amik-robertson\">Amik Robertson</a> took the opportunity to punch the ball out. In the second quarter, Styles tracked Price in man coverage on a wheel route -- a nightmare role for a linebacker -- but easily kept stride and swiped his way into a <a href=\"https://x.com/NFL/status/2104280078251340124\">pass breakup</a> without turning his helmet. That's his safety background showing up.</p>\n<p><inline1></p>\n<p>The Commanders' defense didn't have a perfect day, but it made splashy plays when it mattered. Styles was a huge part of that effort. He looks like a cornerstone player in Washington.</p>\n<p><a name=\"lvno\"></a></p>\n<hr>\n<p><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/lv.png&h=110&w=110\" width=\"31\"><img alt=\"\" class=\"floatleft\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/nfl/500/no.png&h=110&w=110\" width=\"31\"></p>\n<h2>6: How many touchdowns were scored by tight ends in Raiders-Saints</h2>\n<p>That ties the record for most tight end touchdowns in a game in NFL history.</p>\n<p>There were several different ways to get at this dominant performance for tight ends, which the Raiders <a href=\"https://www.espn.com/nfl/game?gameId=401872961\">won 35-27</a>. The Saints contributed four touchdowns to the effort -- two from <a data-player-guid=\"96eb607e-4310-ea22-02d0-fbd0cd080faf\" href=\"https://www.espn.com/nfl/player/_/id/4036131/noah-fant\">Noah Fant</a>, two from <a data-player-guid=\"18c1eb5c-dfda-3e1c-ee18-2946bbbf6015\" href=\"https://www.espn.com/nfl/player/_/id/3929645/juwan-johnson\">Juwan Johnson</a>. They're only the second pair of tight end teammates since 1960 to each have multiple touchdowns in a single game.</p>\n<p>On the Raiders' side, <a data-player-guid=\"bc4ba7ee-446b-36fd-9985-7fd2a94a98bc\" href=\"https://www.espn.com/nfl/player/_/id/4432665/brock-bowers\">Brock Bowers</a> made his season debut with an absolute bang: 10 catches, 116 yards and a score. Since entering the league in 2024, Bowers has played 30 games, and he has four games of 10-plus receptions, 100-plus yards and at least one touchdown. The rest of the league's entire wealth of tight ends has only four such games in the same timespan.</p>\n<p>Aside from the obvious talent of Bowers and Johnson (an underrated star in the making), I'd consider the great day for tight end production a greater testament to the playcallers. The Raiders' Klint Kubiak and Saints' Kellen Moore have chased the 13 personnel trend while successfully iterating on it. Bowers in particular was used exactly as I hoped he might be in Kubiak's offense -- 24 of his 33 routes were in the slot or out wide, and all of his targets came from those alignments. This is a wide receiver masquerading as a tight end.</p>\n\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Ben Solak","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50043815"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50043815"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50043815"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50043815/week-3-key-stats-numbers-solak"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T13:57:20Z","status":"success"}