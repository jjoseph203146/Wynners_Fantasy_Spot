","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/hou/houston-texans"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/hou/houston-texans"}}}}},{"id":2942,"type":"team","uid":"s:20~l:28~t:11","guid":"582d14eb-da61-e505-cc40-d972a1b60ed1","description":"Indianapolis Colts","sportId":28,"teamId":11,"team":{"id":11,"description":"Indianapolis Colts","abbreviation":"IND","shortDisplayName":"Colts","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ind/indianapolis-colts"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ind/indianapolis-colts"}}}}},{"type":"event","uid":"s:20~l:28~e:401872951","guid":"70a66ab3-6711-3972-8ef5-4545777ef5d8","description":"Houston Texans @ Indianapolis Colts","eventId":401872951,"event":{"id":401872951,"sport":"football","league":"nfl","description":"Houston Texans @ Indianapolis Colts","links":{"mobile":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872951"}},"web":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872951"}}}}}],"ad":{"bundle":"nfl_one_plays","sport":"nfl"},"contributingPartner":"wsc","contributingSystem":"wsc","tracking":{"coverageType":"OnePlay","leagueName":"NFL","program":"espnnfl","sportName":"football","trackingId":"dm_20260927_NFL_live_on_cbs_keenan_allen_puts_colts_on_the_board_with_td_catch_","trackingName":"NFL_One-Play (Keenan Allen scores his first TD as a Colt ) 2026/09/27 ESHEET"}}],"related":[{"id":50043253,"dataSourceIdentifier":"0d3ca4cf6d5c7","publishedkey":"50043253","type":"Story","headline":"Big Week 3 losses: Seahawks, Pats, Texans, Chargers, Panthers","title":"Big Week 3 losses: Seahawks, Pats, Texans, Chargers, Panthers","linkText":"Trouble brewing for the Patriots? Barnwell on five important Week 3 losses and their aftermath","images":[{"dataSourceIdentifier":"75452d1372c67","id":50048781,"type":"header","name":"Drake Maye [1296x729]","credit":"Logan Bowles/Getty Images","height":729,"width":1296,"url":