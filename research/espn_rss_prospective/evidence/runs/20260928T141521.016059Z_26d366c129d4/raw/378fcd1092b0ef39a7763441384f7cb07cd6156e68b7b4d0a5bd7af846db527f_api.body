{"resultsCount":1,"resultsLimit":10,"resultsOffset":0,"headlines":[{"id":50049468,"nowId":"1-50049468","contentKey":"50049468-1-6-1","dataSourceIdentifier":"d85be1fec6b60","publishedkey":"50049468","type":"Story","feedDisplayType":"Default","headline":"Chiefs' Mahomes perfect on play-action passes in win vs. Dolphins","description":"Mahomes completed all 14 of his play-action attempts for 201 yards, including a touchdown, according to ESPN Research.","title":"Chiefs' Mahomes perfect on play-action passes in win vs. Dolphins","linkText":"Mahomes perfect on play-action passes in win vs. Dolphins: 'It's opening up a lot'","categorized":"2026-09-28T10:00:13Z","originallyPosted":"2026-09-28T10:00:00Z","lastModified":"2026-09-28T10:00:11Z","published":"2026-09-28T10:00:11Z","root":"nfl","section":"NFL","images":[{"dataSourceIdentifier":"7d83b45c54fdb","id":50049720,"type":"header","name":"Mahomes Play-action [608x342]","caption":"Mahomes was a perfect 14-for-14 for 201 yards and a touchdown on play-action passes against the Dolphins.","alt":"Mahomes Play-action","credit":"Carmen Mandato/Getty Images","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0928/r1722835_608x342_16-9.jpg"},{"type":"Media","name":"Takeaways from the Chiefs win over the Dolphins","caption":"Nate Taylor breaks down the Chiefs' 24-10 win over the Dolphins.","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/0927/dm_260927_Chiefs_beat_Dolphins_IA/dm_260927_Chiefs_beat_Dolphins_IA.jpg"}],"video":[{"id":50049579,"dataSourceIdentifier":"e668e80bcf578","cerebroId":"6ab9d9a375ba89659fc677c2","pccId":"c0de0eee-2205-40de-ab36-6f4385e4659c","source":"espn","headline":"Takeaways from the Chiefs win over the Dolphins","shortHeadline":"Takeaways from the Chiefs win over the Dolphins","caption":"Nate Taylor breaks down the Chiefs' 24-10 win over the Dolphins.","title":"Takeaways from the Chiefs win over the Dolphins","description":"Nate Taylor breaks down the