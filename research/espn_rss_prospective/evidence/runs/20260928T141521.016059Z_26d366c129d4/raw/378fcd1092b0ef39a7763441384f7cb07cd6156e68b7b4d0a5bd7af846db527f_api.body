7/dm_260927_Chiefs_beat_Dolphins_IA/dm_260927_Chiefs_beat_Dolphins_IA/playlist.m3u8","9x16":{"href":"https://cmp-espn.media.dssott.com/opp/cmaf/espn/9x16/2026/0927/dm_260927_Chiefs_beat_Dolphins_IA/dm_260927_Chiefs_beat_Dolphins_IA/playlist.m3u8"},"cmb":{"href":"https://cmp-espn.media.dssott.com/opp/cmaf/espn/cmb/2026/0927/dm_260927_Chiefs_beat_Dolphins_IA/dm_260927_Chiefs_beat_Dolphins_IA/playlist.m3u8"}},"cmb":{"href":"https://cmp-espn.media.dssott.com/opp/hls/espn/cmb/2026/0927/dm_260927_Chiefs_beat_Dolphins_IA/dm_260927_Chiefs_beat_Dolphins_IA/playlist.m3u8"},"shield":{"href":"https://watch.auth.api.espn.com/video/auth/media/c0de0eee-2205-40de-ab36-6f4385e4659c/asset"}},"flash":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/2026/0927/dm_260927_Chiefs_beat_Dolphins_IA/dm_260927_Chiefs_beat_Dolphins_IA.mp4"},"full":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/2026/0927/dm_260927_Chiefs_beat_Dolphins_IA/dm_260927_Chiefs_beat_Dolphins_IA.mp4"},"mezzanine":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/2026/0927/dm_260927_Chiefs_beat_Dolphins_IA/dm_260927_Chiefs_beat_Dolphins_IA.mp4"}},"sportscenter":{"href":"sportscenter://x-callback-url/showVideo?videoID=50049579&videoDSI=e668e80bcf578"},"web":{"href":"https://www.espn.com/video/clip/_/id/50049579/takeaways-chiefs-win-dolphins","self":{"href":"https://www.espn.com/video/clip/_/id/50049579/takeaways-chiefs-win-dolphins","dsi":{"href":"https://www.espn.com/video/clip?id=e668e80bcf578"}}}},"categories":[{"id":2496,"type":"team","uid":"s:20~l:28~t:12","guid":"f68f2343-8ceb-7a02-740d-af6338be21d2","description":"Kansas City Chiefs","sportId":28,"teamId":12,"team":{"id":12,"description":"Kansas City Chiefs","abbreviation":"KC","shortDisplayName":"Chiefs","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/kc/kansas-city-chiefs"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/kc/kansas-city-chiefs"}}}}},{"id":711824,"type":"editorialindicator","guid":"d348c764-47d9-3e31-bd75-d39dfde52c26","description":"SC4U  - Eligible"},{"id":718171,"type":"editorialindicator","guid":"2a4cc294-9e85-38be-b7ed-12d8b3f3c646","description":"SC4U - InstantAnalysis"},{"type":"event","uid":"s:20~l:28~e:401872952","guid":"681fc290-01a2-3367-baeb-6383d8b21e8e","description":"Kansas City Chiefs @ Miami Dolphins","eventId":401872952,"event":{"id":401872952,"sport":"football","league":"nfl","description":"Kansas City Chiefs @ Miami Dolphins","links":{"mobile":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872952"}},"web":{"event":{"href":"https://www.espn.com/nfl/game/_/gameId/401872952"}}}}}],"ad":{"bundle":"sportscenter","sport":"nfl"},"tracking":{"coverageType":"InstantAnalysis","leagueName":"No League","program":"NFL","sportName":"nfl","trackingId":"dm_260927_Chiefs_beat_Dolphins_IA","trackingName":"SC4U_NFL InstantAnalysis (Takeaways from the Chiefs win over the Dolphins) 2026/9/27"}}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":2496,"type":"team","uid":"s:20~l:28~t:12","guid":"f68f2343-8ceb-7a02-740d-af6338be21d2","description":"Kansas City Chiefs","sportId":28,"teamId":12,"team":{"id":12,"description":"Kansas City Chiefs","abbreviation":"KC","shortDisplayName":"Chiefs","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/kc/kansas-city-chiefs"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/kc/kansas-city-chiefs"}}}}},{"id":166867,"type":"athlete","uid":"s:20~l:28~a:3139477","guid":"37d87523-280a-9d4a-0adb-22cfc6d3619c","description":"Patrick Mahomes","sportId":28,"athleteId":3139477,"athlete":{"id":3139477,"description":"Patrick Mahomes","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3139477/patrick-mahomes"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3139477/patrick-mahomes"}}}}},{"id":529577,"type":"athlete","uid":"s:20~l:28~a:4567048","guid":"c0a76b7f-7b5d-be73-5e81-258439651478","description":"Kenneth Walker III","sportId":28,"athleteId":4567048,"athlete":{"id":4567048,"description":"Kenneth Walker III","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4567048/kenneth-walker-iii"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4567048/kenneth-walker-iii"}}}}},{"id":115523,"type":"athlete","uid":"s:20~l:28~a:15847","guid":"8af09abf-ebb7-2b77-eda0-f0dfead48cd6","description":"Travis Kelce","sportId":28,"athleteId":15847,"athlete":{"id":15847,"description":"Travis Kelce","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/15847/travis-kelce"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/15847/travis-kelce"}}}}},{"id":529522,"type":"athlete","uid":"s:20~l:28~a:4362921","guid":"af291c50-3539-f238-a395-bae40254eb41","description":"Tyquan Thornton","sportId":28,"athleteId":4362921,"athlete":{"id":4362921,"description":"Tyquan Thornton","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4362921/tyquan-thornton"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4362921/tyquan-thornton"}}}}},{"id":717358,"type":"contributor","guid":"acbff530-00a1-352d-90d7-82657926ba36","description":"Nate Taylor","slug":"nate-taylor","contributor":{"id":4230,"description":"Nate Taylor"}}],"keywords":["NFL","Kansas City Chiefs","Patrick Mahomes","Kenneth Walker III","Travis Kelce","Tyquan Thornton","Nate Taylor"],"story":"\n<p>MIAMI GARDENS, Fla. -- <a data-player-guid=\"37d87523-280a-9d4a-0adb-22cfc6d3619c\" href=\"https://www.espn.com/nfl/player/_/id/3139477/patrick-mahomes\">Patrick Mahomes</a>' opening snap in Sunday's game against the <a data-clubhouse-guid=\"af33088b-1e19-d27d-dbc0-354fd7151703\" href=\"https://www.espn.com/nfl/team/_/name/mia/miami-dolphins\">Miami Dolphins</a> was perhaps his easiest pass of the season.</p>\n<p>Mahomes, the <a data-clubhouse-guid=\"f68f2343-8ceb-7a02-740d-af6338be21d2\" href=\"https://www.espn.com/nfl/team/_/name/kc/kansas-city-chiefs\">Kansas City Chiefs</a>' quarterback, took the snap under center and executed a play-action fake with running back <a data-player-guid=\"c0a76b7f-7b5d-be73-5e81-258439651478\" href=\"https://www.espn.com/nfl/player/_/id/4567048/kenneth-walker\">Kenneth Walker III</a>. When Mahomes released the ball, not a single defender was close to tight end <a data-player-guid=\"8af09abf-ebb7-2b77-eda0-f0dfead48cd6\" href=\"https://www.espn.com/nfl/player/_/id/15847/travis-kelce\">Travis Kelce</a>, who turned his wide-open catch into a 48-yard gain.</p>\n<p>For the remainder of the game, <a href=\"https://www.espn.com/nfl/game/_/gameId/401872952/chiefs-dolphins\" target=\"_blank\">a 24-10 win for the Chiefs</a>, Mahomes found teammate after teammate open for completion after completion on play-action passes. In total, Mahomes completed all 14 of his play-action attempts for 201 yards, including a touchdown, according to ESPN Research. He also tied <a data-player-guid=\"f0610946-ceb6-9a99-3bcc-cf110b2078b5\" href=\"https://www.espn.com/nfl/player/_/id/14881/russell-wilson\">Russell Wilson</a> (in 2020) for the most completions without an incompletion on play-action in the past 20 seasons.</p>\n<p><inline1></p>\n<p>\"It's helping out a ton,\" Mahomes said of the Chiefs' play-action attack. \"I think people look at the stats and they see the touchdowns that Kenneth has and [rookie running back Emmett Johnson] when they're running the ball. But I don't think they really understand how the play-action and the movements [within the pocket] is really opened up in our offense. That's a credit to [the running backs] and the offensive line firing off the ball, run and pass.</p>\n<p>\"I thought we did a great job with that.\"</p>\n<p>Last season, the Chiefs, who finished with a disappointing 6-11 record and missed the playoffs for the first time since 2014, were one of the NFL's worst when using play-action. In 178 play-action snaps, the seventh most in the league, the Chiefs recorded just 977 passing yards from, ranking 20th, according to ESPN Research. The Chiefs even surrendered more sacks (nine) than they scored touchdowns (three).</p>\n<p>Coach Andy Reid hired Eric Bieniemy in late January to be the new offensive coordinator -- a role he held with the team from 2018 to 2022. In March, during the NFL's free agency period, general manager Brett Veach made the Chiefs' biggest offseason acquisition in signing Walker to a three-year, $43.05 million contract, including $28.7 million fully guaranteed.</p>\n<p>After Sunday's game, Mahomes has 329 passing yards, four touchdowns and one interception on play-action attempts. He also hasn't been sacked in 38 such snaps, according to TruMedia.</p>\n<p><inline2></p>\n<p>Throughout the Chiefs' locker room Sunday, several offensive players praised Walker and Bieniemy for creating advantageous opportunities for larger passing gains.</p>\n<p>\"It's opening up a lot, just knowing our run game has a huge impact,\" receiver <a data-player-guid=\"48cfbe28-2b59-e0df-3ce3-2e981cd56c7e\" href=\"https://www.espn.com/nfl/player/_/id/4428331/rashee-rice\">Rashee Rice</a> said. \"When it's time for [pass catchers] to be called to make the play downfield when it looks like a run, we have to make that play.\"</p>\n<p>The opening snap was a perfect example. The Chiefs lined up with three tight ends and just two players -- Kelce and receiver <a data-player-guid=\"af291c50-3539-f238-a395-bae40254eb41\" href=\"https://www.espn.com/nfl/player/_/id/4362921/tyquan-thornton\">Tyquan Thornton</a> -- went out for a route. Once Mahomes executed his play-action fake with Walker, 10 of the 11 defenders for the Dolphins were behind Kelce, who ran a 15-yard corner route.</p>\n<p>\"I think the fact I scrambled out to the right kind of got him open, which it wasn't necessarily supposed to happen like that,\" Mahomes said of his highlight with Kelce. \"How the defensive line stunted, I was able to get outside. What got him opened the most was Tyquan running down the field. You have that speed running at you down the field, the safety got depth and the play action got the second-level [defenders] up and all of a sudden Travis is right there behind everybody.\"</p>\n<p>Every prominent skill player for the Chiefs had at least one memorable moment Sunday that was a byproduct of play-action.</p>\n<p>Inside the red zone, the Chiefs used one of their most effective plays in that area of the field, one that was prominent during Bieniemy's first stint with the team. Mahomes used play-action from under center and then completed a short shovel pass to Walker, who ran into the end zone with ease following the pulling block from left guard <a data-player-guid=\"1c717a74-caaa-3b9a-a52f-f7820326b17a\" href=\"https://www.espn.com/nfl/player/_/id/4431595/kingsley-suamataia\">Kingsley Suamataia</a>.</p>\n<p><inline3></p>\n<p>Walker has scored four touchdowns and provided plenty of speed, elusiveness and dynamic ability after contact. In fact, Walker is the first player in the Chiefs' history to have two games with a rushing and receiving touchdown within his team's first three games of a season. His 442 scrimmage yards are also the second most in a Chiefs player's first three games.</p>\n<p>\"The running game is getting the offensive line comfortable with getting downhill and really moving the line of scrimmage,\" Kelce said. \"On top of that, just being in sync with [No.] 15 back there. I think [it's] Bieniemy, coming from Chicago [as the Bears' running backs coach] with even more of a downhill run game than what we've had in years past. Obviously, Kenneth Walker and EJ coming in and getting those yards early helps it out a lot.\"</p>\n<p>Late in the first quarter, the Chiefs used Walker as a decoy on a third-and-1 snap for Mahomes to find Thorton for a comfortable 17-yard pass.</p>\n<p>Mahomes' most impressive play-action completion was early in the fourth quarter, when he rolled to his right before throwing a perfect intermediate pass to tight end <a data-player-guid=\"afb8890f-26ff-5e4e-3daf-0d45063e1b4f\" href=\"https://www.espn.com/nfl/player/_/id/4240472/noah-gray\">Noah Gray</a>, who made the catch over linebacker <a data-player-guid=\"a0b2908f-24fd-2f7c-048f-96964fc8ae7e\" href=\"https://www.espn.com/nfl/player/_/id/4259804/willie-gay-jr\">Willie Gay Jr</a>.</p>\n<p>\"They played a lot of zone coverage, so I found a soft spot and Pat delivered a good ball,\" Thornton said of his highlight. \"I just had to come down with it. [Against] zone, route depth and being on time is very important. I feel me and Pat have a good sense of timing and where he needs me to be.\"</p>\n<p><inline4></p>\n<p>Before the season began, Reid and Mahomes knew and acknowledged that the Chiefs needed to improve their play-action passing attack for them to once again become one of the NFL's most potent offenses.</p>\n<p>Through three weeks, the Chiefs have made such strides. The Chiefs rank first in play-action usage (36%) after ranking 13th (25%) last season, according to ESPN Research.</p>\n<p>Last season, Mahomes had just 29 play-action attempts through three games. But this season, Mahomes has already recorded 30 play-action completions, the most in the league.</p>\n<p>\"We're running the ball so well that defenses have to change how they play against us,\" Mahomes said. \"We have to continue to do that, continue to run the ball and play-action off of that and keep defenses honest.\"</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Nate Taylor","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50049468"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50049468"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50049468"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50049468/chiefs-patrick-mahomes-play-action-passes-dolphins-travis-kelce-kenneth-walker-iii"}},"premium":false}],"breakingNews":[],"timestamp":"2026-09-28T14:15:21Z","status":"success"}